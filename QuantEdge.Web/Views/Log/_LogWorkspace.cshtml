@* Shared markup for the Web Log and API Log pages. Element IDs are read by logmanager.js / apilogmanager.js. *@
@{
    string label = ViewData["LogLabel"]?.ToString() ?? "Web";
}

<div class="log-manager-container" data-api-base-url="@ViewBag.ApiBaseUrl">
    <div class="log-workspace">
        <!-- Left: log file explorer -->
        <aside class="log-file-sidebar">
            <div class="sidebar-panel-header">
                <div class="panel-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    <span>@label Log Files</span>
                </div>
                <button type="button" id="btnRefreshFiles" class="btn-icon-sm" data-tooltip="Reload the file list for the selected dates.">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                </button>
            </div>

            <div class="date-picker-card">
                <div class="date-picker-row">
                    <div class="date-field">
                        <label class="date-picker-label" for="logStartDateInput">Start Date</label>
                        <input type="date" id="logStartDateInput" class="date-picker-input" />
                    </div>
                    <div class="date-field">
                        <label class="date-picker-label" for="logEndDateInput">End Date</label>
                        <input type="date" id="logEndDateInput" class="date-picker-input" />
                    </div>
                </div>
                <button type="button" id="btnFetchDateLogs" class="btn-fetch-date-range">Fetch @label Logs</button>
            </div>

            <div class="file-search-box">
                <input type="text" id="fileSearchInput" class="file-search-input" placeholder="Search file name..." />
            </div>

            <div id="logFilesList" class="log-files-list"></div>

            <div id="dropZone" class="local-upload-card">
                <label class="upload-inner" for="localFileInput">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span>Open a local log file</span>
                    <small>Drop a .txt / .log file here or click to browse</small>
                </label>
                <input type="file" id="localFileInput" accept=".txt,.log" hidden />
            </div>
        </aside>

        <!-- Right: parsed log content -->
        <section class="log-content-panel">
            <div class="active-file-header">
                <div class="active-file-info">
                    <span id="activeFileTag" class="active-file-badge">@label.ToUpperInvariant() LOG</span>
                    <h3 id="activeFileName" class="active-file-title">No file selected</h3>
                    <span id="activeFileMeta" class="active-file-meta">Pick a log file from the list.</span>
                </div>
                <div class="active-file-actions">
                    <button type="button" id="btnExportJson" class="btn-action" disabled>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Export JSON
                    </button>
                </div>
            </div>

            <div class="log-kpi-grid">
                <div class="log-kpi-card">
                    <div class="kpi-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-title">Total Entries</span>
                        <span id="statTotal" class="kpi-val">0</span>
                        <span id="statParsedLines" class="kpi-sub">0 raw lines parsed</span>
                    </div>
                </div>
                <div class="log-kpi-card">
                    <div class="kpi-icon error-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-title">Errors</span>
                        <span id="statErrors" class="kpi-val error-val">0</span>
                        <span id="statErrorPct" class="kpi-sub">0% of log entries</span>
                    </div>
                </div>
                <div class="log-kpi-card">
                    <div class="kpi-icon warning-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-title">Warnings</span>
                        <span id="statWarnings" class="kpi-val warning-val">0</span>
                        <span class="kpi-sub">WRN level entries</span>
                    </div>
                </div>
                <div class="log-kpi-card">
                    <div class="kpi-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-title">Time Span</span>
                        <span id="statTimeSpan" class="kpi-val-time">N/A</span>
                        <span class="kpi-sub">First - last entry</span>
                    </div>
                </div>
            </div>

            <div class="log-filter-bar">
                <div class="filter-row">
                    <div class="filter-col">
                        <label class="filter-label" for="searchInput">Search</label>
                        <div class="input-with-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" id="searchInput" class="filter-input" placeholder="Message, stack trace or timestamp..." />
                        </div>
                    </div>
                    <div class="filter-col">
                        <label class="filter-label" for="levelFilter">Level</label>
                        <select id="levelFilter" class="filter-select">
                            <option value="ALL">All Levels</option>
                            <option value="ERRORS_ONLY">Errors Only (ERR + FTL)</option>
                            <option value="WARNINGS">Warnings and Above</option>
                            <option value="INF">Information</option>
                            <option value="WRN">Warning</option>
                            <option value="ERR">Error</option>
                            <option value="FTL">Fatal</option>
                        </select>
                    </div>
                    <div class="filter-col">
                        <label class="filter-label" for="filterStart">From</label>
                        <input type="datetime-local" id="filterStart" class="filter-input" />
                    </div>
                    <div class="filter-col">
                        <label class="filter-label" for="filterEnd">To</label>
                        <input type="datetime-local" id="filterEnd" class="filter-input" />
                    </div>
                </div>
            </div>

            <div class="log-table-container">
                <div class="log-table-header">
                    <span class="table-title">Log Stream</span>
                    <span id="matchingCountBadge" class="matching-badge">0 matching</span>
                </div>
                <div class="table-scroll-wrapper">
                    <table class="log-table">
                        <thead>
                            <tr>
                                <th class="col-ts">Timestamp</th>
                                <th class="col-lvl">Level</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody id="logRowsContainer">
                            <tr class="empty-row">
                                <td colspan="3">
                                    <div class="empty-state">
                                        <div class="spinner-sm" style="width: 24px; height: 24px;"></div>
                                        <h3>Loading @label Logs...</h3>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>
