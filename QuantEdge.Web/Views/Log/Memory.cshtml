@{
    ViewData["Title"] = "Memory Usage";
    ViewData["PageTitle"] = "Memory Usage";
}

<link rel="stylesheet" href="~/css/memorymanager.css" asp-append-version="true" />

@* Element IDs are read by memorymanager.js. *@
<div class="memory-container">
    <div class="memory-header">
        <div class="memory-title-group">
            <h2>Memory Usage</h2>
            <p class="metric-subtitle">API process RAM, in-memory market data cache and GC activity.</p>
        </div>
        <div class="memory-controls">
            <span id="lastUpdatedTime" class="metric-subtitle">Loading...</span>
            <label class="metric-subtitle" for="toggleAutoRefresh" style="display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
                <input type="checkbox" id="toggleAutoRefresh" checked />
                Auto-refresh (3s)
            </label>
            <button type="button" id="btnManualRefresh" class="btn-refresh">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-card-header">
                <span>Process Working Set</span>
                <div class="metric-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                        <rect x="9" y="9" width="6" height="6"></rect>
                    </svg>
                </div>
            </div>
            <div id="valProcessMemory" class="metric-value">0 MB</div>
            <div class="memory-progress-container"><div id="barProcessMemory" class="memory-progress-bar" style="width: 5%;"></div></div>
            <div class="metric-subtitle">Scaled against 1 GB</div>
        </div>
        <div class="metric-card">
            <div class="metric-card-header">
                <span>GC Heap</span>
                <div class="metric-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                    </svg>
                </div>
            </div>
            <div id="valGcHeapMemory" class="metric-value">0 MB</div>
            <div class="memory-progress-container"><div id="barGcHeapMemory" class="memory-progress-bar" style="width: 5%;"></div></div>
            <div class="metric-subtitle">Scaled against 512 MB</div>
        </div>
        <div class="metric-card">
            <div class="metric-card-header">
                <span>Market Cache RAM</span>
                <div class="metric-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                </div>
            </div>
            <div id="valCacheMemory" class="metric-value">0 MB</div>
            <div class="metric-subtitle">Estimated</div>
        </div>
        <div class="metric-card">
            <div class="metric-card-header">
                <span>Cached Symbols</span>
                <div class="metric-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                    </svg>
                </div>
            </div>
            <div id="valCachedSymbols" class="metric-value">0</div>
            <div class="metric-subtitle"><span id="valTotalCachedItems">0</span> cached items (candles + indicators)</div>
        </div>
    </div>

    <div class="detail-section-grid">
        <div class="panel-card">
            <div class="panel-card-title">Candles by Timeframe</div>
            <div class="table-responsive-wrapper">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Timeframe</th>
                            <th>Cached Candles</th>
                            <th>Est. Memory</th>
                        </tr>
                    </thead>
                    <tbody id="timeframeTableBody"></tbody>
                </table>
            </div>
        </div>
        <div class="panel-card">
            <div class="panel-card-title">Garbage Collection</div>
            <div class="table-responsive-wrapper">
                <table class="table-custom">
                    <tbody>
                        <tr><td>Gen 0 Collections</td><td><strong id="valGen0">0</strong></td></tr>
                        <tr><td>Gen 1 Collections</td><td><strong id="valGen1">0</strong></td></tr>
                        <tr><td>Gen 2 Collections</td><td><strong id="valGen2">0</strong></td></tr>
                        <tr><td>Cached Indicators</td><td><strong id="valIndicatorsCount">0</strong></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.QuantEdgeConfig = {
            apiBaseUrl: "@ViewBag.ApiBaseUrl"
        };
    </script>
    <script src="~/js/memorymanager.js" asp-append-version="true"></script>
}
