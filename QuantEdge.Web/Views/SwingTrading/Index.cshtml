            const tableRow = $(`#checklist-row-${symbol}`);
            const tableBtn = $(`#btn-toggle-${symbol}`);
            if (tableRow.length) {
                tableRow.toggle();
                tableBtn.toggleClass("active");
            }

            const cardDrawer = $(`#card-drawer-${symbol}`);
            const cardBtn = $(`#btn-card-toggle-${symbol}`);
