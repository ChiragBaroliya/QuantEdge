        function renderStockCards(signals) {
            const container = $("#stockCardsGrid");
            container.empty();

            if (!signals || signals.length === 0) {
                container.append('<div class="text-center text-muted py-4 w-100">No matching recommendations found for this slot and filter criteria.</div>');
                return;
            }

            signals.forEach(s => {
                const decClass = getDecisionClass(s.decision);
                const reasonTitle = escapeHtml(s.reason || "Evaluated by 11-Point Multi-Timeframe Scoring Model.");
                const checklist = s.checklist || { metCount: 0, totalCount: 11, conditions: [] };
                const metCount = checklist.metCount || 0;
                const totalCount = checklist.totalCount || 11;
                const pct = totalCount > 0 ? Math.round((metCount / totalCount) * 100) : 0;
                let badgeClass = metCount >= 8 ? "all-met" : (metCount >= 5 ? "partial-met" : "low-met");
                const score = s.score || 0;
                const isBuy = (s.decision && s.decision.toUpperCase() === "BUY");
                const scoreType = isBuy ? "buy" : "watch";

                let condCardsHtml = "";
                if (checklist.conditions && checklist.conditions.length > 0) {
                    condCardsHtml = checklist.conditions.map(c => `
                        <div class="cond-card ${c.isMet ? 'met' : 'pending'}">
                            <div class="cond-card-header">
                                <span class="cond-status-icon">${c.isMet ? '✓' : '✕'}</span>
                                <span class="cond-name">${c.name}</span>
                                <span class="cond-badge ${c.isMet ? 'pass' : 'pending'}">${c.isMet ? 'PASSED' : 'PENDING'}</span>
                            </div>
                            <div class="cond-desc">${c.description}</div>
                        </div>
                    `).join("");
                }

                const cardHtml = `
                    <div class="stock-card">
                        <div class="stock-card-top">
                            <div class="stock-card-symbol-block">
                                <span class="stock-card-symbol">${s.symbol}</span>
                                <span class="stock-card-price">₹${Number(s.close || s.entryPrice).toFixed(2)}</span>
                            </div>
                            <span class="rec-badge ${decClass}" title="${reasonTitle}">${s.decision}</span>
                        </div>

                        <div class="stock-card-progress">
                            <div class="score-progress-wrapper">
                                <div class="score-progress-header ${scoreType}">
                                    <span>Score & Rules</span>
                                    <span>${score}/100 (${metCount}/${totalCount})</span>
                                </div>
                                <div class="score-progress-bar">
                                    <div class="score-progress-fill ${scoreType}" style="width: ${score}%"></div>
                                </div>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 8px 0; font-size: 11px;">
                            <div class="metric-chip metric-chip-sl">SL: ₹${Number(s.stopLoss).toFixed(2)}</div>
                            <div class="metric-chip metric-chip-target">T1: ₹${Number(s.target1).toFixed(2)}</div>
                            <div class="metric-chip metric-chip-target">T2: ₹${Number(s.target2).toFixed(2)}</div>
                            <div class="metric-chip metric-chip-rr">R:R 1:${Number(s.riskRewardRatio).toFixed(1)}</div>
                        </div>

                        <div class="stock-card-chips">
                            <span class="stock-chip ${s.rsi14 >= 50 && s.rsi14 <= 75 ? 'positive' : ''}">RSI: ${Number(s.rsi14).toFixed(1)}</span>
                            <span class="stock-chip ${s.adx14 >= 20 ? 'positive' : ''}">ADX: ${Number(s.adx14).toFixed(1)}</span>
                            <span class="stock-chip ${s.volumeMultiplier >= 1.5 ? 'positive' : ''}">Vol: ${Number(s.volumeMultiplier).toFixed(1)}x</span>
                        </div>

                        <div class="stock-card-footer">
                            <button class="btn-card-toggle" id="btn-card-toggle-${s.symbol}" onclick="toggleChecklist('${s.symbol}')">
                                <span>11-Rule Analysis Details</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>

                        <div class="card-checklist-drawer" id="card-drawer-${s.symbol}">
                            <div style="margin-bottom: 8px; font-size: 11px; color: #cbd5e1; background: rgba(0,0,0,0.3); padding: 6px 10px; border-radius: 6px;">
                                ${reasonTitle}
                            </div>
                            <div class="checklist-cards-grid">
                                ${condCardsHtml}
                            </div>
                        </div>
                    </div>
                `;
                container.append(cardHtml);
            });
        }
    </script>
}

