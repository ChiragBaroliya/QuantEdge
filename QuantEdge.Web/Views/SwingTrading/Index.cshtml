@{
    ViewData["Title"] = "Swing Trading";
    ViewData["PageTitle"] = "Swing Trading Strategy & Performance";
    bool isAdmin = User.IsInRole("Admin");
}

<link rel="stylesheet" href="~/css/swingtrading.css" asp-append-version="true" />

<div class="swing-container">
    @if (!isAdmin)
    {
        <div class="alert alert-dark border-secondary text-secondary py-2 px-3 mb-3 small d-flex align-items-center justify-content-between">
            <span class="d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <strong>Read-Only Mode:</strong> Action buttons and EOD execution triggers are disabled for User role.
            </span>
            <span class="badge bg-secondary">User Role</span>
        </div>
    }

    <!-- Header Action Bar -->
    <div class="swing-header-actions">
        <div>
            <p class="swing-header-subtitle d-flex align-items-center flex-wrap gap-2" style="margin: 0; font-size: 13px; color: #cbd5e1;">
                <span>Multi-Timeframe Swing Strategy (1D Macro Filter + 15m/60m Intraday Scan during market hours 09:15 AM - 03:30 PM IST).</span>
                <span id="nextScanCountdownBadge" class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 ms-1" style="font-size: 0.8rem; padding: 6px 12px;">⏳ Next Scan: Initializing...</span>
            </p>
        </div>
        <div class="action-buttons-group">
            <button id="btnOpenReference" class="btn-trigger allow-view" data-tooltip="📖 **Rules & Formulas**: View swing trading filters and strategy math formulas.">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                Rules & Formulas
            </button>
            @if (isAdmin)
            {
                <button id="btnRunIntradayScan" class="btn-trigger" data-tooltip="⚡ **30-Min Scan Now**: Execute immediate 30-minute interval swing scan.">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    Scan 30-Min Now
                </button>
                <button id="btnRunJob" class="btn-trigger btn-primary-trigger" data-tooltip="🚀 **Execute EOD Job**: Scan market after close (3:45 PM IST) for new swing trade setups.">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                        <polyline points="16 7 22 7 22 13"></polyline>
                    </svg>
                    Execute EOD Job
                </button>
            }
            else
            {
                <button class="btn-trigger disabled opacity-50" disabled style="cursor: not-allowed;" title="Action triggers disabled for User role">
                    🔒 Execution Disabled (Read-Only)
                </button>
            }
        </div>
    </div>

    <!-- Live Scan & Strategy Metrics Grid -->
    <div class="stats-grid">
        <!-- Today's Scan Execution Summary -->
        <div class="card-glow stat-metric-card" data-tooltip="⏱️ **Scan Intervals**: Total 30-minute interval scans executed during market hours today.">
            <div class="stat-metric-header">
                <span>Today's Scan Intervals</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-metric-value-row">
                    <span id="statTotalSlotsToday" class="stat-metric-value" style="color: #38bdf8;">0 Slots</span>
                    <span id="statLatestSlotLabel" class="pnl-text positive" style="font-size: 13px;">Latest: None</span>
                </div>
                <div class="stat-metric-sub">
                    Scanned every 30 mins (09:15 AM – 03:30 PM IST)
                </div>
            </div>
        </div>

        <!-- Today's Total Recommendations -->
        <div class="card-glow stat-metric-card" data-tooltip="🚀 **Today's Recommendations**: Total BUY recommendations and WATCH candidates generated today.">
            <div class="stat-metric-header">
                <span>Active Recommendations</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                    <polyline points="16 7 22 7 22 13"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-metric-value-row">
                    <span id="statTotalRecsToday" class="stat-metric-value" style="color: #34d399;">0</span>
                    <span id="statRecsBreakdown" class="pnl-text positive" style="font-size: 13px;">0 BUY • 0 WATCH</span>
                </div>
                <div class="stat-metric-sub">
                    Score ≥ 50 with 3-Timeframe Hard Filters Passed
                </div>
            </div>
        </div>
    </div>

    <!-- Nifty Market Filter Banner -->
    <div class="nifty-status-banner" data-tooltip="🏛️ **NIFTY Market Filter**: Only allows buy trades when Nifty 50 is above its moving averages.">
        <div class="nifty-banner-left">
            <div style="display: flex; align-items: center; gap: 12px;">
                <h3 class="nifty-title">NIFTY MARKET FILTER</h3>
                <span id="niftyBadge" class="nifty-badge passed">Passed</span>
            </div>
            <div class="nifty-price-row">
                <span id="niftyClose" class="nifty-price">22,450.25</span>
                <span style="font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 600;">EOD CLOSE</span>
            </div>
        </div>
        
        <div class="nifty-banner-right">
            <div class="nifty-detail-item" data-tooltip="50-day Simple Moving Average (50 DMA)">
                <span class="label">50 Day DMA</span>
                <span id="niftySma50" class="value">21,950.00</span>
            </div>
            <div class="nifty-detail-item" data-tooltip="20-day Exponential Moving Average (20 EMA)">
                <span class="label">20 Day EMA</span>
                <span id="niftyEma20" class="value">22,120.40</span>
            </div>
            <div class="nifty-detail-item" data-tooltip="50-day Exponential Moving Average (50 EMA)">
                <span class="label">50 Day EMA</span>
                <span id="niftyEma50" class="value">21,990.20</span>
            </div>
            <div class="nifty-detail-item" style="border-left: 1px solid rgba(255,255,255,0.1); padding-left: 20px;" data-tooltip="Condition 1: Nifty Closing Price > 50 DMA">
                <span class="label">Price > 50 DMA</span>
                <span id="niftyCond1" class="value pnl-text positive">Yes</span>
            </div>
            <div class="nifty-detail-item" data-tooltip="Condition 2: 20 EMA > 50 EMA (Bullish Momentum)">
                <span class="label">EMA20 > EMA50</span>
                <span id="niftyCond2" class="value pnl-text positive">Yes</span>
            </div>
        </div>
    </div>

    <!-- Recommendations Watchlist -->
    <div class="swing-tab-pane active" id="paneRecommendations">
        
        <!-- 30-Minute Slot Navigation & Date Selector Card -->
        <div class="slot-navigation-card">
            <div class="slot-nav-header">
                <div class="slot-nav-title-group">
                    <h4 class="slot-nav-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        30-Minute Scan Intervals
                    </h4>
                </div>

                <div class="slot-date-controls">
                    <button class="slot-quick-date-btn active" id="btnDateToday">Today</button>
                    <button class="slot-quick-date-btn" id="btnDateYesterday">Yesterday</button>
                    <div class="slot-date-input-wrapper">
                        <input type="date" id="slotDatePicker" />
                    </div>
                </div>
            </div>

            <!-- Horizontal Slot Pills Bar -->
            <div class="slot-pills-scroll-wrapper">
                <button class="slot-scroll-arrow" id="btnScrollSlotsLeft" title="Scroll Left">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>

                <div class="slot-pills-scroll" id="slotPillsContainer">
                    <div class="slot-pill active" data-slot="all">
                        <span class="slot-pill-time">All Slots (Today)</span>
                        <div class="slot-pill-badges">
                            <span class="slot-badge-count total" id="badgeAllSlotsTotal">0</span>
                        </div>
                    </div>
                    <!-- Dynamically populated 30-minute interval slot pills -->
                </div>

                <button class="slot-scroll-arrow" id="btnScrollSlotsRight" title="Scroll Right">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            </div>

            <!-- Selected Slot Summary Strip -->
            <div class="slot-summary-strip">
                <div class="slot-summary-left">
                    <span class="slot-summary-label">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                        Selected Interval:
                    </span>
                    <span class="slot-summary-value" id="selectedSlotText">All Slots (Today)</span>
                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25" id="selectedSlotDateBadge">Loading...</span>
                </div>

                <div class="slot-summary-stats">
                    <span class="slot-stat-tag buy">
                        <span>🟢 BUY Signals:</span>
                        <strong id="slotSummaryBuyCount">0</strong>
                    </span>
                    <span class="slot-stat-tag watch">
                        <span>🟡 WATCH Candidates:</span>
                        <strong id="slotSummaryWatchCount">0</strong>
                    </span>
                </div>
            </div>
        </div>

        <div class="card-glow mt-3">
            <!-- Search, Filter & View Control Bar -->
            <div class="stock-filter-bar">
                <div class="filter-left-group">
                    <div class="filter-search-box">
                        <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="stockSearchInput" placeholder="Search symbol (e.g. RELIANCE, TATA)..." />
                    </div>

                    <div class="filter-pills-group">
                        <span class="filter-pill pill-buy active" id="pillBuy" data-filter="buy">🟢 BUY Signals (<span id="countBuyPill">0</span>)</span>
                        <span class="filter-pill" id="pillWatch" data-filter="watch">🟡 WATCH Candidates (<span id="countWatchPill">0</span>)</span>
                        <span class="filter-pill" id="pillHighScore" data-filter="highscore">⭐ High Score (70+)</span>
                        <span class="filter-pill" id="pillAll" data-filter="all">All Recommendations (<span id="countAllPill">0</span>)</span>
                    </div>
                </div>

                <div class="filter-right-group">
                    <span class="results-counter" id="resultsCounterText">Showing 0 stocks</span>
                    <div class="view-mode-toggle">
                        <button class="view-btn" id="btnViewGrid" title="Switch to Mobile/Tablet Card Grid View">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            Cards
                        </button>
                        <button class="view-btn active" id="btnViewTable" title="Switch to Desktop Compact Table View">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                            Table
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile & Tablet Responsive Cards Grid View -->
            <div id="stockCardsGrid" class="stock-cards-grid" style="display: none;">
                <div class="text-center text-muted py-4 w-100">Loading recommendations...</div>
            </div>

            <!-- Fixed-Height Scrollable Table View (Desktop) -->
            <div id="stockTableView" class="table-scroll-container">
                <table class="swing-table">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>Entry Price</th>
                            <th>Decision & Score</th>
                            <th>Stop Loss</th>
                            <th>Targets (T1 / T2)</th>
                            <th>Risk:Reward</th>
                            <th>Vol Surge</th>
                            <th>RSI & ADX</th>
                            <th>EMA Trend</th>
                            <th>11-Rule Analysis</th>
                        </tr>
                    </thead>
                    <tbody id="watchlistTableBody">
                        <tr>
                            <td colspan="10" class="text-center py-4">
                                <span class="text-muted">Loading recommendations...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Interactive Pagination Bar -->
            <div class="pagination-wrapper">
                <div class="page-size-selector">
                    <span>Rows per page:</span>
                    <select id="pageSizeSelect">
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="3000">All</option>
                    </select>
                </div>

                <div class="pagination-controls">
                    <button class="page-nav-btn" id="btnPrevPage" disabled>◄ Prev</button>
                    <div class="page-numbers-group" id="pageNumbersContainer">
                        <button class="page-num-btn active">1</button>
                    </div>
                    <button class="page-nav-btn" id="btnNextPage" disabled>Next ►</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Non-Blocking Background Job Progress Card -->

<div id="jobFloatCard" class="job-float-card">
    <div class="job-float-header">
        <div class="job-float-title">
            <div class="spinner" style="width: 16px; height: 16px; border-width: 2px;"></div>
            <span id="jobFloatTitle">30-Minute Swing Scan Running...</span>
        </div>
        <span id="jobFloatProgressText" class="job-float-progress-text">0%</span>
    </div>
    <div class="job-float-bar">
        <div id="jobFloatBarFill" class="job-float-fill"></div>
    </div>
    <div id="jobFloatDesc" class="job-float-desc">Initiating background processing...</div>
</div>

<partial name="_StrategyFormulasModal" />

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const API_BASE_URL = "@ViewBag.ApiBaseUrl";
        
        let allStockSignals = [];
        let allTrades = [];
        let currentFilter = "buy";
        let searchQuery = "";
        let currentViewMode = window.innerWidth < 768 ? "grid" : "table";
        let currentPage = 1;
        let pageSize = 25;
        let jobPollInterval = null;
        let selectedDateStr = new Date().toISOString().split('T')[0];
        let selectedSlotLabel = "all";
        let currentSlotsList = [];

        // SignalR Connection Setup for Real-time 30-Min Intraday Scan Auto-Update
        function initSwingSignalR() {
            if (typeof signalR === "undefined") return;

            const connection = new signalR.HubConnectionBuilder()
                .withUrl(`${API_BASE_URL}/hubs/marketdata`)
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveSwingSlotUpdate", function(slotUpdate) {
                console.log("⚡ SignalR Received Swing Slot Update:", slotUpdate);
                if (slotUpdate) {
                    handleSlotUpdatePush(slotUpdate);
                }
            });

            connection.on("ReceiveSwingDashboardUpdate", function(dashboardData) {
                console.log("⚡ SignalR Received Swing Dashboard Update:", dashboardData);
                if (dashboardData) {
                    populateNifty(dashboardData.niftyStatus);
                    const nextRunTime = dashboardData.nextRunTime || dashboardData.NextRunTime;
                    const nextRunFormatted = dashboardData.nextRunFormatted || dashboardData.NextRunFormatted;
                    const isMarketOpen = dashboardData.isMarketOpen !== undefined ? dashboardData.isMarketOpen : (dashboardData.IsMarketOpen !== undefined ? dashboardData.IsMarketOpen : false);
                    startNextScanCountdownTimer(nextRunTime, nextRunFormatted, isMarketOpen);
                }
            });

            connection.start().then(function() {
                console.log("SignalR Connected for Swing Dashboard");
                connection.invoke("SubscribeSwingDashboard").catch(err => console.error("Error subscribing to SwingDashboard:", err));
            }).catch(err => console.error("SignalR Connection Error:", err));
        }

        function handleSlotUpdatePush(slotUpdate) {
            const todayStr = new Date().toISOString().split('T')[0];
            const scanDateStr = slotUpdate.scanDate ? slotUpdate.scanDate.split('T')[0] : todayStr;

            // Toast notification
            Swal.fire({
                icon: 'success',
                title: `⚡ 30-Min Scan: ${slotUpdate.slotLabel}`,
                text: `Generated ${slotUpdate.buyCount} BUY and ${slotUpdate.watchCount} WATCH recommendations!`,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 5000,
                timerProgressBar: true
            });

            if (selectedDateStr === scanDateStr) {
                loadSlotsForDate(selectedDateStr, selectedSlotLabel);
                loadSlotRecommendations(selectedDateStr, selectedSlotLabel);
            }
        }

        $(document).ready(function() {
            // Set initial date picker value
            $("#slotDatePicker").val(selectedDateStr);
            $("#selectedSlotDateBadge").text(formatDateBadge(selectedDateStr));

            startNextScanCountdownTimer();
            updateViewModeUI();
            initSwingSignalR();

            // Load initial dashboard stats and slots
            loadDashboard();
            loadSlotsForDate(selectedDateStr, "all");
            loadSlotRecommendations(selectedDateStr, "all");

            checkRunningBackgroundJobs();

            // Date picker listener
            $("#slotDatePicker").change(function() {
                selectedDateStr = $(this).val();
                updateQuickDateButtons();
                $("#selectedSlotDateBadge").text(formatDateBadge(selectedDateStr));
                selectedSlotLabel = "all";
                loadSlotsForDate(selectedDateStr, "all");
                loadSlotRecommendations(selectedDateStr, "all");
            });

            // Quick Date Buttons
            $("#btnDateToday").click(function() {
                const today = new Date().toISOString().split('T')[0];
                $("#slotDatePicker").val(today).trigger("change");
            });

            $("#btnDateYesterday").click(function() {
                const yest = new Date();
                yest.setDate(yest.getDate() - 1);
                $("#slotDatePicker").val(yest.toISOString().split('T')[0]).trigger("change");
            });

            // Scroll arrows
            $("#btnScrollSlotsLeft").click(function() {
                const container = $("#slotPillsContainer");
                container.animate({ scrollLeft: container.scrollLeft() - 200 }, 200);
            });

            $("#btnScrollSlotsRight").click(function() {
                const container = $("#slotPillsContainer");
                container.animate({ scrollLeft: container.scrollLeft() + 200 }, 200);
            });

            // Section Tabs Switching
            $(".swing-tab-btn").click(function() {
                const paneId = $(this).data("pane");
                $(".swing-tab-btn").removeClass("active");
                $(".swing-tab-pane").removeClass("active");
                
                $(this).addClass("active");
                $(`#${paneId}`).addClass("active");
            });

            // Live Search Input Listener
            $("#stockSearchInput").on("input", function() {
                searchQuery = $(this).val().toLowerCase().trim();
                currentPage = 1;
                filterAndRenderStocks();
            });

            // Filter Pills Listener
            $(".filter-pill").click(function() {
                $(".filter-pill").removeClass("active");
                $(this).addClass("active");
                currentFilter = $(this).data("filter");
                currentPage = 1;
                filterAndRenderStocks();
            });

            // Page Size Selector Listener
            $("#pageSizeSelect").change(function() {
                pageSize = parseInt($(this).val(), 10) || 25;
                currentPage = 1;
                filterAndRenderStocks();
            });

            // Pagination Button Listeners
            $("#btnPrevPage").click(function() {
                if (currentPage > 1) {
                    currentPage--;
                    filterAndRenderStocks();
                }
            });

            $("#btnNextPage").click(function() {
                currentPage++;
                filterAndRenderStocks();
            });

            // View Mode Toggle Listeners
            $("#btnViewGrid").click(function() {
                currentViewMode = "grid";
                updateViewModeUI();
            });

            $("#btnViewTable").click(function() {
                currentViewMode = "table";
                updateViewModeUI();
            });

            // Open Modal
            $("#btnOpenReference").click(function() {
                $("#strategyFormulasModal").addClass("active");
                $("body").css("overflow", "hidden");
            });

            // Close Modal
            $("#btnCloseModal, #strategyFormulasModal").click(function(e) {
                if (e.target === this || $(e.target).closest('#btnCloseModal').length) {
                    $("#strategyFormulasModal").removeClass("active");
                    $("body").css("overflow", "");
                }
            });

            $(document).keydown(function(e) {
                if (e.key === "Escape" && $("#strategyFormulasModal").hasClass("active")) {
                    $("#strategyFormulasModal").removeClass("active");
                    $("body").css("overflow", "");
                }
            });

            // Trigger Background Actions
            $("#btnRunIntradayScan").click(function() {
                triggerBackgroundJob("/api/swing/run-intraday", "intraday30m", "30-Minute Swing Scan Running...");
            });

            $("#btnRunJob").click(function() {
                triggerBackgroundJob("/api/swing/run-job", "eod", "Executing EOD Daily Analysis Job...");
            });

            $("#btnRunBackfill").click(function() {
                triggerBackgroundJob("/api/swing/backfill", "backfill", "Historical 2-Year Backtest Running...");
            });
        });

        function formatDateBadge(dateStr) {
            if (!dateStr) return "";
            const d = new Date(dateStr + "T00:00:00");
            return d.toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' });
        }

        function updateQuickDateButtons() {
            const today = new Date().toISOString().split('T')[0];
            const yest = new Date();
            yest.setDate(yest.getDate() - 1);
            const yestStr = yest.toISOString().split('T')[0];

            $("#btnDateToday").toggleClass("active", selectedDateStr === today);
            $("#btnDateYesterday").toggleClass("active", selectedDateStr === yestStr);
        }

        function updateViewModeUI() {
            if (currentViewMode === "grid") {
                $("#btnViewGrid").addClass("active");
                $("#btnViewTable").removeClass("active");
                $("#stockCardsGrid").show();
                $("#stockTableView").hide();
            } else {
                $("#btnViewTable").addClass("active");
                $("#btnViewGrid").removeClass("active");
                $("#stockTableView").show();
                $("#stockCardsGrid").hide();
            }
        }

        function getEndpointUrl(path) {
            let base = (API_BASE_URL || '').replace(/\/+$/, '');
            let endpoint = path.startsWith('/') ? path : '/' + path;

            if (base.endsWith('/api') && endpoint.startsWith('/api/')) {
                endpoint = endpoint.substring(4);
            }
            return base + endpoint;
        }

        let countdownInterval = null;

        function startNextScanCountdownTimer(nextRunTimeIso, nextRunFormatted, isMarketOpen) {
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }

            let targetTimeMs = 0;
            let marketOpenStatus = isMarketOpen;
            let runTextFormatted = nextRunFormatted;

            if (nextRunTimeIso) {
                targetTimeMs = new Date(nextRunTimeIso).getTime();
            } else {
                const fallback = getClientNextRunFallback();
                targetTimeMs = fallback.targetMs;
                marketOpenStatus = fallback.isMarketOpen;
                runTextFormatted = fallback.formatted;
            }

            function updateTimer() {
                const now = new Date().getTime();
                const diffMs = targetTimeMs - now;

                if (diffMs <= 0) {
                    $("#nextScanCountdownBadge").html(`🔄 <strong style="color: #60a5fa;">Syncing Market Data & Evaluating Signals...</strong>`);
                    return;
                }

                const totalSecs = Math.floor(diffMs / 1000);
                const hours = Math.floor(totalSecs / 3600);
                const mins = Math.floor((totalSecs % 3600) / 60);
                const secs = totalSecs % 60;

                let timeStr = "";
                if (hours > 0) {
                    timeStr = `${hours}h ${mins.toString().padStart(2, '0')}m ${secs.toString().padStart(2, '0')}s`;
                } else {
                    timeStr = `${mins.toString().padStart(2, '0')}m ${secs.toString().padStart(2, '0')}s`;
                }

                const targetFormattedTime = new Date(targetTimeMs).toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' });

                if (marketOpenStatus) {
                    $("#nextScanCountdownBadge").html(`⏳ Next Scan in: <strong style="color: #38bdf8;">${timeStr}</strong> <span style="opacity: 0.75;">(${targetFormattedTime})</span>`);
                } else {
                    $("#nextScanCountdownBadge").html(`🌙 Market Closed <span style="opacity: 0.75;">(Next: ${runTextFormatted || targetFormattedTime})</span>`);
                }
            }

            updateTimer();
            countdownInterval = setInterval(updateTimer, 1000);
        }

        function getClientNextRunFallback() {
            const now = new Date();
            const utcMs = now.getTime() + (now.getTimezoneOffset() * 60000);
            const istNow = new Date(utcMs + (3600000 * 5.5));

            const day = istNow.getDay();
            const isWeekend = (day === 0 || day === 6);
            const hours = istNow.getHours();
            const minutes = istNow.getMinutes();
            const currentMins = hours * 60 + minutes;

            const marketStartMins = 9 * 60 + 15;
            const marketEndMins = 15 * 60 + 30;
            const isMarketOpen = !isWeekend && (currentMins >= marketStartMins && currentMins <= marketEndMins);

            let targetIst = new Date(istNow);

            if (isMarketOpen) {
                let nextMin = minutes < 15 ? 15 : (minutes < 45 ? 45 : 15);
                if (minutes >= 45) targetIst.setHours(targetIst.getHours() + 1);
                targetIst.setMinutes(nextMin, 0, 0);

                if ((targetIst.getHours() * 60 + targetIst.getMinutes()) > marketEndMins) {
                    targetIst.setDate(targetIst.getDate() + 1);
                    targetIst.setHours(9, 45, 0, 0);
                    while (targetIst.getDay() === 0 || targetIst.getDay() === 6) {
                        targetIst.setDate(targetIst.getDate() + 1);
                    }
                }
            } else {
                if (currentMins > marketEndMins) targetIst.setDate(targetIst.getDate() + 1);
                targetIst.setHours(9, 45, 0, 0);
                while (targetIst.getDay() === 0 || targetIst.getDay() === 6) {
                    targetIst.setDate(targetIst.getDate() + 1);
                }
            }

            const diffMs = targetIst.getTime() - istNow.getTime();
            return {
                targetMs: Date.now() + diffMs,
                isMarketOpen: isMarketOpen,
                formatted: targetIst.toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' })
            };
        }

