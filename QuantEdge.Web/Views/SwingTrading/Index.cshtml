            const container = $("#slotPillsContainer");
            container.empty();

            let totalAllBuy = 0;
            let totalAllWatch = 0;
            let totalAll = 0;
            let latestSlot = null;

            if (slots && slots.length > 0) {
                totalAllBuy = slots.reduce((acc, s) => acc + (s.buyCount || 0), 0);
                totalAllWatch = slots.reduce((acc, s) => acc + (s.watchCount || 0), 0);
                totalAll = slots.reduce((acc, s) => acc + (s.totalCount || 0), 0);
                latestSlot = slots.find(s => s.isLatest) || slots[slots.length - 1];

                $("#statTotalSlotsToday").text(`${slots.length} Slots`);
                $("#statLatestSlotLabel").text(`Latest: ${latestSlot ? latestSlot.slotLabel : 'None'}`);
                $("#statTotalRecsToday").text(totalAll);
                $("#statRecsBreakdown").text(`${totalAllBuy} BUY • ${totalAllWatch} WATCH`);
            } else {
                $("#statTotalSlotsToday").text(`0 Slots`);
                $("#statLatestSlotLabel").text(`Latest: None`);
                $("#statTotalRecsToday").text(`0`);
                $("#statRecsBreakdown").text(`0 BUY • 0 WATCH`);
