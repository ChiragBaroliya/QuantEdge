        function filterAndRenderStocks() {
            let filtered = allStockSignals;

            const buyCount = allStockSignals.filter(s => s.decision && s.decision.toUpperCase() === "BUY").length;
            const watchCount = allStockSignals.filter(s => s.decision && s.decision.toUpperCase() === "WATCH").length;
            const highScoreCount = allStockSignals.filter(s => (s.score || 0) >= 70).length;

            $("#countBuyPill").text(buyCount);
            $("#countWatchPill").text(watchCount);
            $("#countAllPill").text(allStockSignals.length);

            if (currentFilter === "buy") {
                filtered = filtered.filter(s => s.decision && s.decision.toUpperCase() === "BUY");
            } else if (currentFilter === "watch") {
                filtered = filtered.filter(s => s.decision && s.decision.toUpperCase() === "WATCH");
            } else if (currentFilter === "highscore") {
                filtered = filtered.filter(s => (s.score || 0) >= 70);
            }

            if (searchQuery) {
                filtered = filtered.filter(s => s.symbol.toLowerCase().includes(searchQuery));
            }

            const totalFiltered = filtered.length;
            const totalPages = Math.ceil(totalFiltered / pageSize) || 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = Math.min(startIdx + pageSize, totalFiltered);
            const pageSlice = filtered.slice(startIdx, endIdx);

            if (totalFiltered === 0) {
                $("#resultsCounterText").text("Showing 0 stocks");
            } else {
                $("#resultsCounterText").text(`Showing ${startIdx + 1}–${endIdx} of ${totalFiltered} recommendations`);
            }

            renderStockTable(pageSlice);
            renderStockCards(pageSlice);
            renderPaginationControls(totalPages);
        }

        function renderPaginationControls(totalPages) {
            $("#btnPrevPage").prop("disabled", currentPage <= 1);
            $("#btnNextPage").prop("disabled", currentPage >= totalPages);

            const container = $("#pageNumbersContainer");
            container.empty();

            let pagesToShow = [];
            if (totalPages <= 5) {
                for (let p = 1; p <= totalPages; p++) pagesToShow.push(p);
            } else {
                pagesToShow.push(1);
                if (currentPage > 2 && currentPage < totalPages) {
                    pagesToShow.push(currentPage);
                } else if (currentPage <= 2) {
                    pagesToShow.push(2);
                } else if (currentPage >= totalPages - 1) {
                    pagesToShow.push(totalPages - 1);
                }
                pagesToShow.push(totalPages);
                pagesToShow = [...new Set(pagesToShow)].sort((a, b) => a - b);
            }

            pagesToShow.forEach(p => {
                const btn = $(`<button class="page-num-btn ${p === currentPage ? 'active' : ''}">${p}</button>`);
                btn.click(function() {
                    currentPage = p;
                    filterAndRenderStocks();
                });
                container.append(btn);
            });
        }

        function getDecisionClass(decision) {
            if (!decision) return "neutral";
            const dUpper = decision.toUpperCase();
            if (dUpper.includes("STRONG BUY")) return "strong-buy";
            if (dUpper.includes("BUY")) return "buy";
            if (dUpper.includes("WATCH")) return "hold";
            if (dUpper.includes("SELL")) return "sell";
            if (dUpper.includes("AVOID")) return "avoid";
            return "hold";
        }

        function escapeHtml(text) {
            if (!text) return "";
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

