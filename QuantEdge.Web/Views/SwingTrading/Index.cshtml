        function triggerBackgroundJob(endpoint, jobType, titleText) {
            $.ajax({
                url: getEndpointUrl(endpoint),
                type: "POST",
                success: function(res) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Background Process Started',
                        text: res.message || 'Job initiated in background.',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 4000
                    });

                    startJobStatusPolling(jobType, titleText);
                },
                error: function(err) {
                    console.error("Job trigger failed.", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Trigger Failed',
                        text: err.responseText || "Internal server error",
                        confirmButtonColor: 'var(--theme-accent)',
                        background: 'var(--bg-card)',
                        color: 'var(--text-primary)'
                    });
                }
            });
        }

        function checkRunningBackgroundJobs() {
            $.get(getEndpointUrl(`/api/swing/job-status?jobType=intraday30m`), function(res) {
                if (res && res.isRunning) {
                    startJobStatusPolling("intraday30m", "30-Minute Swing Scan Running...");
                }
            });
            $.get(getEndpointUrl(`/api/swing/job-status?jobType=backfill`), function(res) {
                if (res && res.isRunning) {
                    startJobStatusPolling("backfill", "Historical 2-Year Backtest Running...");
                }
            });
        }

        function startJobStatusPolling(jobType, titleText) {
            $("#jobFloatTitle").text(titleText);
            $("#jobFloatCard").fadeIn();

            if (jobPollInterval) clearInterval(jobPollInterval);

            jobPollInterval = setInterval(function() {
                $.get(getEndpointUrl(`/api/swing/job-status?jobType=${jobType}`), function(status) {
                    if (!status) return;

                    if (status.isRunning) {
                        const pct = status.progressPercent || 0;
                        $("#jobFloatProgressText").text(`${pct}%`);
                        $("#jobFloatBarFill").css("width", `${pct}%`);
                        $("#jobFloatDesc").text(status.statusMessage || "Processing...");
                    } else {
                        clearInterval(jobPollInterval);
                        $("#jobFloatCard").fadeOut();

                        if (status.lastError) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Job Failed',
                                text: status.lastError,
                                confirmButtonColor: 'var(--theme-accent)',
                                background: 'var(--bg-card)',
                                color: 'var(--text-primary)'
                            });
                        } else if (status.progressPercent === 100) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Task Completed!',
                                text: status.statusMessage || 'Background process finished successfully.',
                                confirmButtonColor: 'var(--theme-accent)',
                                background: 'var(--bg-card)',
                                color: 'var(--text-primary)'
                            });
                            loadSlotsForDate(selectedDateStr, selectedSlotLabel);
                            loadSlotRecommendations(selectedDateStr, selectedSlotLabel);
                            loadDashboard();
                        }
                    }
                });
            }, 2000);
        }

        function populateNifty(ns) {
