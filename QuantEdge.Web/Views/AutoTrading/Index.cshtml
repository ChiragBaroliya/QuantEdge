@{
    ViewData["Title"] = "Auto Paper Trading";
    ViewData["PageTitle"] = "Auto Paper Trading Dashboard";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
}

<link rel="stylesheet" href="~/css/autotrading.css" asp-append-version="true" />
<div id="autotrade-config" data-api-base-url="@apiBaseUrl" style="display:none;"></div>

<div class="autotrade-container">
    <!-- Master Header Card -->
    <div class="autotrade-header-card">
        <div class="autotrade-title-group">
            <h1>🤖 Auto Paper Trading Engine</h1>
            <p class="autotrade-subtitle">Automated 15-min scanner (~190 NSE symbols) with Zerodha KiteTicker WebSocket tick monitoring & REST fallback.</p>
        </div>

        <div class="autotrade-status-badges">
            <div class="badge-counter" id="trade-counter-badge">
                0 / 5 trades used today
            </div>
            <div class="badge-ws connected" id="ws-status-badge">
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span> WebSocket Connected
            </div>
            <div class="toggle-switch-container">
                <span class="switch-label">Auto Trading:</span>
                <label class="switch">
                    <input type="checkbox" id="chkAutoTradeToggle" />
                    <span class="slider"></span>
                </label>
            </div>
        </div>
    </div>

    <!-- Metrics Stats Grid -->
    <div class="autotrade-stats-grid">
        <div class="stat-card">
            <div class="stat-label">System Status</div>
            <div class="stat-value" id="sys-status-text" style="color: #f87171;">PAUSED</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Available Capital</div>
            <div class="stat-value" id="stat-capital">₹1,00,000.00</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Open Auto Positions</div>
            <div class="stat-value" id="stat-open-count">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Unrealized P&L</div>
            <div class="stat-value" id="stat-unrealized-pnl">₹0.00</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Today's Realized P&L</div>
            <div class="stat-value" id="stat-realized-pnl">₹0.00</div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="autotrade-grid">
        <!-- Left Column: Tables & Console -->
        <div class="autotrade-main-col">
            <!-- Open Auto Positions Card -->
            <div class="card-box">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <h3 style="margin:0; font-size:16px; color:#38bdf8;">⚡ Open Auto Positions (Real-time Ticks)</h3>
                    <span style="font-size:12px; color:#94a3b8;">Monitored via KiteTicker WebSocket / REST Fallback</span>
                </div>
                <div class="table-responsive">
                    <table class="qe-table">
                        <thead>
                            <tr>
                                <th>Symbol</th>
                                <th>Entry Price</th>
                                <th>Live LTP</th>
                                <th>Quantity (Value)</th>
                                <th>Target (+5%)</th>
                                <th>Stop Loss (-3%)</th>
                                <th>Unrealized P&L</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-open-positions-body">
                            <tr>
                                <td colspan="7" class="text-center" style="padding:24px; text-align:center; color:#ffffff; font-weight:500;">No active OPEN auto positions right now. Scanner will place paper BUY orders when criteria match.</td>
                            </tr>
                        </tbody>


                    </table>
                </div>
            </div>

            <!-- Live Event Audit Stream Console -->
            <div class="card-box">
                <h3 style="margin:0 0 12px 0; font-size:16px; color:#38bdf8;">📋 Live Auto Trade Audit Stream</h3>
                <div class="log-terminal" id="log-console-box">
                    <div class="log-entry"><span class="time">[System]</span> Initializing SignalR live audit log listener...</div>
                </div>
            </div>
        </div>

        <!-- Right Column: Auto Trade Settings Panel -->
        <div class="autotrade-side-col">
            <div class="settings-panel">
                <h3 class="panel-title">⚙️ Auto Trade Settings</h3>
                <form id="frmAutoSettings">
                    <div class="form-group">
                        <label class="form-label">Available Capital (₹)</label>
                        <input type="number" id="txtCapital" class="form-input" value="100000" min="1000" step="5000" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Fixed Amount Per Trade (₹)</label>
                        <input type="number" id="txtFixedAmount" class="form-input" value="20000" min="500" step="1000" />
                        <small style="color:#94a3b8; font-size:11px;">Trade quantity will be calculated up to this amount.</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Profit Target %</label>
                        <input type="number" id="txtTargetPct" class="form-input" value="5.0" min="0.5" max="50" step="0.5" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Stop Loss %</label>
                        <input type="number" id="txtStopLossPct" class="form-input" value="3.0" min="0.5" max="50" step="0.5" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Max Duration (Trading Days)</label>
                        <input type="number" id="txtMaxDuration" class="form-input" value="20" min="1" max="100" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Max Trades Per Day</label>
                        <input type="number" id="txtMaxTrades" class="form-input" value="5" min="1" max="20" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Min Condition Match (Out of 13)</label>
                        <input type="number" id="txtMinConditions" class="form-input" value="12" min="1" max="13" />
                        <small style="color:#94a3b8; font-size:11px;">Minimum criteria required to trigger auto BUY.</small>
                    </div>

                    <button type="button" class="btn-save-settings" id="btnSaveSettings">💾 Save Auto Settings</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/autotrading.js" asp-append-version="true"></script>
}
