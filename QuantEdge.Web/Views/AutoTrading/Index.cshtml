@{
    ViewData["Title"] = "Auto Paper Trading";
    ViewData["PageTitle"] = "Auto Paper Trading Dashboard";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
}

<link rel="stylesheet" href="~/css/autotrading.css" asp-append-version="true" />
<div id="autotrade-config" data-api-base-url="@apiBaseUrl" style="display:none;"></div>

<div class="autotrade-container">
    <!-- Master Header Card -->
    <div class="autotrade-header-card">
        <div class="autotrade-title-group">
            <h1>🤖 Auto Paper Trading Engine</h1>
            <p class="autotrade-subtitle">Automated 15-min scanner over active stocks with Zerodha KiteTicker WebSocket tick monitoring & REST fallback.</p>
        </div>

        <div class="autotrade-status-badges">
            <button type="button" id="btnOpenPaperGuide" class="btn-guide-trigger" data-tooltip="📖 How It Works: Step-by-step beginner guide with practical examples.">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>User Guide</span>
            </button>
            <div class="badge-counter" id="nextScanCountdownBadge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                ⏳ Next Scan: Initializing...
            </div>
            <div class="badge-counter" id="trade-counter-badge">
                0 / 5 trades used today
            </div>
            <div class="badge-ws connected" id="ws-status-badge">
                <span class="ws-dot"></span> WebSocket Connected
            </div>
            <div class="toggle-switch-container">
                <span class="switch-label">Auto Trading:</span>
                <label class="switch">
                    @if (User.IsInRole("Admin"))
                    {
                        <input type="checkbox" id="chkAutoTradeToggle" />
                    }
                    else
                    {
                        <input type="checkbox" id="chkAutoTradeToggle" disabled title="Auto Trading Master Switch can only be toggled by System Admin" />
                    }
                    <span class="slider"></span>
                </label>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <button type="button" id="btnResetPaperTrading" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-1" style="border-radius: 8px; font-weight: 600; font-size: 12px; border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1);" title="Reset all open positions, execution history, and logs to start fresh with initial capital">
                    🗑️ Reset Paper Trading
                </button>
            }
        </div>
    </div>

    <!-- Metrics Stats Sections -->
    <div class="metrics-sections-wrapper">
        <!-- Section 1: Overall Calculations -->
        <div class="metrics-section">
            <div class="metrics-section-title">
                <span class="section-icon">🌐</span> Overall Calculations
            </div>
            <div class="autotrade-stats-grid">
                <div class="stat-card" title="Shows whether the automated trading bot is currently ACTIVE or PAUSED.">
                    <div class="stat-label">System Status</div>
                    <div class="stat-value" id="sys-status-text" style="color: #f87171;">PAUSED</div>
                </div>
                <div class="stat-card" title="Maximum budget limit configured for the Auto Trading engine.">
                    <div class="stat-label">Auto Capital Limit</div>
                    <div class="stat-value" id="stat-capital">₹1,00,000.00</div>
                </div>
                <div class="stat-card" title="Unused cash balance in your account available for taking new trades.">
                    <div class="stat-label">Available Margin</div>
                    <div class="stat-value" id="stat-available-margin" style="color: #38bdf8;">₹0.00</div>
                </div>
                <div class="stat-card" title="Total money currently locked in your active open paper positions.">
                    <div class="stat-label">Used Margin</div>
                    <div class="stat-value" id="stat-used-margin" style="color: #f59e0b;">₹0.00</div>
                </div>
                <div class="stat-card" title="Number of auto-traded stock positions currently open.">
                    <div class="stat-label">Open Auto Positions</div>
                    <div class="stat-value" id="stat-open-count">0</div>
                </div>
                <div class="stat-card" title="Live total profit or loss of all open auto positions based on real-time market prices.">
                    <div class="stat-label">Unrealized P&L</div>
                    <div class="stat-value" id="stat-unrealized-pnl">₹0.00</div>
                </div>
            </div>
        </div>

        <!-- Section 2: Today's Calculations -->
        <div class="metrics-section">
            <div class="metrics-section-title">
                <span class="section-icon">📅</span> Today's Calculations
            </div>
            <div class="autotrade-stats-grid today-stats-grid">
                <div class="stat-card" title="Total auto trades executed today vs maximum allowed daily limit.">
                    <div class="stat-label">Today's Trades Used</div>
                    <div class="stat-value" id="stat-today-trade-count" style="color: #38bdf8;">0 / 5 Trades</div>
                </div>
                <div class="stat-card highlight-card" title="Total trade capital deployed/used for today's auto trades (e.g. ₹20,000 per trade × trades executed).">
                    <div class="stat-label">Today Used Trade Amount</div>
                    <div class="stat-value" id="stat-today-used-amount" style="color: #38bdf8;">₹0.00</div>
                </div>
                <div class="stat-card" title="Total profit or loss from auto trades closed today.">
                    <div class="stat-label">Today's Realized P&L</div>
                    <div class="stat-value" id="stat-realized-pnl">₹0.00</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="autotrade-grid">
        <!-- Left Column: Tables & Console -->
        <div class="autotrade-main-col">
            <!-- Open Auto Positions Card -->
            <div class="card-box">
                <div class="card-box-header">
                    <h3 class="card-title">⚡ Open Auto Positions <span class="card-subtitle-inline">(Real-time Ticks)</span></h3>
                    <span class="card-badge-info d-none d-sm-inline-block" title="Monitored live via KiteTicker WebSocket tick data with automatic REST polling fallback">Monitored via KiteTicker WebSocket / REST Fallback</span>
                </div>
                <div class="table-responsive-wrapper">
                    <div class="table-scroll-hint d-md-none">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                        <span>Swipe horizontally to view all position columns</span>
                    </div>
                    <div class="table-responsive">
                        <table class="qe-table">
                            <thead>
                                <tr>
                                    <th title="Stock symbol name">Symbol</th>
                                    <th title="Average price where position was bought">Entry Price</th>
                                    <th title="Current live market price from Zerodha">Live LTP</th>
                                    <th title="Number of shares bought and total value">Quantity (Value)</th>
                                    <th title="Target price to auto sell with profit">Target</th>
                                    <th title="Stop loss price (checked on closing basis in Swing mode)">Stop Loss</th>
                                    <th title="Trailing stop loss - in Swing mode it activates once price reaches entry + 1 ATR">Trailing SL</th>
                                    <th title="Live profit or loss for this position">Unrealized P&L</th>
                                </tr>
                            </thead>
                            <tbody id="tbl-open-positions-body">
                                <tr>
                                    <td colspan="8"class="text-center" style="padding:24px; text-align:center; color:#ffffff; font-weight:500;">No active OPEN auto positions right now. Scanner will place paper BUY orders when criteria match.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Execution History Card -->
            <div class="card-box mt-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="card-title m-0">📜 Execution History</h3>
                    <span id="historyAutoRefreshBadge" class="badge bg-secondary bg-opacity-25 text-info border border-info border-opacity-25 px-3 py-2 fw-medium">
                        🔄 Auto Refresh in: <strong id="historyCountdownText" style="color:#38bdf8;">05:00</strong>
                    </span>
                </div>

                <!-- History Filter Toolbar -->
                <div class="p-3 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25 rounded-3 mb-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-xl-3 col-lg-3 col-md-6 col-12">
                            <label class="paper-label text-light mb-1" for="historyFilterSymbol" title="Filter history by stock symbol">Stock Symbol</label>
                            <select id="historyFilterSymbol" class="form-select paper-input form-select-sm" title="Select stock symbol">
                                <option value="">All Symbols</option>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-6 col-12">
                            <label class="paper-label text-light mb-1" for="historyFilterSide" title="Filter by BUY or SELL side">Trade Side</label>
                            <select id="historyFilterSide" class="form-select paper-input form-select-sm" title="Select order side">
                                <option value="">All Sides</option>
                                <option value="BUY">BUY</option>
                                <option value="SELL">SELL</option>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                            <label class="paper-label text-light mb-1" for="historyFilterFromDate" title="Start date filter">From Date</label>
                            <input type="date" id="historyFilterFromDate" class="form-control paper-input form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" title="From date">
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                            <label class="paper-label text-light mb-1" for="historyFilterToDate" title="End date filter">To Date</label>
                            <input type="date" id="historyFilterToDate" class="form-control paper-input form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" title="End date filter">
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-12 col-12 d-flex gap-2 justify-content-end">
                            <button type="button" id="btnFilterHistory" class="btn btn-primary btn-sm px-3 fw-bold flex-grow-1" title="Apply selected filters">🔍 Filter</button>
                            <button type="button" id="btnResetHistoryFilter" class="btn btn-outline-secondary btn-sm px-3 fw-bold" title="Reset all filters">↺ Reset</button>
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="qe-table">
                        <thead>
                            <tr>
                                <th>TIME</th>
                                <th>SYMBOL</th>
                                <th>SIDE</th>
                                <th>QTY</th>
                                <th>ENTRY PRICE</th>
                                <th>EXECUTED PRICE</th>
                                <th>REALIZED P&L</th>
                                <th>REMARKS</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody">
                            <tr>
                                <td colspan="8" class="text-center text-white py-3">No execution history logged.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls Footer -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 bg-dark bg-opacity-75 border-top border-secondary border-opacity-25 rounded-bottom-3">
                    <span id="historyPaginationInfo" class="text-white small fw-medium">Showing 0 of 0 trades</span>
                    <nav aria-label="Trade history pagination">
                        <ul id="historyPaginationUl" class="pagination pagination-sm mb-0">
                            <!-- Dynamic page links rendered by JS -->
                        </ul>
                    </nav>
                </div>
            </div>

            <!-- Live Event Audit Stream Console -->
            <div class="card-box">
                <h3 class="card-title mb-2">📋 Live Auto Trade Audit Stream</h3>
                <div class="log-terminal" id="log-console-box">
                    <div class="log-entry"><span class="time">[System]</span> Initializing SignalR live audit log listener...</div>
                </div>
            </div>
        </div>

        <!-- Right Column: Auto Trade Settings Panel -->
        <div class="autotrade-side-col">
            <div class="settings-panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="panel-title mb-0">⚙️ Auto Trade Settings</h3>
                    @if (!User.IsInRole("Admin"))
                    {
                        <span class="badge bg-secondary text-white" style="font-size:11px; padding:4px 8px;" title="Only System Admin can edit settings">🔒 Read-Only (Admin Only)</span>
                    }
                </div>
                @{
                    // Same fields as the Auto Real Trade settings panel - Paper and Real run the same
                    // buy/sell rules (SwingTradeRules). Non-admins see the same form read-only.
                    bool readOnly = !User.IsInRole("Admin");
                }
                <form id="frmAutoSettings" class="settings-form-grid">
                    <div class="form-group col-half">
                        <label class="form-label" title="Budget limit allocated for auto trading.">Available Capital (₹)</label>
                        <input type="number" id="txtCapital" class="form-input" value="100000" min="100" step="100" disabled="@readOnly" title="Budget limit allocated for auto trading." />
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="Maximum money spent per auto trade.">Trade Amount (₹)</label>
                        <input type="number" id="txtFixedAmount" class="form-input" value="20000" min="100" step="100" disabled="@readOnly" title="Maximum money spent per auto trade." />
                        <small class="form-help-text">Trade qty up to this amount.</small>
                    </div>

                    <div class="form-group col-full">
                        <label class="form-label" title="Fallback target % - auto trades use Target (× ATR) below when a daily ATR is available.">Profit Target % (fallback)</label>
                        <input type="number" id="txtTargetPct" class="form-input" value="5.0" min="0.1" max="100" step="0.01" disabled="@readOnly" />
                        <small class="form-help-text">Only used when no daily ATR is available. Auto trades use Target (× ATR) below.</small>
                    </div>

                    <div class="form-group col-full">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <label class="form-label mb-0" style="margin-bottom: 0;" title="Emergency pause if today's loss breaches the limit. Always on - defaults to 10% of Available Capital.">Daily Loss Limit (₹) <span style="color:#f59e0b;">(always on)</span></label>
                            <label class="optional-toggle-label" style="font-size: 11px; cursor: pointer; color: #94a3b8; margin-bottom: 0; display: flex; align-items: center; gap: 4px;">
                                <input type="checkbox" id="chkEnableDailyLossLimit" style="cursor: pointer; width: 14px; height: 14px;" disabled="@readOnly" /> Custom ₹
                            </label>
                        </div>
                        <input type="number" id="txtMaxDailyLoss" class="form-input" placeholder="Default (10% of capital)" min="10" step="any" disabled />
                        <small class="form-help-text">Pauses the bot when today's loss reaches this. Leaving it off still applies 10% of capital.</small>
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="Maximum number of auto trades allowed per day.">Max Trades / Day</label>
                        <input type="number" id="txtMaxTrades" class="form-input" value="5" min="1" max="50" disabled="@readOnly" />
                        <small class="form-help-text">Plus a fixed cap of 10 open positions.</small>
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="Trading days (weekends & market holidays excluded) before a position is closed.">Max Days Hold</label>
                        <input type="number" id="txtMaxDuration" class="form-input" value="20" min="1" max="365" disabled="@readOnly" />
                        <small class="form-help-text">Trading days, not calendar days.</small>
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="Minimum strategy criteria required to trigger an auto buy signal.">Min Criteria (Score)</label>
                        <input type="number" id="txtMinConditions" class="form-input" value="10" min="1" max="13" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="New BUY signals are held back this many minutes after Window Start. Exits are never delayed.">Entry Delay (min)</label>
                        <input type="number" id="txtEntryDelay" class="form-input" value="15" min="0" max="120" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label">Window Start</label>
                        <input type="time" id="txtWindowStart" class="form-input" value="09:15" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label">Window End</label>
                        <input type="time" id="txtWindowEnd" class="form-input" value="15:30" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-full" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 10px; margin-top: 4px;">
                        <label class="form-label" style="color:#38bdf8;">Swing Exit Policy <span style="color:#94a3b8; font-weight:400;">(same rules as Real Trading)</span></label>
                        <small class="form-help-text">
                            Swing (Closing Basis): Stop Loss & Trailing SL are only checked from the Close Check Time, so an
                            intraday dip that recovers by the close won't sell. Only the Emergency Stop (SL + 1 ATR, max 12%
                            loss) and the Target act during the day. The Trailing SL never starts on the entry day; it activates
                            at entry + 1 ATR, starting at breakeven. Intraday: the previous behavior, with every stop checked live.
                        </small>
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label">Exit Mode</label>
                        <select id="selExitMode" class="form-input" disabled="@readOnly">
                            <option value="SWING_CLOSE">Swing (Closing Basis)</option>
                            <option value="INTRADAY">Intraday (Old)</option>
                        </select>
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label">Close Check Time</label>
                        <input type="time" id="txtCloseCheckTime" class="form-input" value="15:15" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="Stop Loss distance below entry, in daily ATRs (capped at 8%).">SL (× ATR)</label>
                        <input type="number" id="txtSlAtrMult" class="form-input" value="1.5" min="0.5" max="5" step="0.1" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-half">
                        <label class="form-label" title="Trailing SL distance below the price at the close, in daily ATRs.">Trail (× ATR)</label>
                        <input type="number" id="txtTrailAtrMult" class="form-input" value="3" min="0.5" max="10" step="0.1" disabled="@readOnly" />
                    </div>

                    <div class="form-group col-full">
                        <label class="form-label" title="Target distance above entry, in daily ATRs.">Target (× ATR)</label>
                        <input type="number" id="txtTargetAtrMult" class="form-input" value="3" min="0.5" max="20" step="0.1" disabled="@readOnly" />
                        <small class="form-help-text">ATR = the stock's daily Average True Range (14). Defaults: SL 1.5, Trail 3, Target 3.</small>
                    </div>

                    @if (!readOnly)
                    {
                        <button type="button" class="btn-save-settings col-full" id="btnSaveSettings">💾 Save Auto Settings</button>
                        <button type="button" class="btn btn-outline-danger col-full mt-2 fw-semibold" id="btnResetPaperTradingSettings" style="border-radius: 8px; font-size: 13px; padding: 9px; border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.08);" title="Clear all paper positions and trade logs">
                            🗑️ Reset & Clear Paper Trading Data
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-dark text-center col-full mt-2 style-readonly-msg" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #94a3b8; font-size: 12px; padding: 10px; border-radius: 6px;">
                            Auto Trade parameters are configured by System Administrator.
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_AutoPaperTradingGuideModal" />

@section Scripts {
    <script src="~/js/autotrading.js" asp-append-version="true"></script>
}
