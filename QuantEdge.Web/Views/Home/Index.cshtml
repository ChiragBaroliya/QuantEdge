@{
    ViewData["Title"] = "Real-time Signals";
    ViewData["PageTitle"] = "Market Signal Dashboard";
    bool isAdmin = User.IsInRole("Admin");
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/flow-diagram.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/stock-verdict.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/realtrade-journey.css" asp-append-version="true" />

<div class="dashboard-container">
    @if (!isAdmin)
    {
        <div class="alert alert-dark border-secondary text-secondary py-2 px-3 mb-3 small d-flex align-items-center justify-content-between">
            <span class="d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <strong>Read-Only Access Mode:</strong> You are viewing live signal telemetry with standard User permissions.
            </span>
            <span class="badge bg-secondary">User Role</span>
        </div>
    }
    <!-- Filters & Selection Row -->
    <div class="control-panel card">
        <div class="control-left">
            <div class="control-select-group" data-tooltip="🔍 **Stock Symbol**: Select a stock to analyze (e.g. RELIANCE, INFY, NIFTY).">
                <select id="stockSelector" class="custom-select" aria-label="Asset Symbol">
                    <option value="" disabled selected>Select Stock Symbol...</option>
                </select>
            </div>
            
            <div class="timeframe-group">
                <div class="tabs" data-tooltip="⏱️ **Timeframe**: 1 day sets the trend, 60 min confirms the setup, 15 min times the entry. 1 and 5 min are for watching the chart only - the verdict above never uses them.">
                    <button class="tab-btn tab-chart-only" data-timeframe="1m">1 MIN<span class="tab-role">chart only</span></button>
                    <button class="tab-btn tab-chart-only" data-timeframe="5m">5 MIN<span class="tab-role">chart only</span></button>
                    <button class="tab-btn active" data-timeframe="15m">15 MIN<span class="tab-role">timing</span></button>
                    <button class="tab-btn" data-timeframe="60m">60 MIN<span class="tab-role">setup</span></button>
                    <button class="tab-btn" data-timeframe="1d">1 DAY<span class="tab-role">trend</span></button>
                </div>
            </div>
        </div>

        <div class="control-right">
            <div class="auto-refresh-group" data-tooltip="🔄 **1m Auto Refresh**: Automatically refreshes chart data and AI signals every 60 seconds.">
                <button id="btnManualRefresh" class="btn-refresh-icon" title="Manual Refresh Now" aria-label="Manual Refresh">
                    <svg class="refresh-spin-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.5 2v6h-6M2.5 22v-6h6"></path>
                        <path d="M2 11.5a10 10 0 0 1 18.8-4.3L21.5 8M22 12.5a10 10 0 0 1-18.8 4.3L2.5 16"></path>
                    </svg>
                </button>
                <div class="auto-refresh-toggle-box">
                    <label class="switch switch-sm">
                        <input type="checkbox" id="toggleAutoRefresh" checked aria-label="Toggle 1m Auto Refresh">
                        <span class="slider"></span>
                    </label>
                    <span class="auto-refresh-title">1m Auto</span>
                    <span id="autoRefreshBadge" class="refresh-timer-badge">60s</span>
                </div>
            </div>
            <button id="btnOpenReference" class="btn-trigger" data-tooltip="📖 **Rules & Formulas**: View algorithm scoring weights and strategy rules.">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                Rules & Formulas
            </button>
            <div id="connectionStatus" class="connection-badge offline" data-tooltip="📡 **Live Connection**: Shows real-time market feed connection status.">
                <span class="status-dot"></span>
                <span class="status-text">Disconnected</span>
            </div>
        </div>
    </div>

    <!-- Overall verdict across all timeframes (stock-verdict.js) - same engine as the auto-trading bot -->
    <div id="verdictEmpty" class="card sv-empty">Select a stock to see its overall verdict across all timeframes.</div>
    <div id="verdictCard" class="card sv-card" hidden>
        <div class="sv-head">
            <div>
                <div class="sv-eyebrow">Overall verdict · all timeframes</div>
                <h2 class="sv-title"><span id="svSymbol"></span><span id="svPrice" class="sv-price"></span><span id="svChange" class="sv-change"></span></h2>
                <div class="sv-meta" id="svMeta"></div>
            </div>
            <div class="sv-tags" id="svTags"></div>
        </div>
        <div class="sv-body">
            <div class="sv-left">
                <div>
                    <div class="sv-for" id="svFor"></div>
                    <div class="sv-verdict" id="svVerdict"></div>
                </div>
                <div class="sv-ring" aria-hidden="true">
                    <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9" fill="none" stroke="#1e293b" stroke-width="3.2" /><circle id="svRingArc" cx="18" cy="18" r="15.9" fill="none" stroke-width="3.2" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100" /></svg>
                    <div class="sv-ring-num"><div><b id="svScore">–</b><span>of 100</span></div></div>
                </div>
                <p class="sv-why" id="svWhy"></p>
                <div class="sv-miss" id="svMiss"></div>
            </div>
            <div class="sv-right">
                <div class="sv-row"><h3>How the timeframes line up</h3><span>Higher timeframe always wins · click a box</span></div>
                <div class="qe-flow-canvas"><svg id="svSvg" xmlns="http://www.w3.org/2000/svg" role="img"></svg></div>
                <div class="sv-detail" id="svDetail" aria-live="polite"></div>
                <div>
                    <div class="sv-row" style="margin-bottom: 8px;"><h3>Where the score comes from</h3><span id="svScoreNote"></span></div>
                    <div class="sv-bar" id="svBar"></div>
                    <div class="sv-factors" id="svFactors" style="margin-top: 26px;"></div>
                </div>
                <div class="sv-bot" id="svBot" hidden></div>
            </div>
        </div>
    </div>

    <!-- Main Signal Indicator Grid -->
    <div class="signal-grid">
        <!-- AI Recommendation Glowing Card -->
        <div id="signalCard" class="card signal-card hold">
            <div class="signal-card-header">
                <span class="card-section-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right: 6px;">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    TIMEFRAME SIGNAL
                    <span class="info-tooltip-trigger" data-tooltip="📊 **Timeframe Signal**: Rule-based EMA, RSI, VWAP, MACD and volume score for the selected tab only. The overall verdict above combines all timeframes and is what the bot trades on.">
                        <svg class="info-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                    </span>
                </span>
                <span id="signalBadge" class="recommendation-badge hold" data-tooltip="🎯 **Current Signal**: Shows recommendation status: BUY, SELL, or HOLD.">HOLD</span>
            </div>
            
            <div class="signal-card-body">
                <div class="score-display">
                    <div class="radial-progress-wrapper" data-tooltip="🎯 **AI Score (0-100)**: Measures trend strength. Scores above 70 indicate strong bullish momentum.">
                        <svg class="radial-progress" viewBox="0 0 36 36">
                            <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path id="scoreCircle" class="circle" stroke-dasharray="0, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <div class="score-value-wrapper">
                            <span id="scoreValue" class="score-num">0</span>
                            <span class="score-label">SCORE</span>
                        </div>
                    </div>
                </div>

                <div class="signal-metrics-grid">
                    <div class="metric-box" data-tooltip="💪 **Signal Strength**: Indicates trend momentum intensity (Strong, Moderate, or Neutral).">
                        <span class="m-label">Strength</span>
                        <span id="signalStrength" class="m-val-badge neutral">Neutral</span>
                    </div>
                    <div class="metric-box" data-tooltip="🎯 **Trigger Price**: Stock price at the moment signal was generated.">
                        <span class="m-label">Trigger Price</span>
                        <span id="signalPrice" class="m-val-text monospace">-</span>
                    </div>
                    <div class="metric-box" data-tooltip="⏰ **Signal Time**: Time when signal was generated (in IST).">
                        <span class="m-label">Time (IST)</span>
                        <span id="signalTime" class="m-val-text monospace">-</span>
                    </div>
                    <div class="metric-box" data-tooltip="🛡️ **Confidence (%)**: Algorithm confidence level and indicator match ratio.">
                        <span class="m-label">Confidence</span>
                        <span id="signalConfidence" class="m-val-badge neutral">-</span>
                    </div>
                </div>
            </div>

            <div class="signal-card-footer">
                <div class="reasoning-title" data-tooltip="📋 **Justification Factors**: Key indicator conditions and reasons behind this signal.">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    JUSTIFICATION FACTORS
                </div>
                <p id="signalReasoning" class="reasoning-text">Please select a stock symbol to load real-time indicators and recommendation triggers.</p>
            </div>
        </div>

        <!-- Metric Details Quick Widgets -->
        <div class="metrics-widget-grid">
            <div class="widget card" data-tooltip="💵 **Current Price (LTP)**: Latest live stock price and daily percentage change.">
                <div class="w-header">
                    <span class="w-label">
                        CURRENT PRICE
                        <span class="info-tooltip-trigger" data-tooltip="💵 **Live Price (LTP)**: Latest traded stock price in live market.">
                            <svg class="info-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                        </span>
                    </span>
                    <span class="live-pulse-dot" title="Live Stream Active"></span>
                </div>
                <div class="w-value-wrapper">
                    <span id="widgetLTP" class="w-value monospace">-</span>
                    <span id="widgetChange" class="w-change neutral">0.00%</span>
                </div>
            </div>

            <div class="widget card" data-tooltip="📉 **RSI (14) Momentum**: Values above 60 indicate bullish momentum, below 40 indicate bearish.">
                <div class="w-header">
                    <span class="w-label">
                        RSI (14) MOMENTUM
                        <span class="info-tooltip-trigger" data-tooltip="📉 **RSI (14)**: Relative Strength Index (60+ Bullish, 40- Bearish).">
                            <svg class="info-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                        </span>
                    </span>
                    <span id="widgetRsiStatus" class="w-status neutral">Neutral</span>
                </div>
                <div class="w-value-wrapper">
                    <span id="widgetRSI" class="w-value monospace">-</span>
                </div>
                <div class="rsi-mini-track" data-tooltip="📊 RSI Meter (0-30 Oversold, 70-100 Overbought)">
                    <div id="rsiBarFill" class="rsi-mini-fill" style="width: 50%;"></div>
                </div>
            </div>

            <div class="widget card" data-tooltip="⚖️ **VWAP Difference**: Difference between live price and volume weighted average price.">
                <div class="w-header">
                    <span class="w-label">
                        VWAP DIFFERENCE
                        <span class="info-tooltip-trigger" data-tooltip="⚖️ **VWAP**: Distance of current price from institutional average price.">
                            <svg class="info-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                        </span>
                    </span>
                    <span id="widgetVwapStatus" class="w-status neutral">-</span>
                </div>
                <div class="w-value-wrapper">
                    <span id="widgetVWAP" class="w-value monospace">-</span>
                </div>
            </div>

            <div class="widget card" data-tooltip="🔀 **MACD Crossover**: Indicates trend direction via MACD Line and Signal Line crossover.">
                <div class="w-header">
                    <span class="w-label">
                        MACD CROSSOVER
                        <span class="info-tooltip-trigger" data-tooltip="🔀 **MACD**: Moving Average Convergence Divergence status.">
                            <svg class="info-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                        </span>
                    </span>
                    <span id="widgetMacdStatus" class="w-status neutral">No Cross</span>
                </div>
                <div class="w-value-wrapper">
                    <span id="widgetMACD" class="w-value monospace">-</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Trading Indicators -->
    <div class="card indicators-panel">
        <div class="indicators-panel-header">
            <div class="panel-title-wrapper">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span class="panel-title">TRADING INDICATORS</span>
                <span class="info-tooltip-trigger" data-tooltip="🎯 **At a glance**: Each card shows what one indicator is currently saying. Overall Signal is the actual strategy recommendation (same engine as AI Recommendation above) - the confirmation count shows how many indicators currently agree with it.">
                    <svg class="info-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </span>
            </div>
            <div class="overall-signal-summary">
                <div class="overall-signal-block">
                    <span class="overall-signal-label">Overall Signal</span>
                    <span id="overallSignalBadge" class="recommendation-badge hold">HOLD</span>
                </div>
                <div class="overall-signal-block">
                    <span class="overall-signal-label">Confirmation</span>
                    <span id="overallConfirmationCount" class="confirmation-count-badge">0 / 6</span>
                </div>
            </div>
        </div>

        <div class="indicators-confirmation-row" id="indicatorsConfirmationRow">
            <div class="confirmation-chip"><span class="chip-label">EMA</span><span id="chipEma" class="chip-value neutral">-</span></div>
            <div class="confirmation-chip"><span class="chip-label">RSI</span><span id="chipRsi" class="chip-value neutral">-</span></div>
            <div class="confirmation-chip"><span class="chip-label">MACD</span><span id="chipMacd" class="chip-value neutral">-</span></div>
            <div class="confirmation-chip"><span class="chip-label">VWAP</span><span id="chipVwap" class="chip-value neutral">-</span></div>
            <div class="confirmation-chip"><span class="chip-label">Volume</span><span id="chipVolume" class="chip-value neutral">-</span></div>
            <div class="confirmation-chip"><span class="chip-label">ADX</span><span id="chipAdx" class="chip-value neutral">-</span></div>
        </div>

        <div class="indicator-cards-grid">
            <!-- EMA 9/20 Card -->
            <div class="indicator-mini-card" data-tooltip="Exponential Moving Average crossover (9 vs 20 period). EMA9 above EMA20 is bullish momentum, below is bearish.">
                <div class="indicator-card-header">
                    <span class="indicator-card-title">EMA 9 / 20</span>
                    <span id="badgeEma" class="mini-signal-badge neutral">NEUTRAL</span>
                </div>
                <div id="emaMiniChartContainer" class="mini-chart-container"></div>
                <div class="indicator-card-footer">
                    <div class="indicator-card-values">
                        <span>EMA9 <b id="valEma9">-</b></span>
                        <span>EMA20 <b id="valEma20">-</b></span>
                    </div>
                    <span id="statusEma" class="indicator-card-status neutral">-</span>
                </div>
            </div>

            <!-- RSI Card -->
            <div class="indicator-mini-card" data-tooltip="Relative Strength Index (14 period). Above 70 is overbought, below 30 is oversold.">
                <div class="indicator-card-header">
                    <span class="indicator-card-title">RSI (14)</span>
                    <span id="badgeRsi" class="mini-signal-badge neutral">NEUTRAL</span>
                </div>
                <div id="rsiMiniChartContainer" class="mini-chart-container"></div>
                <div class="indicator-card-footer">
                    <div class="indicator-card-values">
                        <span>RSI <b id="valRsi">-</b></span>
                    </div>
                    <span id="statusRsi" class="indicator-card-status neutral">-</span>
                </div>
            </div>

            <!-- MACD Card -->
            <div class="indicator-mini-card" data-tooltip="MACD (12, 26, 9). A MACD-line crossover above/below the Signal line marks a trend change.">
                <div class="indicator-card-header">
                    <span class="indicator-card-title">MACD</span>
                    <span id="badgeMacd" class="mini-signal-badge neutral">NEUTRAL</span>
                </div>
                <div id="macdMiniChartContainer" class="mini-chart-container"></div>
                <div class="indicator-card-footer">
                    <div class="indicator-card-values">
                        <span>MACD <b id="valMacd">-</b></span>
                    </div>
                    <span id="statusMacd" class="indicator-card-status neutral">-</span>
                </div>
            </div>

            <!-- VWAP Card -->
            <div class="indicator-mini-card" data-tooltip="Volume Weighted Average Price. Price above VWAP is bullish, below is bearish.">
                <div class="indicator-card-header">
                    <span class="indicator-card-title">VWAP</span>
                    <span id="badgeVwap" class="mini-signal-badge neutral">NEUTRAL</span>
                </div>
                <div id="vwapMiniChartContainer" class="mini-chart-container"></div>
                <div class="indicator-card-footer">
                    <div class="indicator-card-values">
                        <span>Price <b id="valVwapPrice">-</b></span>
                        <span>VWAP <b id="valVwap">-</b></span>
                    </div>
                    <span id="statusVwap" class="indicator-card-status neutral">-</span>
                </div>
            </div>

            <!-- Volume Card -->
            <div class="indicator-mini-card" data-tooltip="Trading volume relative to its recent average. Confirms the strength of an existing BUY/SELL signal rather than generating its own.">
                <div class="indicator-card-header">
                    <span class="indicator-card-title">Volume</span>
                    <span id="badgeVolume" class="mini-signal-badge neutral">NO CONFIRMATION</span>
                </div>
                <div id="volumeMiniChartContainer" class="mini-chart-container"></div>
                <div class="indicator-card-footer">
                    <div class="indicator-card-values">
                        <span>Vol <b id="valVolume">-</b></span>
                        <span>Rel <b id="valRelVolume">-</b></span>
                    </div>
                    <span id="statusVolume" class="indicator-card-status neutral">-</span>
                </div>
            </div>

            <!-- ADX Card -->
            <div class="indicator-mini-card" data-tooltip="Average Directional Index (14 period) - measures trend STRENGTH, not direction. Below 20 is a weak/choppy trend (the Swing Trading engine requires ADX ≥ 20 before trading at all), 20-25 is average, 25+ is a strong trend.">
                <div class="indicator-card-header">
                    <span class="indicator-card-title">ADX (14)</span>
                    <span id="badgeAdx" class="mini-signal-badge neutral">WEAK</span>
                </div>
                <div id="adxMiniChartContainer" class="mini-chart-container adx-gauge-container">
                    <svg id="adxGaugeSvg" class="adx-gauge-svg" viewBox="0 0 200 116" preserveAspectRatio="xMidYMid meet">
                        <path class="adx-gauge-track adx-zone-weak" d="M20,100 A80,80 0 0,1 60,30.72"></path>
                        <path class="adx-gauge-track adx-zone-average" d="M60,30.72 A80,80 0 0,1 79.29,22.73"></path>
                        <path class="adx-gauge-track adx-zone-strong" d="M79.29,22.73 A80,80 0 0,1 180,100"></path>
                        <line id="adxGaugeNeedle" class="adx-gauge-needle" x1="100" y1="100" x2="100" y2="32"></line>
                        <circle class="adx-gauge-pivot" cx="100" cy="100" r="4.5"></circle>
                    </svg>
                    <div class="adx-gauge-readout">
                        <span id="valAdx" class="adx-gauge-value">ADX -</span>
                        <span id="lblAdxStrength" class="adx-gauge-strength neutral">-</span>
                    </div>
                </div>
                <div class="indicator-card-footer">
                    <div class="indicator-card-values">
                        <span>Current <b id="valAdxCurrent">-</b></span>
                        <span>Prior <b id="valAdxPrev">-</b></span>
                    </div>
                    <span id="statusAdx" class="indicator-card-status neutral">-</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Current Week P/L % Chart -->
    <div class="chart-panel card weekly-pnl-panel">
        <div class="chart-panel-header">
            <div class="panel-title-wrapper">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="12" width="4" height="8"></rect>
                    <rect x="10" y="6" width="4" height="14"></rect>
                    <rect x="17" y="9" width="4" height="11"></rect>
                </svg>
                <span class="panel-title" id="weeklyPnlTitle">Current Week P/L %</span>
            </div>
            <div class="weekly-pnl-nav">
                <button id="weeklyPnlTodayBtn" class="weekly-pnl-today-btn" type="button" title="Jump to current week">This Week</button>
                <button id="weeklyPnlPrevBtn" class="weekly-pnl-nav-btn" type="button" title="Previous Week" aria-label="Previous Week">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <span id="weeklyPnlRangeLabel" class="weekly-pnl-range-label">&ndash;</span>
                <button id="weeklyPnlNextBtn" class="weekly-pnl-nav-btn" type="button" title="Next Week" aria-label="Next Week" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
            </div>
        </div>
        <div class="weekly-pnl-subtitle" id="weeklyPnlSubtitle">Daily price performance for the current trading week</div>

        <div class="chart-panel-body weekly-pnl-body">
            <div class="chart-container-pane weekly-pnl-pane">
                <canvas id="weeklyPnlChartCanvas"></canvas>
                <div id="weeklyPnlEmptyState" class="weekly-pnl-empty-state">
                    No trading data available for this week.
                </div>
            </div>
        </div>
    </div>
</div>


</div>

<!-- Global Background Task Progress Panel -->
<div id="syncProgressPanel" style="position: fixed; bottom: 20px; left: 20px; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 16px; width: 300px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); z-index: 9999; display: none; transform: translateY(100px); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); flex-direction: column; gap: 8px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);">Background Task</span>
        <span id="syncProgressPercent" style="font-size: 12px; font-weight: 600; color: var(--theme-accent);">0%</span>
    </div>
    <div style="width: 100%; background: var(--bg-input); height: 6px; border-radius: 3px; overflow: hidden;">
        <div id="syncProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, var(--theme-accent), #8ba3cc); transition: width 0.3s ease;"></div>
    </div>
    <div id="syncProgressMessage" style="font-size: 11px; color: var(--text-secondary); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
        Initializing...
    </div>
</div>

<partial name="_StrategyFormulasModal" />

@* Config + popup for the Stock Journey "Flow" button on owned stocks (realtrade-journey.js) *@
<div id="realtrade-config" hidden data-api-base-url="@ViewBag.ApiBaseUrl" data-user-id="@ViewBag.UserId"></div>
<partial name="_StockJourneyModal" />

@section Scripts {
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- TradingView Lightweight Charts CDN -->
    <script src="~/js/theme/lightweight-charts.standalone.production.js"></script>
    <!-- Chart.js CDN (Current Week P/L % bar chart) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- Microsoft SignalR JS Client CDN -->
    <script src="~/js/theme/signalr.min.js"></script>
    <script>
        window.QuantEdgeConfig = {
            apiBaseUrl: "@ViewBag.ApiBaseUrl",
            userId: @ViewBag.UserId
        };
    </script>
    <script src="~/js/flow-diagram.js" asp-append-version="true"></script>
    <script src="~/js/stock-verdict.js" asp-append-version="true"></script>
    <script src="~/js/realtrade-journey.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Open Modal
            $("#btnOpenReference").click(function() {
                $("#strategyFormulasModal").addClass("active");
                $("body").css("overflow", "hidden");
            });

            // Close Modal
            $("#btnCloseModal, #strategyFormulasModal").click(function(e) {
                if (e.target === this || $(e.target).closest('#btnCloseModal').length) {
                    $("#strategyFormulasModal").removeClass("active");
                    $("body").css("overflow", "");
                }
            });

            $(document).keydown(function(e) {
                if (e.key === "Escape" && $("#strategyFormulasModal").hasClass("active")) {
                    $("#strategyFormulasModal").removeClass("active");
                    $("body").css("overflow", "");
                }
            });

            // Tab switching
            $(".qe-modal-nav-btn").click(function() {
                const tabId = $(this).data("tab");
                $(".qe-modal-nav-btn").removeClass("active");
                $(".qe-modal-pane").removeClass("active");
                $(this).addClass("active");
                $(`#${tabId}`).addClass("active");
            });



            // SignalR event handlers for global background sync
            connection.on("SyncProgress", (data) => {
                const panel = $("#syncProgressPanel");
                if (panel.css("display") === "none") {
                    panel.css("display", "flex");
                    setTimeout(() => panel.css("transform", "translateY(0)"), 10);
                }
                
                $("#syncProgressMessage").text(data.message);
                $("#syncProgressBar").css("width", `${data.progress}%`);
                $("#syncProgressPercent").text(`${Math.round(data.progress)}%`);
            });

            connection.on("SyncComplete", async (data) => {
                $("#syncProgressMessage").text(data.message);
                $("#syncProgressBar").css("width", "100%");
                $("#syncProgressPercent").text("100%");
                
                Swal.fire({
                    icon: 'success',
                    title: 'Sync Complete',
                    text: data.message,
                    background: '#141929',
                    color: '#e8edf5',
                    confirmButtonColor: '#4f9cf9',
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 5000
                });

                setTimeout(() => {
                    $("#syncProgressPanel").css("transform", "translateY(100px)");
                    setTimeout(() => $("#syncProgressPanel").css("display", "none"), 300);
                }, 3000);

                await fetchChartHistory(); // Refresh chart just in case active symbol was affected
            });

            connection.on("SyncError", (data) => {
                Swal.fire({
                    icon: 'error',
                    title: 'Sync Failed',
                    text: data.message,
                    background: '#141929',
                    color: '#e8edf5',
                    confirmButtonColor: '#f87171',
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 5000
                });

                setTimeout(() => {
                    $("#syncProgressPanel").css("transform", "translateY(100px)");
                    setTimeout(() => $("#syncProgressPanel").css("display", "none"), 300);
                }, 3000);
            });
        });
    </script>
}
