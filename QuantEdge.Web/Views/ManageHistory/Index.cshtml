@{
    ViewData["Title"] = "Manage History Data";
    ViewData["PageTitle"] = "Manage History Data";
}

<link rel="stylesheet" href="~/css/managehistory.css" asp-append-version="true" />

<div class="history-container" data-api-base-url="@ViewBag.ApiBaseUrl">
    <!-- Header Card -->
    <div class="history-header-card" data-tooltip="🔄 **Manage History**: Download and sync historical candlestick data from Zerodha API.">
        <div class="history-header-title">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
                <h2>Manage History Data</h2>
                <p>Filter date range and stock symbol to clear existing records and insert fresh historical data from Zerodha.</p>
            </div>
        </div>
    </div>

    <!-- Main History Form Card -->
    <div class="history-form-card">
        <div class="history-form-grid">
            <!-- Stock Selection Dropdown -->
            <div class="form-group-card" data-tooltip="📌 **Stock Filter**: Select a specific stock symbol or process all active stocks.">
                <label for="stockSelector" class="form-group-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3z"></path><path d="M7 12h10"></path></svg>
                    Stock Symbol Filter
                </label>
                <select id="stockSelector" class="form-group-select">
                    <option value="" selected>ALL STOCKS (All Active Instruments)</option>
                </select>
            </div>

            <!-- From Date Picker -->
            <div class="form-group-card" data-tooltip="📅 **From Date**: Start date for fetching historical candlestick data.">
                <label for="historyFromDate" class="form-group-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    From Date
                </label>
                <input type="date" id="historyFromDate" class="form-group-input" />
            </div>

            <!-- To Date Picker -->
            <div class="form-group-card" data-tooltip="📅 **To Date**: End date for fetching historical candlestick data.">
                <label for="historyToDate" class="form-group-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    To Date
                </label>
                <input type="date" id="historyToDate" class="form-group-input" />
            </div>
        </div>

        <!-- Timeframe Selector Section -->
        <div class="timeframe-selection-section" data-tooltip="⏱️ **Target Timeframe**: Select the candlestick timeframe to download.">
            <label class="form-group-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line></svg>
                Select Target Timeframe
            </label>

            <div class="timeframe-grid">
                <button type="button" class="timeframe-card-btn active" data-tf="1m" data-tooltip="⚡ Download 1-minute candles">
                    <span>1 MIN</span>
                    <span class="timeframe-subtext">1-Minute Bars</span>
                </button>
                <button type="button" class="timeframe-card-btn" data-tf="5m" data-tooltip="⚡ Download 5-minute candles">
                    <span>5 MIN</span>
                    <span class="timeframe-subtext">5-Minute Bars</span>
                </button>
                <button type="button" class="timeframe-card-btn" data-tf="15m" data-tooltip="⚡ Download 15-minute candles">
                    <span>15 MIN</span>
                    <span class="timeframe-subtext">15-Minute Bars</span>
                </button>
                <button type="button" class="timeframe-card-btn" data-tf="60m" data-tooltip="⚡ Download 60-minute (hourly) candles">
                    <span>60 MIN</span>
                    <span class="timeframe-subtext">Hourly Bars</span>
                </button>
                <button type="button" class="timeframe-card-btn" data-tf="1d" data-tooltip="⚡ Download 1-day (daily) candles">
                    <span>1 DAY</span>
                    <span class="timeframe-subtext">Daily Candle Bars</span>
                </button>
            </div>
        </div>

        <!-- Action Row -->
        <div class="action-trigger-row">
            <button type="button" id="btnStartHistoryReset" class="btn-execute-reset" data-tooltip="🚀 **Start Sync**: Clear existing records and download fresh history from broker API.">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
                    <polyline points="21 3 21 8 16 8"></polyline>
                </svg>
                Clear & Recreate History
            </button>
        </div>
    </div>

    <!-- Purge History Data Card -->
    <div class="history-form-card purge-card-container">
        <div class="history-header-title" style="margin-bottom: 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
            <div>
                <h3 style="margin: 0; color: #ef4444; font-size: 18px; font-weight: 700;">Purge / Delete History Data By Creation Date</h3>
                <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 13px;">Delete market candles and technical indicators across all timeframes matching selected creation date (created_at). Updates Stock Master history flags.</p>
            </div>
        </div>

        <div class="history-form-grid">
            <!-- Purge Stock Filter -->
            <div class="form-group-card" data-tooltip="📌 **Stock Filter**: Target a single stock symbol or select ALL STOCKS.">
                <label for="purgeStockSelector" class="form-group-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3z"></path><path d="M7 12h10"></path></svg>
                    Stock Symbol Filter
                </label>
                <select id="purgeStockSelector" class="form-group-select">
                    <option value="" selected>ALL STOCKS (All Active Instruments)</option>
                </select>
            </div>

            <!-- Target Creation Date Picker -->
            <div class="form-group-card" data-tooltip="📅 **Selected Date**: Select the created date (created_at) of records to delete.">
                <label for="purgeDate" class="form-group-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Created Date (created_at)
                </label>
                <input type="date" id="purgeDate" class="form-group-input" />
            </div>
        </div>

        <div class="action-trigger-row" style="margin-top: 16px;">
            <button type="button" id="btnExecutePurge" class="btn-execute-purge" data-tooltip="🗑️ **Purge Data**: Permanently delete candles and indicators for the selected date across all timeframes.">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Purge History Data
            </button>
        </div>
    </div>

    <!-- Progress & Live Execution Log Card -->
    <div id="progressCard" class="progress-card" style="display: none;" data-tooltip="📡 **Real-time Sync Progress**: Live progress connected to SignalR server.">
        <div class="progress-header">
            <span class="progress-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--theme-accent);"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line></svg>
                Synchronization Progress
            </span>
            <span id="progressPercentText" style="font-weight:700; font-size:14px; color:var(--theme-accent);">0%</span>
        </div>

        <div class="progress-bar-track">
            <div id="progressBarFill" class="progress-bar-fill"></div>
        </div>
        <div id="progressStatusText" style="font-size:13px; color:var(--text-muted);">Task initialized...</div>

        <!-- Real-time Console Log Box -->
        <div id="historyLogBox" class="log-box">
            <div class="log-entry info">[System] Connected to Real-time History Sync Hub. Ready.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/managehistory.js" asp-append-version="true"></script>
}
