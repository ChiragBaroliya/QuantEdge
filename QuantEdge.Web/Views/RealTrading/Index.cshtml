@{
    ViewData["Title"] = "Auto Real Trading (Live Broker)";
    ViewData["PageTitle"] = "Auto Real Trading Dashboard";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "1";
    var currentUserName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    if (string.IsNullOrWhiteSpace(currentUserName)) { currentUserName = User.Identity?.Name ?? "Chirag"; }
}

<link rel="stylesheet" href="~/css/autotrading.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/realtrading.css" asp-append-version="true" />
<div id="realtrade-config" 
     data-api-base-url="@apiBaseUrl" 
     data-user-id="@currentUserId"
     data-user-name="@currentUserName"
     style="display:none;"></div>

<div class="autotrade-container realtrade-container">
    <!-- Persistent Prerequisite Banners -->
    <div id="banner-token-missing" class="prerequisite-banner banner-token-alert" style="display: none;">
        <div class="banner-content">
            <span class="banner-icon">⚠️</span>
            <div class="banner-text">
                <strong>Action Required:</strong> Zerodha daily session token is missing or expired. Auto Real Trading is currently <strong>INACTIVE</strong>.
            </div>
        </div>
        <button type="button" class="btn-connect-zerodha-action" id="btnBannerConnectZerodha">
            ⚡ Connect Zerodha (1-Click Login)
        </button>
    </div>

    <div id="banner-ddpi-activation" class="prerequisite-banner banner-tpin-notice">
        <div class="banner-content">
            <span class="banner-icon" id="bannerDdpiIcon">🚀</span>
            <div class="banner-text" id="bannerDdpiText">
                <strong>Automated Real Trading Prerequisite:</strong> To allow the engine to automatically execute CNC Sell & Target exit orders via Zerodha API, please activate <strong>1-time DDPI</strong> in your Zerodha account.
            </div>
        </div>
        <div class="banner-actions-group" id="bannerDdpiActions">
            <button type="button" class="btn-tpin-guide" data-bs-toggle="modal" data-bs-target="#modalDdpiGuideline" title="Step-by-step 1-time DDPI activation guide">
                📖 DDPI Guide
            </button>
            <a href="https://console.zerodha.com/account/demat" target="_blank" class="btn-ddpi-enable" id="btnDdpiOpenConsole">
                <span>Enable DDPI Online</span> <span class="ddpi-arrow">↗</span>
            </a>
            <button type="button" class="btn-ddpi-verify-action" id="btnDdpiMarkComplete" title="Click if DDPI status is Completed in Zerodha Demat Console">
                ✅ I've Enabled DDPI
            </button>
        </div>
    </div>

    <div id="banner-market-locked" class="prerequisite-banner banner-market-lock" style="display: none;">
        <div class="banner-content">
            <span class="banner-icon">🔒</span>
            <div class="banner-text">
                <strong>Market Hours Lock Active:</strong> Risk & Strategy parameters are locked during active trading hours (09:15 AM - 03:30 PM IST). Parameter changes can be saved after 03:30 PM.
            </div>
        </div>
    </div>

    <!-- Master Header Card -->
    <div class="autotrade-header-card realtrade-header-card">
        <div class="autotrade-title-group">
            <div class="d-flex align-items-center gap-2">
                <h1>⚡ Auto Real Trading Engine</h1>
                <span class="live-real-badge">REAL MONEY (ZERODHA)</span>
            </div>
            <p class="autotrade-subtitle">Live automated order execution via Zerodha KiteConnect REST API with real-time risk guards, optional SL, trailing SL, and Kill-Switch protection.</p>
        </div>

        <div class="autotrade-status-badges">
            <button type="button" id="btnOpenRealGuide" class="btn-guide-trigger real-guide-trigger" data-tooltip="📖 Real Trading Guide: Safety rules, setup steps & practical examples.">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>Real Trading Guide</span>
            </button>
            <button type="button" class="btn-connect-broker" id="btnConnectZerodhaHeader" title="Click to authenticate Zerodha session for today">
                ⚡ Connect Zerodha
            </button>
            <div class="badge-token" id="broker-token-badge" title="Zerodha Session Token Status">
                <span class="token-dot"></span> Checking Token...
            </div>
            <div class="badge-ddpi" id="broker-ddpi-badge" title="DDPI (Demat Debit and Pledge Instruction) Status for CNC Selling">
                <span class="ddpi-dot"></span> <span id="ddpiBadgeText">DDPI: Active</span>
            </div>
            <div class="badge-counter" id="nextScanCountdownBadge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                ⏳ Next Scan: Initializing...
            </div>
            <div class="badge-counter" id="trade-counter-badge">
                0 / 5 trades used today
            </div>
            <div class="badge-ws connected" id="ws-status-badge">
                <span class="ws-dot"></span> WebSocket Connected
            </div>
            <div class="toggle-switch-container">
                <span class="switch-label">Live Trading:</span>
                <label class="switch">
                    @if (User.IsInRole("Admin"))
                    {
                        <input type="checkbox" id="chkRealTradeToggle" />
                    }
                    else
                    {
                        <input type="checkbox" id="chkRealTradeToggle" disabled title="Live Real Trading Master Switch can only be toggled by System Admin" />
                    }
                    <span class="slider real-slider"></span>
                </label>
            </div>
            <!-- Emergency Kill Switch Button -->
            <button type="button" class="btn-panic-kill-switch" id="btnEmergencyKillSwitch" title="Emergency Kill Switch: Square-off all live positions & pause bot">
                🚨 PANIC KILL SWITCH
            </button>
        </div>
    </div>

    <!-- Metrics Stats Sections -->
    <div class="metrics-sections-wrapper">
        <!-- Section 1: Broker & Overall Metrics -->
        <div class="metrics-section">
            <div class="metrics-section-title d-flex align-items-center flex-wrap gap-2">
                <span><span class="section-icon">🏦</span> Zerodha Broker & Account Metrics</span>
                <span class="badge-client-id" id="brokerClientIdTag" style="display:none; font-size:0.8rem; font-weight:700; background:rgba(56,189,248,0.15); color:#38bdf8; border:1px solid rgba(56,189,248,0.4); padding:3px 10px; border-radius:14px;"></span>
            </div>
            <div class="autotrade-stats-grid">
                <div class="stat-card" title="Shows whether live real trading is ACTIVE or PAUSED.">
                    <div class="stat-label">Automation Status</div>
                    <div class="stat-value" id="sys-status-text" style="color: #f87171;">PAUSED</div>
                </div>
                <div class="stat-card" title="Maximum capital permitted for live auto trade bot.">
                    <div class="stat-label">Allocated Capital</div>
                    <div class="stat-value" id="stat-capital">₹2,000.00</div>
                </div>
                <div class="stat-card" title="Live Available Cash margin in your Zerodha account.">
                    <div class="stat-label">Zerodha Live Cash</div>
                    <div class="stat-value" id="stat-available-margin" style="color: #38bdf8;">₹0.00</div>
                </div>
                <div class="stat-card" title="Margin utilised in open live trades.">
                    <div class="stat-label">Used Margin</div>
                    <div class="stat-value" id="stat-used-margin" style="color: #f59e0b;">₹0.00</div>
                </div>
                <div class="stat-card highlight-card" title="Real-time MTM (Mark to Market) Profit/Loss directly from Zerodha Broker API.">
                    <div class="stat-label">Zerodha Live MTM</div>
                    <div class="stat-value" id="stat-zerodha-m2m" style="color: #38bdf8; font-weight: 700;">₹0.00</div>
                </div>
                <div class="stat-card" title="Realized profit/loss closed today directly from Zerodha Broker API.">
                    <div class="stat-label">Zerodha Realized P&L</div>
                    <div class="stat-value" id="stat-zerodha-realized-pnl" style="color: #34d399;">₹0.00</div>
                </div>
                <div class="stat-card" title="Open real-money positions QuantEdge is currently auto-managing (see the Auto-Managed Positions tab).">
                    <div class="stat-label">Auto-Managed Open Positions</div>
                    <div class="stat-value" id="stat-open-count">0</div>
                </div>
                <div class="stat-card" title="Live unrealized profit or loss across auto-managed positions.">
                    <div class="stat-label">Auto-Managed Unrealized P&L</div>
                    <div class="stat-value" id="stat-unrealized-pnl">₹0.00</div>
                </div>
            </div>
        </div>

        <!-- Section 2: Today's Calculations -->
        <div class="metrics-section">
            <div class="metrics-section-title">
                <span class="section-icon">📅</span> Today's Execution Summary
            </div>
            <div class="autotrade-stats-grid today-stats-grid">
                <div class="stat-card" title="Total real trades executed today vs daily maximum limit.">
                    <div class="stat-label">Today's Real Trades</div>
                    <div class="stat-value" id="stat-today-trade-count" style="color: #38bdf8;">0 / 5 Trades</div>
                </div>
                <div class="stat-card highlight-card" title="Total capital deployed for today's live trades.">
                    <div class="stat-label">Today Deployed Capital</div>
                    <div class="stat-value" id="stat-today-used-amount" style="color: #38bdf8;">₹0.00</div>
                </div>
                <div class="stat-card" title="Realized profit or loss from live trades QuantEdge closed today.">
                    <div class="stat-label">Auto-Managed Realized P&L Today</div>
                    <div class="stat-value" id="stat-realized-pnl">₹0.00</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="autotrade-grid">
        <!-- Left Column: Tables & Console -->
        <div class="autotrade-main-col">
            <!-- Open Real Positions & Zerodha Live Positions Card -->
            <div class="card-box">
                <div class="card-box-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <ul class="nav nav-pills qe-nav-pills" id="positionTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-bot-positions" data-bs-toggle="pill" data-bs-target="#content-bot-positions" type="button" role="tab">
                                    ⚡ Auto-Managed Positions (<span id="badge-bot-count">0</span>)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-zerodha-positions" data-bs-toggle="pill" data-bs-target="#content-zerodha-positions" type="button" role="tab">
                                    🏦 Zerodha Live Positions (<span id="badge-zerodha-count">0</span>)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-zerodha-holdings" data-bs-toggle="pill" data-bs-target="#content-zerodha-holdings" type="button" role="tab">
                                    📦 Zerodha Holdings (<span id="badge-holdings-count">0</span>)
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="live-sync-indicator" id="liveSyncIndicator" title="Live Broker Polling Status">
                            <span class="live-pulse-dot"></span>
                            <span class="live-sync-text" id="liveSyncText">Live (5s)</span>
                        </div>
                        <select class="form-select form-select-sm qe-search-select" id="selAutoRefreshInterval" style="width: auto; font-size: 11.5px; height: 30px;" title="Set Auto-Refresh frequency for live positions & P&L">
                            <option value="5000" selected>⚡ Auto 5s</option>
                            <option value="10000">⏱️ Auto 10s</option>
                            <option value="15000">⏱️ Auto 15s</option>
                            <option value="0">⏸️ Paused</option>
                        </select>
                        <button class="btn btn-sm btn-outline-secondary" id="btnRefreshPositions" title="Click for immediate instant sync">
                            🔄 Sync Now
                        </button>
                    </div>
                </div>

                <div class="tab-content mt-3" id="positionTabContent">
                    <!-- Tab 1: Auto-Managed (Bot DB) Positions -->
                    <div class="tab-pane fade show active" id="content-bot-positions" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <small class="text-white" style="color: #ffffff !important; opacity: 0.95;">Real-money positions QuantEdge is actively auto-monitoring for Target/SL/Trailing-SL exit — empty until it buys, or you enable monitoring on a holding via "Set Target". (Zerodha Live Positions/Holdings below show your full broker account regardless of whether QuantEdge is managing the exit.)</small>
                            <span class="badge bg-dark border border-secondary text-warning">Auto-Exit Engine</span>
                        </div>
                        <!-- Advance Search & Filter Bar for Auto-Managed Positions -->
                        <div class="advance-search-bar mb-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md-5">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-dark border-secondary text-light">🔍</span>
                                        <input type="text" class="form-control form-control-sm qe-search-input" id="inpSearchPositions" placeholder="Search Auto-Managed Positions (e.g. RELIANCE)..." />
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <select class="form-select form-select-sm qe-search-select" id="selFilterPosSide">
                                        <option value="">All Sides (BUY / SELL)</option>
                                        <option value="BUY">BUY Only</option>
                                        <option value="SELL">SELL Only</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4">
                                    <select class="form-select form-select-sm qe-search-select" id="selFilterPosPnl">
                                        <option value="">All P&L (Profit / Loss)</option>
                                        <option value="PROFIT">📈 In Profit Only</option>
                                        <option value="LOSS">📉 In Loss Only</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive-wrapper">
                            <div class="table-responsive">
                                <table class="qe-table">
                                    <thead>
                                        <tr>
                                            <th>SYMBOL</th>
                                            <th>SIDE</th>
                                            <th>QTY</th>
                                            <th>AVG ENTRY</th>
                                            <th>CURRENT LTP</th>
                                            <th>TARGET</th>
                                            <th>STOP LOSS</th>
                                            <th>TRAILING SL</th>
                                            <th>P&L (₹)</th>
                                            <th>ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody id="openPositionsTableBody">
                                        <tr>
                                            <td colspan="10" class="text-center py-4 text-light" style="color: #cbd5e1 !important;">Loading open real positions...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Zerodha Direct Live Positions -->
                    <div class="tab-pane fade" id="content-zerodha-positions" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <small class="text-white" style="color: #ffffff !important; opacity: 0.95;">Today's intraday (MIS) and same-day equity activity, straight from Zerodha — rows already fully settled against your holdings are hidden here (see Holdings for what you still own).</small>
                            <span class="badge bg-dark border border-secondary text-info">Live Broker Feed</span>
                        </div>
                        <div class="table-responsive-wrapper">
                            <div class="table-responsive">
                                <table class="qe-table">
                                    <thead>
                                        <tr>
                                            <th>SYMBOL</th>
                                            <th>PRODUCT</th>
                                            <th>QTY</th>
                                            <th>BUY PRICE</th>
                                            <th>SELL PRICE</th>
                                            <th>LTP</th>
                                            <th>M2M (₹)</th>
                                            <th>UNREALISED</th>
                                            <th>REALISED</th>
                                            <th>TOTAL P&L (₹)</th>
                                            <th>ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody id="zerodhaPositionsTableBody">
                                        <tr>
                                            <td colspan="10" class="text-center py-4 text-light" style="color: #cbd5e1 !important;">Connect Zerodha to view live broker positions.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Zerodha Direct Holdings -->
                    <div class="tab-pane fade" id="content-zerodha-holdings" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <small class="text-white" style="color: #ffffff !important; opacity: 0.95;">Shares you actually own in your demat account, straight from Zerodha — includes today's T1 unsettled buys (not sellable until settled).</small>
                            <span class="badge bg-dark border border-secondary text-success">Demat Portfolio</span>
                        </div>
                        <div class="table-responsive-wrapper">
                            <div class="table-responsive">
                                <table class="qe-table">
                                    <thead>
                                        <tr>
                                            <th>SYMBOL</th>
                                            <th>QTY (DEMAT)</th>
                                            <th>AVG PRICE</th>
                                            <th>CURRENT LTP</th>
                                            <th>INVESTED (₹)</th>
                                            <th>CURRENT VALUE</th>
                                            <th>DAY CHANGE</th>
                                            <th>TOTAL P&L (₹)</th>
                                            <th>TARGET / MONITORING</th>
                                            <th>ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody id="zerodhaHoldingsTableBody">
                                        <tr>
                                            <td colspan="9" class="text-center py-4 text-light" style="color: #cbd5e1 !important;">Connect Zerodha to view live demat holdings.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Orders Card -->
            <div class="card-box mt-4">
                <div class="card-box-header">
                    <h3 class="card-title">📜 Real Orders Book <span class="card-subtitle-inline">(QuantEdge's own order log)</span></h3>
                    <small class="text-white" style="color: #ffffff !important; opacity: 0.85;">Recorded by QuantEdge as each order is placed/confirmed with Zerodha. If a status ever looks stale, use 🔄 Resync on that row to re-check it directly against the broker.</small>
                </div>

                <!-- Advance Search & Filter Bar for Orders -->
                <div class="advance-search-bar mb-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-dark border-secondary text-light">🔍</span>
                                <input type="text" class="form-control form-control-sm qe-search-input" id="inpSearchOrders" placeholder="Search by Symbol or Broker Order ID..." />
                            </div>
                        </div>
                        <div class="col-6 col-md-2">
                            <select class="form-select form-select-sm qe-search-select" id="selFilterOrderStatus">
                                <option value="">All Statuses</option>
                                <option value="FILLED">FILLED</option>
                                <option value="OPEN">OPEN</option>
                                <option value="REJECTED">REJECTED</option>
                                <option value="CANCELLED">CANCELLED</option>
                                <option value="PENDING">PENDING</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <select class="form-select form-select-sm qe-search-select" id="selFilterOrderSide">
                                <option value="">All Sides (BUY / SELL)</option>
                                <option value="BUY">BUY</option>
                                <option value="SELL">SELL</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <input type="date" class="form-control form-control-sm qe-search-select" id="inpFilterOrderDate" title="Filter by order date (IST)" />
                        </div>
                    </div>
                </div>

                <div class="table-responsive-wrapper">
                    <div class="table-responsive">
                        <table class="qe-table">
                            <thead>
                                <tr>
                                    <th>TIME (IST)</th>
                                    <th>BROKER ORDER ID</th>
                                    <th>SYMBOL</th>
                                    <th>SIDE</th>
                                    <th>QTY</th>
                                    <th>PRICE</th>
                                    <th>STATUS</th>
                                    <th>REMARKS / REASON</th>
                                    <th>ACTION</th>
                                </tr>
                            </thead>
                            <tbody id="recentOrdersTableBody">
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-light" style="color: #cbd5e1 !important;">No orders placed today.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Trade History & Performance Card -->
            <div class="card-box mt-4">
                <div class="card-box-header">
                    <h3 class="card-title">📈 Trade History & Performance <span class="card-subtitle-inline">(closed real trades)</span></h3>
                    <button class="btn btn-sm btn-outline-secondary" id="btnRefreshTradeHistory" onclick="loadTradeHistory()">🔄 Refresh</button>
                </div>

                <div class="autotrade-stats-grid mb-3">
                    <div class="stat-card" title="Number of closed (filled SELL) real trades on record.">
                        <div class="stat-label">Closed Trades</div>
                        <div class="stat-value" id="th-total-trades">0</div>
                    </div>
                    <div class="stat-card" title="Percentage of closed trades with a positive realized P&L.">
                        <div class="stat-label">Win Rate</div>
                        <div class="stat-value" id="th-win-rate">-</div>
                    </div>
                    <div class="stat-card" title="Sum of realized P&L across all closed trades on record.">
                        <div class="stat-label">Total Realized P&L</div>
                        <div class="stat-value" id="th-total-pnl">₹0.00</div>
                    </div>
                    <div class="stat-card" title="Average realized P&L per closed trade.">
                        <div class="stat-label">Avg P&L / Trade</div>
                        <div class="stat-value" id="th-avg-pnl">₹0.00</div>
                    </div>
                </div>
                <small class="text-white d-block mb-2" style="color: #ffffff !important; opacity: 0.85;">
                    Stats are computed from the most recent closed trades returned below (not necessarily your full lifetime history) - insufficient sample sizes should not be read as a validated edge.
                </small>

                <div class="table-responsive-wrapper">
                    <div class="table-responsive">
                        <table class="qe-table">
                            <thead>
                                <tr>
                                    <th>TIME (IST)</th>
                                    <th>SYMBOL</th>
                                    <th>SIDE</th>
                                    <th>ENTRY</th>
                                    <th>EXIT / EXECUTED</th>
                                    <th>QTY</th>
                                    <th>REALIZED P&L (₹)</th>
                                    <th>EXIT REASON</th>
                                </tr>
                            </thead>
                            <tbody id="tradeHistoryTableBody">
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-light" style="color: #cbd5e1 !important;">Loading trade history...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Real-time Console Log Card -->
            <div class="card-box audit-stream-card mt-4">
                <div class="card-box-header">
                    <div class="d-flex align-items-center gap-2">
                        <h3 class="card-title">📡 Live Real Trade Audit Stream</h3>
                        <span class="badge bg-dark border border-secondary text-info px-2 py-1" style="font-size: 10.5px;">Live Stream</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <input type="text" class="form-control form-control-sm qe-search-input d-none d-sm-inline-block" id="inpSearchLogs" placeholder="Filter logs..." style="max-width: 160px; font-size: 11.5px; height: 30px;" />
                        <button class="btn-clear-logs" id="btnClearLogs" title="Clear console logs">
                            🗑️ Clear
                        </button>
                    </div>
                </div>
                <div class="console-log-box" id="consoleLogContainer">
                    <div class="log-entry system">
                        <span class="log-time">[System]</span>
                        <span class="badge bg-secondary me-1" style="font-size: 0.68rem;">READY</span>
                        <span class="log-msg">Connecting to Real Trade SignalR event stream...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Settings & Risk Controls -->
        <div class="autotrade-side-col">
            <div class="card-box settings-card">
                <div class="card-box-header">
                    <h3 class="card-title">⚙️ Real Trade Risk & Strategy Parameters</h3>
                </div>
                <div class="settings-form-body">
                    <form id="frmRealTradeSettings">
                        <div class="form-group mb-3">
                            <label class="form-label" for="inpAvailableCapital">Allocated Capital (₹)</label>
                            <input type="number" step="any" min="100" max="50000000" class="form-control qe-input" id="inpAvailableCapital" name="AvailableCapital" placeholder="2000" required />
                            <small class="form-hint">Maximum trade budget allowed for the live bot.</small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="inpFixedAmount">Trade Amount per Stock (₹)</label>
                            <input type="number" step="any" min="10" max="5000000" class="form-control qe-input" id="inpFixedAmount" name="FixedAmountPerTrade" placeholder="400" required />
                            <small class="form-hint">Capital deployed per buy order (e.g. ₹400).</small>
                        </div>

                        <small class="form-hint text-warning d-block mb-2">
                            ⚠ For auto-scanned signals, the bot may use a dynamic ATR-based Target/Stop Loss
                            from the signal engine instead of the flat % values below, when the engine
                            supplies one. These fields remain authoritative for manual buys and holdings
                            enrolled via "Set Target".
                        </small>

                        <div class="form-group mb-3">
                            <label class="form-label" for="inpProfitTarget">Profit Target (%)</label>
                            <input type="number" step="any" min="0.1" max="100" class="form-control qe-input" id="inpProfitTarget" name="ProfitTargetPct" required />
                            <small class="form-hint">Mandatory exit target percentage (e.g. 5.0%). Used as-is for manual buys; auto-scanned trades may use the engine's dynamic target instead.</small>
                        </div>

                        <!-- Optional Stop Loss Toggle -->
                        <div class="optional-box mb-3">
                            <div class="optional-toggle-header">
                                <label class="optional-label" for="chkEnableStopLoss">
                                    <span class="optional-title">Stop Loss % Override <span class="text-warning">(always on — this only overrides the %)</span></span>
                                    <small class="optional-desc">Fixed percentage below entry price. Leaving this OFF does NOT disable Stop Loss — a 3% default is still applied automatically; this toggle only lets you set a custom percentage instead.</small>
                                </label>
                                <label class="qe-switch">
                                    <input type="checkbox" id="chkEnableStopLoss" />
                                    <span class="qe-slider"></span>
                                </label>
                            </div>
                            <div id="slInputWrapper" class="optional-input-wrapper" style="display: none;">
                                <label class="form-label mt-2" for="inpStopLoss">Stop Loss (%)</label>
                                <input type="number" step="any" min="0.1" max="100" class="form-control qe-input" id="inpStopLoss" name="StopLossPct" placeholder="e.g. 3.0" />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="inpTrailingSl">Trailing Stop Loss (%)</label>
                            <input type="number" step="any" min="0.1" max="50" class="form-control qe-input" id="inpTrailingSl" name="TrailingSlPct" required />
                            <small class="form-hint">Mandatory - dynamic trail that locks in profits as price rises. Always active; this sets the trail distance (e.g. 2.0%).</small>
                        </div>

                        <!-- Optional Daily Loss Circuit Breaker -->
                        <div class="optional-box mb-3">
                            <div class="optional-toggle-header">
                                <label class="optional-label" for="chkEnableDailyLossLimit">
                                    <span class="optional-title">Daily Loss Limit Override <span class="text-warning">(always on — this only overrides the ₹ amount)</span></span>
                                    <small class="optional-desc">Emergency pause if daily loss breaches limit. Leaving this OFF does NOT disable the breaker — a default of 10% of Allocated Capital is still enforced automatically; this toggle only lets you set a custom ₹ amount instead.</small>
                                </label>
                                <label class="qe-switch">
                                    <input type="checkbox" id="chkEnableDailyLossLimit" />
                                    <span class="qe-slider"></span>
                                </label>
                            </div>
                            <div id="dailyLossInputWrapper" class="optional-input-wrapper" style="display: none;">
                                <label class="form-label mt-2" for="inpMaxDailyLoss">Max Daily Loss Limit (₹)</label>
                                <input type="number" step="any" min="10" max="10000000" class="form-control qe-input" id="inpMaxDailyLoss" name="MaxDailyLossLimit" placeholder="e.g. 5000" />
                            </div>
                        </div>

                        <small class="form-hint text-warning d-block mb-2">
                            ⚠ The bot also enforces a fixed portfolio-wide cap of 10 concurrent open
                            positions across all symbols (not yet configurable here), independent of
                            Max Trades/Day below.
                        </small>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="inpMaxTrades">Max Trades/Day</label>
                                <input type="number" min="1" max="50" class="form-control qe-input" id="inpMaxTrades" name="MaxTradesPerDay" required />
                                <small class="form-hint">New BUY orders allowed today. Separate from the portfolio cap above.</small>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="inpMaxDuration">Max Days Hold</label>
                                <input type="number" min="1" max="365" class="form-control qe-input" id="inpMaxDuration" name="MaxDurationDays" required />
                                <small class="form-hint">Trading days (weekends & market holidays excluded), not calendar days.</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="selProductType">Product Type</label>
                                <select class="form-select qe-input" id="selProductType" name="ProductType">
                                    <option value="CNC">CNC (Delivery)</option>
                                    <option value="MIS">MIS (Intraday)</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="inpMinConditions">Min Criteria (Score)</label>
                                <input type="number" min="1" max="13" class="form-control qe-input" id="inpMinConditions" name="MinConditionsMatch" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="inpWindowStart">Window Start</label>
                                <input type="time" class="form-control qe-input" id="inpWindowStart" name="TradingWindowStart" required />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="inpWindowEnd">Window End</label>
                                <input type="time" class="form-control qe-input" id="inpWindowEnd" name="TradingWindowEnd" required />
                            </div>
                        </div>

                        <div class="settings-actions mt-3">
                            @if (User.IsInRole("Admin"))
                            {
                                <button type="submit" class="btn-save-settings" id="btnSaveSettings">
                                    💾 Save Risk & Strategy Settings
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-save-settings disabled" disabled title="Settings modification is restricted to System Admin">
                                    🔒 Admin Only
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm Square Off Single Position -->
<div class="modal fade" id="modalSquareOffPosition" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content qe-confirm-modal">
            <div class="modal-header">
                <h5 class="modal-title text-danger">⚠️ Confirm Real Position Square-off</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to exit and sell the open position for <strong id="sqSymbol" class="text-warning"></strong>?</p>
                <p class="text-muted small">This will immediately send a <strong>Real-Money Market SELL Order</strong> to Zerodha Kite OMS.</p>
                <input type="hidden" id="sqPositionId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmSquareOff">Yes, Execute Market Sell</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm Manual Sell (any Zerodha Live Position / Holding, tracked or not) -->
<div class="modal fade" id="modalManualSell" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content qe-confirm-modal">
            <div class="modal-header">
                <h5 class="modal-title text-danger">⚠️ Confirm Manual SELL</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to sell <strong id="msQuantity" class="text-warning"></strong> share(s) of <strong id="msSymbol" class="text-warning"></strong> at ~₹<strong id="msPrice" class="text-warning"></strong>?</p>
                <p class="text-muted small">This will immediately send a <strong>Real-Money Market SELL Order</strong> to Zerodha Kite OMS.</p>
                <input type="hidden" id="msRawSymbol" />
                <input type="hidden" id="msRawQuantity" />
                <input type="hidden" id="msRawPrice" />
                <input type="hidden" id="msRawProduct" />
                <input type="hidden" id="msRawEntryPrice" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmManualSell">Yes, Execute Market Sell</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Set Auto-Sell Target for a Zerodha Holding -->
<div class="modal fade" id="modalSetHoldingTarget" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content qe-confirm-modal">
            <div class="modal-header">
                <h5 class="modal-title text-info">📦 Enable Auto-Sell Monitoring</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Set a target price for <strong id="htSymbol" class="text-warning"></strong> (Qty: <strong id="htQuantity"></strong>, Avg: <strong id="htAveragePrice"></strong>).</p>
                <p class="text-muted small">The bot will automatically place a Real-Money Market SELL order once the live price reaches this target. No BUY order is placed — you already hold these shares.</p>
                <div class="mb-2">
                    <label class="form-label small">Target Price (₹)</label>
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm qe-search-select" id="htTargetPrice" />
                </div>
                <input type="hidden" id="htRawQuantity" />
                <input type="hidden" id="htRawAveragePrice" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info fw-bold" id="btnConfirmSetTarget">Enable Monitoring</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm Emergency Kill Switch -->
<div class="modal fade" id="modalEmergencyKillSwitch" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content qe-confirm-modal border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">🚨 EMERGENCY PANIC KILL SWITCH</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="fw-bold text-danger">This is an emergency panic action.</p>
                <ul class="text-light small">
                    <li>Instantly turns <strong>OFF</strong> the Real Auto Trading Bot.</li>
                    <li>Places real market exit orders with Zerodha for <strong>ALL active open positions</strong>.</li>
                    <li>Logs an emergency security audit incident.</li>
                </ul>
                <p>Do you wish to proceed immediately?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger fw-bold" id="btnConfirmKillSwitch">🚨 YES, KILL SWITCH NOW</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: 1-Time DDPI Activation Guideline -->
<div class="modal fade" id="modalDdpiGuideline" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content qe-confirm-modal border-info">
            <div class="modal-header bg-dark border-info">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">🚀</span>
                    <h5 class="modal-title text-info fw-bold mb-0">1-Time DDPI Activation for Automated Real Trading</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-light">
                <p class="mb-3 text-secondary-light">
                    SEBI regulations require Demat debit authorization for selling delivery (CNC) stock holdings. In Zerodha, <strong>DDPI (Demat Debit and Pledge Instruction)</strong> allows automated algorithms to place live Sell and Target exit orders seamlessly via API.
                </p>

                <!-- Key Benefits Grid -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <div class="p-3 rounded bg-dark border border-secondary h-100 text-center">
                            <div class="fs-4 mb-1">⚡</div>
                            <h6 class="text-info fw-bold mb-1">100% Automated</h6>
                            <p class="small text-white mb-0">Orders execute instantaneously when target or stop loss triggers.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 rounded bg-dark border border-secondary h-100 text-center">
                            <div class="fs-4 mb-1">🔒</div>
                            <h6 class="text-success fw-bold mb-1">Zero Daily OTP</h6>
                            <p class="small text-white mb-0">No daily morning logins or manual verification codes required.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 rounded bg-dark border border-secondary h-100 text-center">
                            <div class="fs-4 mb-1">⏱️</div>
                            <h6 class="text-warning fw-bold mb-1">1-Time Setup</h6>
                            <p class="small text-white mb-0">Takes only 2 minutes online via Aadhaar DigiLocker eSign.</p>
                        </div>
                    </div>
                </div>

                <!-- How to Enable DDPI Step Card -->
                <div class="ddpi-activation-box p-3 mb-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fs-5">✨</span>
                        <h6 class="text-info fw-bold mb-0">How to Enable DDPI in Zerodha (3 Simple Steps)</h6>
                    </div>
                    <div class="tpin-steps-container mt-2">
                        <div class="tpin-step-card">
                            <div class="tpin-step-num">1</div>
                            <div class="tpin-step-body">
                                <h6 class="tpin-step-title">Open Zerodha Demat Console</h6>
                                <p class="tpin-step-desc">
                                    Click the button below or go to <strong>Zerodha Console > Account > Demat</strong>.
                                </p>
                            </div>
                        </div>

                        <div class="tpin-step-card">
                            <div class="tpin-step-num">2</div>
                            <div class="tpin-step-body">
                                <h6 class="tpin-step-title">Click 'Enable Demat Debit and Pledge Instruction (DDPI)'</h6>
                                <p class="tpin-step-desc">
                                    Click the blue link located below your Demat ID.
                                </p>
                            </div>
                        </div>

                        <div class="tpin-step-card">
                            <div class="tpin-step-num">3</div>
                            <div class="tpin-step-body">
                                <h6 class="tpin-step-title">Complete Aadhaar eSign on DigiLocker</h6>
                                <p class="tpin-step-desc">
                                    Enter your Aadhaar number, submit the OTP, and eSign. DDPI will be activated within 24 to 48 hours.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-dark border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="https://console.zerodha.com/account/demat" target="_blank" class="btn-ddpi-enable">
                    <span>Open Zerodha Demat Console</span> <span class="ddpi-arrow">↗</span>
                </a>
                <button type="button" class="btn btn-success fw-bold" id="btnModalConfirmDdpi" data-bs-dismiss="modal" title="Mark DDPI as verified and enabled">
                    ✅ DDPI Completed (Mark as Active)
                </button>
            </div>
        </div>
    </div>
</div>

