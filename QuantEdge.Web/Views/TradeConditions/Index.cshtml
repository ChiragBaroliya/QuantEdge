@{
    ViewData["Title"] = "Trade Conditions";
    ViewData["PageTitle"] = "Trade Conditions";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "1";
}

<link rel="stylesheet" href="~/css/trade-conditions.css" asp-append-version="true" />
<div id="tc-config" data-api-base-url="@apiBaseUrl" data-user-id="@currentUserId" hidden></div>

<div class="tc-container">
    <div class="tc-header">
        <div>
            <div class="tc-eyebrow">Trading &amp; Signals</div>
            <h2 class="tc-title">Trade Conditions</h2>
            <p class="tc-subtitle">Choose which of the 11 conditions the bot checks before it buys or short sells a stock. Conditions you switch off are skipped, and the score is rescaled to 100 from the conditions that stay on.</p>
        </div>
        <div class="tc-header-pills">
            <span class="tc-pill tc-pill-muted" id="tcStatusPill">Loading…</span>
            <span class="tc-pill tc-pill-muted" data-tooltip="Market Gate Mode from Swing settings. In REGIME mode the BUY side's condition 1 is decided by the market regime, not by this page.">
                Gate mode: <strong id="tcGateLabel">-</strong>
            </span>
        </div>
    </div>

    <div class="tc-toolbar">
        <div class="tc-segment" role="tablist" aria-label="Page section" id="tcViewTabs">
            <button type="button" class="tc-seg-btn active" data-view="conditions" role="tab" aria-selected="true">Which conditions</button>
            <button type="button" class="tc-seg-btn" data-view="rules" role="tab" aria-selected="false">Rule numbers</button>
        </div>
    </div>

    <div id="tcViewRules" hidden>
        <div class="tc-alert tc-alert-info" id="srLoading">Loading rule numbers…</div>
        <div id="srForm" class="sr-form" hidden>
            <section class="tc-card sr-top">
                <div class="tc-card-head">
                    <div>
                        <h3>Market gate and score</h3>
                        <p>One set of numbers drives Auto Paper, Auto Real, the dashboards and new backtests. BUY and SHORT share them unless a field says otherwise.</p>
                    </div>
                    <span class="tc-dirty" id="srDirty" hidden></span>
                </div>
                <div class="sr-grid">
                    <div class="sr-field sr-field-wide">
                        <label for="srGate">Market gate for new BUYs</label>
                        <select id="srGate" class="tc-input sr-select">
                            <option value="NIFTY_FILTER">NIFTY filter (no BUY while NIFTY fails)</option>
                            <option value="REGIME">Market regime (strong stocks allowed in a falling market)</option>
                        </select>
                        <p class="tc-hint" id="srGateHint"></p>
                    </div>
                    <div class="sr-field">
                        <label for="srBuy">BUY / SHORT signal score</label>
                        <div class="sr-input-row"><input type="number" id="srBuy" class="tc-input" min="0" max="100" step="1" /></div>
                    </div>
                    <div class="sr-field">
                        <label for="srWatch">WATCH score</label>
                        <div class="sr-input-row"><input type="number" id="srWatch" class="tc-input" min="0" max="100" step="1" /></div>
                    </div>
                    <div class="sr-field">
                        <span class="sr-label">Scoring points total</span>
                        <strong class="sr-points" id="srPointsText">100 / 100</strong>
                        <p class="tc-hint" id="srPointsHint"></p>
                    </div>
                </div>
            </section>

            <div id="srGroups" class="sr-groups"></div>

            <section class="tc-card">
                <div class="tc-card-head">
                    <div>
                        <h3>Market regime</h3>
                        <p>The terms for a BUY in each regime when the market gate is set to Market regime.</p>
                    </div>
                    <span class="tc-pill tc-pill-muted" id="srPolicyState"></span>
                </div>
                <div class="sr-table-wrap">
                    <table class="sr-table">
                        <thead>
                            <tr><th scope="col">Regime</th><th scope="col">Min score</th><th scope="col">Must beat NIFTY</th><th scope="col">Max positions</th><th scope="col">Risk per trade %</th><th scope="col">Max exposure %</th><th scope="col">Short min score</th><th scope="col">Short max positions</th></tr>
                        </thead>
                        <tbody id="srPolicyBody"></tbody>
                    </table>
                </div>
                <p class="tc-hint">Applies to new BUYs on both bots. Max exposure is the most of the bot's capital that may be in open positions: an order is made smaller to fit, or skipped if nothing fits. If the regime reading misses more than one session, the bots take no new BUYs in this mode until it is computed again. The two Short columns are the mirror gate for SHORT entries - used in backtests today when the market gate above is set to Market regime; they aren't yet consulted by live/paper SHORT trading.</p>
            </section>

            <section class="tc-card sr-save">
                <div id="srAlerts" class="tc-alerts" aria-live="polite"></div>
                <label class="tc-risk">
                    <input type="checkbox" id="srConfirm" />
                    <span>I understand these numbers also apply to the <strong>real-money</strong> Auto Real bot, for every user, within 5 minutes of saving.</span>
                </label>
                <div class="sr-save-row">
                    <button type="button" class="tc-btn tc-btn-ghost" id="srResetAll">Reset all to original</button>
                    <button type="button" class="tc-btn tc-btn-primary" id="srSave" disabled>Save rule numbers</button>
                </div>
                <p class="tc-hint sr-save-hint" id="srSaveHint"></p>
                <p class="tc-save-status" id="srSaveStatus" role="status" aria-live="polite" hidden></p>
            </section>
        </div>
    </div>

    <div id="tcViewConditions" class="tc-view">
    <div class="tc-toolbar">
        <div class="tc-segment" role="tablist" aria-label="Trading mode" id="tcModeTabs">
            <button type="button" class="tc-seg-btn active" data-mode="AUTO_PAPER" role="tab" aria-selected="true">Auto Paper</button>
            <button type="button" class="tc-seg-btn" data-mode="AUTO_REAL" role="tab" aria-selected="false">Auto Real <span class="tc-live">LIVE</span></button>
        </div>
        <div class="tc-segment" role="tablist" aria-label="Side" id="tcSideTabs">
            <button type="button" class="tc-seg-btn active" data-side="BUY" role="tab" aria-selected="true">BUY</button>
            <button type="button" class="tc-seg-btn" data-side="SHORT" role="tab" aria-selected="false">SHORT</button>
        </div>
        <span class="tc-dirty" id="tcDirty" hidden></span>
    </div>

    <div class="tc-layout">
        <div class="tc-main">
            <section class="tc-card">
                <div class="tc-card-head">
                    <div>
                        <h3>Hard filters</h3>
                        <p>Pass / fail gates. If any filter that is ON fails, the stock is rejected, whatever its score.</p>
                    </div>
                    <div class="tc-bulk">
                        <button type="button" class="tc-link-btn" data-bulk="hard" data-on="true">All on</button>
                        <button type="button" class="tc-link-btn" data-bulk="hard" data-on="false">All off</button>
                    </div>
                </div>
                <div class="tc-list" id="tcHardList"></div>
            </section>

            <section class="tc-card">
                <div class="tc-card-head">
                    <div>
                        <h3>Scoring conditions</h3>
                        <p id="tcScoreIntro">Each adds points to the score. A score of 70 or more is a signal; 50–69 is WATCH.</p>
                    </div>
                    <div class="tc-bulk">
                        <button type="button" class="tc-link-btn" data-bulk="score" data-on="true">All on</button>
                        <button type="button" class="tc-link-btn" data-bulk="score" data-on="false">All off</button>
                    </div>
                </div>
                <div class="tc-list" id="tcScoreList"></div>
            </section>
        </div>

        <aside class="tc-side">
            <section class="tc-card tc-summary">
                <h3>Summary</h3>
                <div class="tc-stat-grid">
                    <div class="tc-stat"><span class="tc-stat-label">Conditions on</span><span class="tc-stat-value" id="tcEnabledCount">11 / 11</span></div>
                    <div class="tc-stat"><span class="tc-stat-label">Hard filters on</span><span class="tc-stat-value" id="tcHardCount">3 / 3</span></div>
                </div>

                <div class="tc-points">
                    <div class="tc-points-head"><span>Scoring points in use</span><strong id="tcPointsText">100 / 100</strong></div>
                    <div class="tc-bar"><div class="tc-bar-fill" id="tcPointsBar"></div></div>
                    <p class="tc-hint" id="tcRescaleText">Score = points earned out of 100.</p>
                </div>

                <div class="tc-field">
                    <label for="tcMinMatch">Min conditions to match</label>
                    <div class="tc-min-row">
                        <input type="number" class="tc-input" id="tcMinMatch" min="1" max="11" value="10" />
                        <span class="tc-hint" id="tcMinMatchOf">of 11 on</span>
                    </div>
                    <p class="tc-hint">The bot also takes a stock with no signal if at least this many of the conditions that are ON pass.</p>
                </div>

                <div class="tc-thresholds">
                    <span class="tc-chip tc-chip-green" id="tcSignalChip">BUY ≥ 70</span>
                    <span class="tc-chip tc-chip-amber" id="tcWatchChip">WATCH ≥ 50</span>
                    <span class="tc-chip tc-chip-muted">Set in Rule numbers</span>
                </div>

                <div id="tcAlerts" class="tc-alerts" aria-live="polite"></div>

                <label class="tc-risk" id="tcRiskWrap" hidden>
                    <input type="checkbox" id="tcRiskAccept" />
                    <span>I understand that with a hard filter off, the <strong>real-money</strong> bot may buy against the trend.</span>
                </label>

                <div class="tc-actions">
                    <button type="button" class="tc-btn tc-btn-ghost" id="tcReset">Reset to default</button>
                    <button type="button" class="tc-btn tc-btn-ghost" id="tcCopySide">Copy BUY → SHORT</button>
                    <button type="button" class="tc-btn tc-btn-ghost" id="tcCopyMode">Copy to Auto Real</button>
                    <button type="button" class="tc-btn tc-btn-primary" id="tcSave">Save</button>
                </div>
                <p class="tc-save-status" id="tcSaveStatus" role="status" aria-live="polite" hidden></p>
            </section>
        </aside>
    </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trade-conditions.js" asp-append-version="true"></script>
    <script src="~/js/strategy-rules.js" asp-append-version="true"></script>
}
