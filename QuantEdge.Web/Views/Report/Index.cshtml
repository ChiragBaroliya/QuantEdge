@{
    ViewData["Title"] = "Trading Reports & Performance Analytics";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

@section Styles {
    <link rel="stylesheet" href="~/css/report.css" asp-append-version="true" />
}

<div class="report-container">

    <!-- Header & Interactive Controls Bar -->
    <div class="report-header-card">
        <div class="report-header-top">
            <div class="report-title-group">
                <div class="report-title-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                </div>
                <div>
                    <h1 class="report-title">Trading Performance & Investment Reports</h1>
                    <p class="report-subtitle">Comprehensive analytics across Daily, Weekly, Fortnightly (15D), Monthly, and Yearly horizons with database pagination.</p>
                </div>
            </div>

            <div class="report-actions">
                <!-- Period Interval Selector Pills -->
                <div class="period-pills-bar">
                    <button type="button" class="period-pill-btn active" data-period="daily">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Daily
                    </button>
                    <button type="button" class="period-pill-btn" data-period="weekly">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        Weekly
                    </button>
                    <button type="button" class="period-pill-btn" data-period="fortnightly">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 0 0 20z"></path></svg>
                        Fortnightly (15D)
                    </button>
                    <button type="button" class="period-pill-btn" data-period="monthly">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        Monthly
                    </button>
                    <button type="button" class="period-pill-btn" data-period="yearly">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                        Yearly
                    </button>
                </div>

                <button type="button" class="btn-report-action btn-export-csv" id="btnExportCsv" title="Download Excel/CSV Report">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Export CSV
                </button>
                <button type="button" class="btn-report-action btn-refresh-report" id="btnRefreshReport" title="Refresh Report Data">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                </button>
            </div>
        </div>

        <!-- Filter Controls Row -->
        <div class="report-filters-row">
            <div class="filter-controls-group">
                <label style="font-size: 13px; color: var(--text-muted, #94a3b8); font-weight: 600;">Trade Mode:</label>
                <select id="reportModeSelect" class="report-filter-select">
                    <option value="all" selected>All Trades (Real + Paper)</option>
                    <option value="real">Real Broker Trading Only</option>
                    <option value="paper">Paper Simulation Only</option>
                </select>

                @if (isAdmin)
                {
                    <label style="font-size: 13px; color: var(--text-muted, #94a3b8); font-weight: 600; margin-left: 8px;">User Scope:</label>
                    <select id="reportUserSelect" class="report-filter-select">
                        <option value="all" selected>All Users (Aggregate)</option>
                    </select>
                }
                else
                {
                    <input type="hidden" id="reportUserSelect" value="@ViewBag.CurrentUsername" />
                }
            </div>

            <div class="filter-controls-group">
                <label style="font-size: 13px; color: var(--text-muted, #94a3b8); font-weight: 600;">Date Range:</label>
                <input type="date" id="reportStartDate" class="report-date-input" />
                <span style="color: var(--text-muted, #94a3b8);">to</span>
                <input type="date" id="reportEndDate" class="report-date-input" />

                <div class="btn-group btn-group-sm ms-1">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPreset30D">30D</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPreset90D">90D</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPresetYTD">YTD</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPresetAll">All</button>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Summary Ribbon -->
    <div class="report-kpi-grid">
        <!-- 1. Total Invested Capital -->
        <div class="report-kpi-card kpi-card-invested">
            <div class="kpi-header">
                <span>Invested Capital (Turnover)</span>
                <div class="kpi-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><line x1="12" y1="18" x2="12" y2="6"></line></svg>
                </div>
            </div>
            <div>
                <div class="kpi-value-row">
                    <span id="kpiInvestedCapital" class="kpi-main-value" style="color: #38bdf8;">₹0.00</span>
                </div>
                <div class="kpi-subtext">Total executed buy volume in period</div>
            </div>
        </div>

        <!-- 2. Net Realized PnL -->
        <div class="report-kpi-card kpi-card-pnl">
            <div class="kpi-header">
                <span>Net Realized P&L</span>
                <div class="kpi-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                </div>
            </div>
            <div>
                <div class="kpi-value-row">
                    <span id="kpiNetRealizedPnl" class="kpi-main-value">₹0.00</span>
                    <span id="kpiPnlBadge" class="kpi-sub-badge positive">PROFIT</span>
                </div>
                <div class="kpi-subtext">Closed positions net profit / loss</div>
            </div>
        </div>

        <!-- 3. Return on Investment (ROI %) -->
        <div class="report-kpi-card kpi-card-roi">
            <div class="kpi-header">
                <span>Return on Capital (ROI)</span>
                <div class="kpi-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10"></path><path d="M12 20V4"></path><path d="M6 20v-6"></path></svg>
                </div>
            </div>
            <div>
                <div class="kpi-value-row">
                    <span id="kpiTotalRoi" class="kpi-main-value" style="color: #a78bfa;">0.00%</span>
                </div>
                <div class="kpi-subtext">(Net P&L / Total Invested Capital) × 100</div>
            </div>
        </div>

        <!-- 4. Win Rate % -->
        <div class="report-kpi-card kpi-card-winrate">
            <div class="kpi-header">
                <span>Win Rate & Accuracy</span>
                <div class="kpi-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 10"></polyline></svg>
                </div>
            </div>
            <div>
                <div class="kpi-value-row">
                    <span id="kpiWinRate" class="kpi-main-value" style="color: #fbbf24;">0.0%</span>
                </div>
                <div id="kpiWinLossCount" class="kpi-subtext">0 Wins • 0 Losses</div>
            </div>
        </div>

        <!-- 5. Profit Factor -->
        <div class="report-kpi-card kpi-card-factor">
            <div class="kpi-header">
                <span>Profit Factor</span>
                <div class="kpi-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </div>
            </div>
            <div>
                <div class="kpi-value-row">
                    <span id="kpiProfitFactor" class="kpi-main-value">0.00</span>
                </div>
                <div id="kpiAvgTrade" class="kpi-subtext">Avg: ₹0.00 (0.00%)</div>
            </div>
        </div>
    </div>

    <!-- Visual Analytics & Charts Section -->
    <div class="report-charts-grid">
        <!-- Cumulative PnL Curve Chart -->
        <div class="report-chart-card">
            <div class="chart-card-header">
                <h3 class="chart-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    Cumulative Equity & P&L Trajectory
                </h3>
            </div>
            <div class="chart-wrapper">
                <canvas id="chartEquityCurve"></canvas>
            </div>
        </div>

        <!-- Win/Loss Ratio -->
        <div class="report-chart-card">
            <div class="chart-card-header">
                <h3 class="chart-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 1 10 10"></path></svg>
                    Win / Loss Distribution
                </h3>
            </div>
            <div class="chart-wrapper">
                <canvas id="chartWinLoss"></canvas>
            </div>
        </div>
    </div>

    <!-- Period Capital vs Return Bar Chart -->
    <div class="report-chart-card">
        <div class="chart-card-header">
            <h3 class="chart-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                Period Invested Capital vs Realized P&L
            </h3>
        </div>
        <div class="chart-wrapper" style="max-height: 260px;">
            <canvas id="chartPeriodBar"></canvas>
        </div>
    </div>

    <!-- Periodic Breakdown Table Card with Pagination & Filters -->
    <div class="report-table-card">
        <div class="report-table-header">
            <h3 class="report-table-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                Periodic Investment & Return Breakdown
            </h3>

            <!-- Periodic Table Filters -->
            <div class="table-inline-filters">
                <select id="periodsPnlFilter" class="report-filter-select-sm">
                    <option value="all" selected>All Outcomes</option>
                    <option value="profit">Profitable Periods Only</option>
                    <option value="loss">Loss Making Periods Only</option>
                </select>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="report-table">
                <thead>
                    <tr>
                        <th style="min-width: 180px;">Period</th>
                        <th style="min-width: 80px; text-align: center;">Trades</th>
                        <th style="min-width: 140px; text-align: center;">Win / Loss</th>
                        <th style="min-width: 150px;" class="text-end">Invested (₹)</th>
                        <th style="min-width: 130px;" class="text-end">Gross Profit</th>
                        <th style="min-width: 130px;" class="text-end">Gross Loss</th>
                        <th style="min-width: 140px;" class="text-end">Net P&L (₹)</th>
                        <th style="min-width: 110px;" class="text-end">ROI (%)</th>
                        <th style="min-width: 140px;" class="text-end">Cumulative P&L</th>
                    </tr>
                </thead>
                <tbody id="tablePeriodsBody">
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Loading periodic performance data...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Periodic Table Pagination Toolbar -->
        <div class="table-pagination-footer" id="periodsPaginationContainer">
            <div class="pagination-info" id="periodsPaginationInfo">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls" id="periodsPaginationControls">
                <!-- Injected via report.js -->
            </div>
        </div>
    </div>

    <!-- Recent Individual Trade Records Card with Pagination & Filters -->
    <div class="report-table-card">
        <div class="report-table-header">
            <h3 class="report-table-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                Executed Closed Trades Log
            </h3>

            <!-- Trades Table Filters -->
            <div class="table-inline-filters">
                <div class="search-input-wrapper">
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="tradesSearchInput" class="report-search-input" placeholder="Search symbol (e.g. RELIANCE)..." />
                </div>
                <select id="tradesTypeFilter" class="report-filter-select-sm">
                    <option value="all" selected>All Trade Types</option>
                    <option value="swing">Swing</option>
                    <option value="intraday">Intraday</option>
                    <option value="auto">Auto</option>
                </select>
                <select id="tradesPnlFilter" class="report-filter-select-sm">
                    <option value="all" selected>All Outcomes</option>
                    <option value="profit">Profitable Trades</option>
                    <option value="loss">Losing Trades</option>
                </select>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="report-table">
                <thead>
                    <tr>
                        <th style="min-width: 150px;">Symbol</th>
                        <th style="min-width: 100px;">Type</th>
                        <th style="min-width: 80px; text-align: center;">Qty</th>
                        <th style="min-width: 110px;" class="text-end">Entry Price</th>
                        <th style="min-width: 110px;" class="text-end">Exit Price</th>
                        <th style="min-width: 130px;" class="text-end">Invested (₹)</th>
                        <th style="min-width: 130px;" class="text-end">P&L (₹)</th>
                        <th style="min-width: 100px;" class="text-end">Return (%)</th>
                        <th style="min-width: 160px;">Exit Reason</th>
                        <th style="min-width: 160px;">Executed Date</th>
                    </tr>
                </thead>
                <tbody id="tableRecentTradesBody">
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">Loading trade log...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Trades Table Pagination Toolbar -->
        <div class="table-pagination-footer" id="tradesPaginationContainer">
            <div class="pagination-info" id="tradesPaginationInfo">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls" id="tradesPaginationControls">
                <!-- Injected via report.js -->
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/report.js" asp-append-version="true"></script>
}
