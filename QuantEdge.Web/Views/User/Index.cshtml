@{
    ViewData["Title"] = "User Management";
    ViewData["PageTitle"] = "User Management";
}

<link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />

<input type="hidden" id="currentUserId" value="@ViewBag.CurrentUserId" />

<div class="user-mgmt-container">
    <!-- Top KPI Summary Cards -->
    <div class="kpi-grid-user">
        <div class="kpi-card-user um-total" data-tooltip="👥 **Total Users**: Total registered user accounts in the platform.">
            <div class="kpi-header-user">
                <span class="kpi-label-user">Total Users</span>
                <div class="kpi-icon-user">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
            </div>
            <div id="kpiTotalUsers" class="kpi-value-user">...</div>
            <div class="kpi-subtext-user">Registered accounts</div>
        </div>

        <div class="kpi-card-user um-admin" data-tooltip="🛡️ **Administrators**: Users with full access to administration and system settings.">
            <div class="kpi-header-user">
                <span class="kpi-label-user">Administrators</span>
                <div class="kpi-icon-user" style="color:#60a5fa;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
            </div>
            <div id="kpiAdminCount" class="kpi-value-user" style="color:#60a5fa;">...</div>
            <div class="kpi-subtext-user">Full admin privileges</div>
        </div>

        <div class="kpi-card-user um-user" data-tooltip="👤 **Standard Users**: Regular trading dashboard users.">
            <div class="kpi-header-user">
                <span class="kpi-label-user">Standard Users</span>
                <div class="kpi-icon-user" style="color:#34d399;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 8v4l3 3"></path>
                    </svg>
                </div>
            </div>
            <div id="kpiUserCount" class="kpi-value-user" style="color:#34d399;">...</div>
            <div class="kpi-subtext-user">Standard access level</div>
        </div>
    </div>

    <!-- Filter & Control Bar -->
    <div class="filter-bar-user">
        <div class="filter-group-user">
            <select id="roleFilterUser" class="filter-select-user" data-tooltip="📌 **Filter Role**: Filter list by Admin or User role.">
                <option value="all">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="User">User</option>
            </select>

            <div class="search-wrapper-user" data-tooltip="🔎 **Search User**: Search by Full Name, Username, Email, or Mobile No.">
                <svg class="search-icon-user" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="searchInputUser" class="search-input-user" placeholder="Search name, username, email..." />
            </div>
        </div>

        <div class="filter-group-user">
            <button type="button" id="btnRefreshUsers" class="btn-refresh-user" data-tooltip="🔄 **Refresh**: Reload user list.">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Refresh
            </button>

            <span style="font-size:12px;color:var(--text-muted);font-weight:600;margin-left:4px;">Per page:</span>
            <select id="pageSizeUser" class="filter-select-user" style="min-width:75px;" data-tooltip="📄 **Page Size**: Rows per page.">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>

            <button type="button" class="btn-primary-user ms-2" data-bs-toggle="modal" data-bs-target="#modalCreateUser" data-tooltip="➕ **Add User**: Provision a new system user.">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add User
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="table-card-user">
        <div style="overflow-x: auto;">
            <table class="user-table">
                <thead>
                    <tr>
                        <th style="min-width: 220px;" data-tooltip="👤 **User Identity**: Avatar, Full Name, and Handle.">User Identity</th>
                        <th style="min-width: 140px;" data-tooltip="🔑 **Username**: System login identifier.">Username</th>
                        <th style="min-width: 180px;" data-tooltip="✉️ **Email**: Registered email address.">Email</th>
                        <th style="min-width: 130px;" data-tooltip="📱 **Mobile**: Contact phone number.">Mobile No</th>
                        <th style="min-width: 110px;" data-tooltip="🛡️ **Role**: Access role level (Admin vs User).">Role</th>
                        <th style="min-width: 160px;" data-tooltip="📅 **Registered Date**: Account creation timestamp.">Registered</th>
                        <th style="min-width: 130px; text-align: center;" data-tooltip="🛠️ **Actions**: Edit details, reset password, or delete user.">Actions</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #94a3b8;">
                            Loading user directory...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls Bar -->
        <div class="pagination-wrapper-user">
            <div id="paginationInfoUser" class="pagination-info-user">
                Showing 0 to 0 of 0 users
            </div>
            <div id="paginationControlsUser" class="pagination-controls-user">
                <!-- Dynamic page buttons rendered by user-management.js -->
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create New User -->
<div class="modal fade" id="modalCreateUser" tabindex="-1" aria-labelledby="modalCreateUserLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark">
                <h5 class="modal-title modal-title-dark" id="modalCreateUserLabel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="17" y1="11" x2="23" y2="11"></line></svg>
                    Create New User Account
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCreateUser">
                <div class="modal-body modal-body-dark">
                    <div class="mb-3">
                        <label for="createFullName" class="form-label-dark">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="createFullName" class="form-control form-control-dark" placeholder="e.g. Rahul Sharma" required />
                    </div>

                    <div class="mb-3">
                        <label for="createUsername" class="form-label-dark">Username <span class="text-danger">*</span></label>
                        <input type="text" id="createUsername" class="form-control form-control-dark" placeholder="e.g. rsharma" required minlength="3" pattern="^[a-zA-Z0-9_\-\.]+$" title="Only letters, numbers, dots, hyphens, and underscores permitted." />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="createEmail" class="form-label-dark">Email (Optional)</label>
                            <input type="email" id="createEmail" class="form-control form-control-dark" placeholder="e.g. rahul@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label for="createMobileNo" class="form-label-dark">Mobile No (Optional)</label>
                            <input type="text" id="createMobileNo" class="form-control form-control-dark" placeholder="e.g. 9876543210" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="createPassword" class="form-label-dark">Password <span class="text-danger">*</span></label>
                            <input type="password" id="createPassword" class="form-control form-control-dark" placeholder="Minimum 6 characters" required minlength="6" />
                        </div>
                        <div class="col-md-6">
                            <label for="createConfirmPassword" class="form-label-dark">Confirm Password <span class="text-danger">*</span></label>
                            <input type="password" id="createConfirmPassword" class="form-control form-control-dark" placeholder="Repeat password" required minlength="6" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="createRole" class="form-label-dark">Role Level <span class="text-danger">*</span></label>
                        <select id="createRole" class="form-select form-select-dark" required>
                            <option value="User" selected>User (Standard Access)</option>
                            <option value="Admin">Admin (Full Administrator)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer modal-footer-dark">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-user">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Existing User -->
<div class="modal fade" id="modalEditUser" tabindex="-1" aria-labelledby="modalEditUserLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark">
                <h5 class="modal-title modal-title-dark" id="modalEditUserLabel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    Edit User Profile
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditUser">
                <input type="hidden" id="editUserId" />
                <div class="modal-body modal-body-dark">
                    <div class="mb-3">
                        <label for="editUsername" class="form-label-dark">Username (Immutable)</label>
                        <input type="text" id="editUsername" class="form-control form-control-dark" readonly style="opacity:0.7;" />
                    </div>

                    <div class="mb-3">
                        <label for="editFullName" class="form-label-dark">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="editFullName" class="form-control form-control-dark" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="editEmail" class="form-label-dark">Email</label>
                            <input type="email" id="editEmail" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-6">
                            <label for="editMobileNo" class="form-label-dark">Mobile No</label>
                            <input type="text" id="editMobileNo" class="form-control form-control-dark" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editRole" class="form-label-dark">Role Level <span class="text-danger">*</span></label>
                        <select id="editRole" class="form-select form-select-dark" required>
                            <option value="User">User (Standard Access)</option>
                            <option value="Admin">Admin (Full Administrator)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer modal-footer-dark">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-user">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reset User Password -->
<div class="modal fade" id="modalResetPassword" tabindex="-1" aria-labelledby="modalResetPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark">
                <h5 class="modal-title modal-title-dark" id="modalResetPasswordLabel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    Reset Password
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formResetPassword">
                <input type="hidden" id="resetUserId" />
                <div class="modal-body modal-body-dark">
                    <p class="text-muted small mb-3">
                        Resetting password for user account: <strong id="resetUsernameText" class="text-info"></strong>
                    </p>

                    <div class="mb-3">
                        <label for="resetNewPassword" class="form-label-dark">New Password <span class="text-danger">*</span></label>
                        <input type="password" id="resetNewPassword" class="form-control form-control-dark" placeholder="Minimum 6 characters" required minlength="6" />
                    </div>

                    <div class="mb-3">
                        <label for="resetConfirmPassword" class="form-label-dark">Confirm New Password <span class="text-danger">*</span></label>
                        <input type="password" id="resetConfirmPassword" class="form-control form-control-dark" placeholder="Repeat new password" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer modal-footer-dark">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-user">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/user-management.js" asp-append-version="true"></script>
}
