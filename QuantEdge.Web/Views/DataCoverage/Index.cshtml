@{
    ViewData["Title"] = "Data Coverage Manager";
    ViewData["PageTitle"] = "Data Coverage Manager";
}

<link rel="stylesheet" href="~/css/datacoverage.css" asp-append-version="true" />

<div class="coverage-container" data-api-base-url="@ViewBag.ApiBaseUrl">
    <!-- Top KPI Summary Cards -->
    <div class="kpi-grid">
        <div class="kpi-card dc-total" data-tooltip="📊 **Total Stocks**: Total registered stocks in database.">
            <div class="kpi-header">
                <span class="kpi-label">Total Stocks</span>
                <div class="kpi-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"></path></svg></div>
            </div>
            <div id="kpiTotalStocks" class="kpi-value">...</div>
            <div class="kpi-subtext">All instruments</div>
        </div>
        <div class="kpi-card dc-active" data-tooltip="🟢 **Active Stocks**: Stocks actively tracked for live signals.">
            <div class="kpi-header">
                <span class="kpi-label">Active</span>
                <div class="kpi-icon" style="color:var(--accent-green)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="20 6 9 17 4 12"></polyline></svg></div>
            </div>
            <div id="kpiActiveCount" class="kpi-value active-color">...</div>
            <div class="kpi-subtext">Being tracked</div>
        </div>
        <div class="kpi-card dc-inactive" data-tooltip="🔴 **Inactive Stocks**: Stocks temporarily disabled from monitoring.">
            <div class="kpi-header">
                <span class="kpi-label">Inactive</span>
                <div class="kpi-icon" style="color:var(--accent-red)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg></div>
            </div>
            <div id="kpiInactiveCount" class="kpi-value inactive-color">...</div>
            <div class="kpi-subtext">Not monitored</div>
        </div>
        <div class="kpi-card dc-missing" data-tooltip="⚠️ **History Missing**: Stocks with missing historical candlestick data.">
            <div class="kpi-header">
                <span class="kpi-label">History Missing</span>
                <div class="kpi-icon" style="color:var(--accent-amber)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
            </div>
            <div id="kpiMissingCount" class="kpi-value warning-color">...</div>
            <div class="kpi-subtext">Need backfill</div>
        </div>
    </div>

    <!-- Filter & Control Bar -->
    <div class="filter-bar">
        <div class="filter-group">
            <select id="statusFilter" class="filter-select" data-tooltip="📌 **Status Filter**: Show Active or Inactive stocks.">
                <option value="all">All status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>

            <select id="historyFilter" class="filter-select" data-tooltip="🔍 **History & Date Filter**: Filter stocks by creation date, data availability or missing gaps.">
                <option value="all">All History & Dates</option>
                <optgroup label="📅 Creation Date">
                    <option value="today_created">Today Created</option>
                </optgroup>
                <optgroup label="⚠️ Missing History">
                    <option value="missing">Any History Missing</option>
                    <option value="1m_missing">1m Missing</option>
                    <option value="5m_missing">5m Missing</option>
                    <option value="15m_missing">15m Missing</option>
                    <option value="60m_missing">60m Missing</option>
                    <option value="1d_missing">1D Missing</option>
                </optgroup>
                <optgroup label="✅ Available History">
                    <option value="has_1m">Has 1m History</option>
                    <option value="has_5m">Has 5m History</option>
                    <option value="has_15m">Has 15m History</option>
                    <option value="has_60m">Has 60m History</option>
                    <option value="has_1d">Has 1D History</option>
                </optgroup>
            </select>

            <div class="search-input-wrapper" data-tooltip="🔎 **Search Stock**: Enter company name or trading symbol.">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="searchInput" class="search-input" placeholder="Search symbol or name..." />
            </div>
        </div>

        <div class="filter-group">
            <button type="button" id="btnRefreshCoverage" class="btn-refresh-coverage" data-tooltip="🔄 **Refresh**: Refresh data coverage list.">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Refresh
            </button>
            <button type="button" id="btnExportExcel" class="btn-export-excel" data-tooltip="📥 **Export Excel**: Export filtered stock records to Excel spreadsheet (.xlsx).">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Export Excel
            </button>
            <span style="font-size:12px;color:var(--text-muted);font-weight:600;margin-left:8px;">Per page:</span>
            <select id="pageSizeSelect" class="filter-select" style="min-width:80px;" data-tooltip="📄 **Page Size**: Number of rows per page.">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="table-card">
        <div style="overflow-x: auto;">
            <table class="coverage-table">
                <thead>
                    <tr>
                        <th style="min-width: 140px;" data-tooltip="📌 **Symbol & Exchange**: NSE/BSE trading code.">Symbol & Exchange</th>
                        <th style="min-width: 180px;" data-tooltip="🏢 **Company Name**: Registered company name.">Company Name</th>
                        <th style="min-width: 220px;" data-tooltip="⏱️ **Timeframe Flags**: 1m, 5m, 15m, 60m, and 1d data status.">Timeframe History Flags</th>
                        <th style="min-width: 260px;" data-tooltip="📊 **History Status**: Start date, last date, and total candle records.">History Status</th>
                        <th style="min-width: 130px;" data-tooltip="⏰ **Last Candle Sync**: Most recent candle download timestamp.">Last Candle Sync</th>
                        <th style="min-width: 120px;" data-tooltip="🟢 **Tracking Status**: Active or Inactive.">Status</th>
                        <th style="min-width: 160px; text-align: center;" data-tooltip="🛠️ **Actions**: Download missing candles or view details.">Actions</th>
                    </tr>
                </thead>
                <tbody id="coverageTableBody">
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #94a3b8;">
                            Loading stock data coverage...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls Bar -->
        <div class="pagination-wrapper">
            <div id="paginationInfo" class="pagination-info">
                Showing 0 to 0 of 0 stocks
            </div>
            <div id="paginationControls" class="pagination-controls">
                <!-- Page buttons rendered dynamically by datacoverage.js -->
            </div>
        </div>
    </div>

    <!-- Extended Stock Specification Modal Overlay -->
    <div id="stockDetailModal" class="modal-backdrop-custom" style="display: none;">
        <div class="modal-dialog-custom">
            <div class="modal-header-custom">
                <div class="modal-title-custom">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--theme-accent, #4f9cf9)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span id="modalSymbol" class="modal-symbol-title">...</span>
                            <span id="modalStatusBadge">...</span>
                            <span id="modalExchangeBadge" class="modal-badge-exchange">NSE</span>
                        </div>
                        <p class="modal-subtitle-text">Stock Specification & Data Coverage Overview</p>
                    </div>
                </div>
                <button type="button" id="btnCloseStockModal" class="modal-close-btn" title="Close Popup (ESC)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body-custom">
                <!-- Section 1: Instrument Profile Card -->
                <div class="modal-section-card">
                    <div class="modal-section-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Instrument Specifications & Profile
                    </div>
                    <div class="modal-info-grid">
                        <div class="modal-info-item">
                            <span class="modal-info-label">Company Name</span>
                            <span id="modalCompanyName" class="modal-info-val">...</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Symbol Name</span>
                            <span id="modalSymbolName" class="modal-info-val monospace">...</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Instrument Token</span>
                            <span id="modalInstrumentToken" class="modal-info-val monospace">...</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Exchange / Segment</span>
                            <span id="modalExchangeSegment" class="modal-info-val">...</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Instrument Type</span>
                            <span id="modalInstrumentType" class="modal-info-val">EQ</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Last Traded Price (LTP)</span>
                            <span id="modalLastPrice" class="modal-info-val text-success">...</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Lot Size</span>
                            <span id="modalLotSize" class="modal-info-val">1</span>
                        </div>
                        <div class="modal-info-item">
                            <span class="modal-info-label">Tick Size</span>
                            <span id="modalTickSize" class="modal-info-val">₹0.05</span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Data Coverage & Last Candle Date Card -->
                <div class="modal-section-card">
                    <div class="modal-section-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        History Coverage & Candle Status
                    </div>
                    <div class="modal-info-grid">
                        <div class="modal-info-item" style="grid-column: span 2;">
                            <span class="modal-info-label">Last Candle Date / Time</span>
                            <span id="modalLastCandleDate" class="modal-info-val text-accent">No data</span>
                        </div>
                    </div>
                    <div style="margin-top: 14px;">
                        <span class="modal-info-label" style="display:block; margin-bottom: 8px;">Timeframe Coverage Badges</span>
                        <div id="modalTfBadges" class="modal-tf-badges-row">
                            <!-- Populated dynamically by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" id="btnModalManageHistory" class="btn-modal-action secondary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Manage History
                </button>
                <button type="button" id="btnModalCloseFooter" class="btn-modal-action primary">
                    Close
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/datacoverage.js" asp-append-version="true"></script>
}
