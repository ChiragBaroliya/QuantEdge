@{
    ViewData["Title"] = "Manual Paper Trading";
}

<div class="paper-workspace-container">
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-md-center align-items-start flex-column flex-md-row mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-light mb-1 d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-primary bg-opacity-25 text-primary p-2 rounded-3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                </span>
                Manual Paper Trading
            </h2>
            <p class="paper-subtitle mb-0">Simulate trades with virtual capital (₹1,00,000) by placing your own orders at the latest stored market price (1-minute candles).</p>
        </div>
        <div class="paper-header-actions d-flex align-items-center gap-2 flex-wrap">
            <span id="tradingModeBadge" class="badge bg-primary" style="font-size: 0.75rem;">🧪 MANUAL · PAPER</span>
            <div class="paper-switch-box d-flex align-items-center gap-2" title="Manual Paper Trading ON / OFF (manual_paper_trade_settings)">
                <input class="form-check-input" type="checkbox" id="manualTradeToggle" checked>
                <label class="form-check-label text-light fw-medium mb-0 small" for="manualTradeToggle" style="cursor:pointer;">
                    Manual Trading
                </label>
                <span id="manualTradeStatusBadge" class="badge bg-success" style="font-size: 0.7rem;">ON</span>
            </div>
            <button id="btnOpenManualSettings" type="button" class="btn btn-outline-primary btn-sm px-3 py-2 rounded-3 d-flex align-items-center gap-1 shadow-sm" title="Manual Paper Trading limits & exit rules">
                ⚙️ Settings
            </button>
            <button id="resetAccountBtn" class="btn btn-outline-danger btn-sm px-3 py-2 rounded-3 d-flex align-items-center gap-1 shadow-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6"></path>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                Reset Capital
            </button>
        </div>
    </div>

    <!-- Manual Paper Trading Stat Cards (fn_get_manual_paper_dashboard - Manual trades only) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Manual Capital (Manual Trading settings) + Manual Realized P&L + Manual Unrealized P&L.">
                <span class="stat-card-title">Manual Equity</span>
                <h4 id="statTotalEquity" class="fw-bold text-light mb-0 mt-1">₹0.00</h4>
                <small id="statManualCapital" class="stat-card-subtext">Capital: ₹0.00</small>
                <div class="progress mt-2" style="height: 4px; background: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Manual Trading cash: Manual Capital + Manual Realized P&amp;L - money in open manual positions. Every manual BUY is checked against this (separate from Auto Paper Trading).">
                <span class="stat-card-title">Available Margin</span>
                <h4 id="statAvailableMargin" class="fw-bold text-info mb-0 mt-1">₹0.00</h4>
                <small id="statUsedMargin" class="stat-card-subtext text-warning fw-semibold mt-1 d-block" title="Money committed to OPEN manual paper positions.">Manual Used Margin: ₹0.00</small>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Live profit or loss across OPEN manual paper positions.">
                <span class="stat-card-title">Unrealized P&L</span>
                <h4 id="statUnrealizedPnl" class="fw-bold text-light mb-0 mt-1">₹0.00</h4>
                <small id="statOpenPositions" class="stat-card-subtext">0 Open Manual Positions</small>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Booked profit or loss from closed manual paper trades.">
                <span class="stat-card-title">Realized P&L</span>
                <h4 id="statRealizedPnl" class="fw-bold text-light mb-0 mt-1">₹0.00</h4>
                <small id="statRealizedSub" class="stat-card-subtext">Today: ₹0.00 · Win Rate: 0%</small>
            </div>
        </div>
    </div>

    <!-- Main Content Area: Order Ticket + Positions & Orders -->
    <div class="row g-4">
        <!-- Order Placement Ticket (Left Column) -->
        <div class="col-xl-4 col-lg-5 col-12">
            <div class="card paper-card p-4">
                <h5 class="fw-bold text-light mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 border-bottom border-secondary border-opacity-25 pb-2">
                    <span>🎯 Order Ticket</span>
                    <span id="liveLtpBadge" class="badge bg-secondary bg-opacity-25 text-info font-monospace" title="Latest stored price: last 1-minute candle close in the database (no live Zerodha call)">LTP: --</span>
                </h5>

                <form id="paperOrderForm" novalidate>
                    <!-- Symbol Selection -->
                    <div class="mb-3">
                        <label class="paper-label" for="orderSymbol" title="Select the stock or index symbol you want to trade.">Stock / Index Symbol</label>
                        <select id="orderSymbol" class="form-select paper-input" title="Select stock symbol">
                            <option value="" disabled selected>Loading Active Stocks...</option>
                        </select>
                    </div>

                    <!-- Side: BUY (long - profit when price rises) or SHORT SELL (sell first, buy back later - profit when price falls). Market orders only. -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="paper-label mb-0">Side</span>
                            <span class="paper-label mb-0">Order Type: <strong class="text-light">Market</strong></span>
                        </div>
                        <div class="btn-group w-100" role="group" aria-label="Order side">
                            <input type="radio" class="btn-check" name="orderSide" id="orderSideBuy" value="BUY" autocomplete="off" checked>
                            <label class="btn btn-outline-success fw-bold" for="orderSideBuy" title="Buy now, sell later. Profit when the price rises.">BUY (Long)</label>
                            <input type="radio" class="btn-check" name="orderSide" id="orderSideShort" value="SHORT" autocomplete="off">
                            <label class="btn btn-outline-danger fw-bold" for="orderSideShort">
                                SHORT SELL
                                <span id="shortSellInfo" class="short-info-icon ms-1" tabindex="0" role="button" aria-label="How short selling works"
                                      data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-html="true">i</span>
                            </label>
                        </div>
                    </div>

                    <!-- Quantity -->
                    <div class="mb-3">
                        <label class="paper-label" for="orderQuantity" title="Number of shares to buy (or to short sell).">Quantity</label>
                        <input type="number" id="orderQuantity" class="form-control paper-input" value="1" min="1" step="1" title="Number of shares to buy (or to short sell).">
                        <div id="quantityError" class="invalid-feedback text-danger small mt-1"></div>
                    </div>

                    <!-- Trade-wise Stop Loss % & Trailing Stop Loss % (mandatory, like Manual Real Trade) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="paper-label" for="orderSlPct" title="Stop Loss % below the executed price (above it for a short sell). Applies to this trade only.">Stop Loss (%)</label>
                            <input type="number" id="orderSlPct" class="form-control paper-input" min="0.1" max="100" step="0.1" value="3" title="Stop Loss % below the executed price (above it for a short sell). Applies to this trade only.">
                            <div id="slPctError" class="invalid-feedback text-danger small mt-1"></div>
                        </div>
                        <div class="col-6">
                            <label class="paper-label" for="orderTslPct" title="Trailing Stop Loss %. Applies to this trade only.">Trailing Stop Loss (%)</label>
                            <input type="number" id="orderTslPct" class="form-control paper-input" min="0.1" max="50" step="0.1" value="2" title="Trailing Stop Loss %. Applies to this trade only.">
                            <div id="tslPctError" class="invalid-feedback text-danger small mt-1"></div>
                        </div>
                    </div>

                    <!-- Estimates -->
                    <div class="bg-dark bg-opacity-75 p-3 rounded-3 mb-3 border border-secondary border-opacity-25 small">
                        <div class="d-flex justify-content-between"><span class="paper-label mb-0">Required Capital:</span><span id="estimatedMargin" class="fw-bold text-light">₹0.00</span></div>
                        <div class="d-flex justify-content-between"><span class="paper-label mb-0">Estimated Stop Loss Price:</span><span id="estSlPrice" class="fw-bold text-light">-</span></div>
                        <div class="d-flex justify-content-between"><span class="paper-label mb-0">Estimated Risk:</span><span id="estRisk" class="fw-bold text-light">-</span></div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="placeOrderBtn" class="btn btn-success w-100 fw-bold py-2 rounded-3 shadow">
                        📝 Place Paper Trade
                    </button>
                    <p class="text-white small mt-2 mb-0">
                        Same checks as Manual Real Trade, using the Manual Trading settings: Manual Trading switch, trading
                        window and entry delay, daily trade/loss limits, max open positions, capital, and no duplicate open
                        position. The price is re-checked when you place the trade. The position is <strong>closed manually</strong>
                        - use the Close button (Buy to Cover for a short) in Live Open Positions. Stop Loss, Trailing SL and
                        Target are shown for reference and never close it automatically. The one exception: a short is
                        intraday only and is bought back automatically at the Short Square-off Time.
                    </p>
                </form>
            </div>

            <!-- Today's Manual Paper Trade Logs (manual_paper_trade_execution_logs) -->
            <div class="card paper-card p-4 mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary border-opacity-25 pb-2">
                    <h5 class="fw-bold text-light mb-0">📜 Today's Manual Logs</h5>
                    <span id="manualTradeCountBadge" class="badge bg-secondary bg-opacity-50 text-light" title="Manual paper BUYs + short sells today / Max Trades Per Day">0 / 0 trades</span>
                </div>
                <div id="manualLogsList" class="small" style="max-height: 360px; overflow-y: auto;">
                    <div class="text-white-50">No manual trade activity today.</div>
                </div>
            </div>
        </div>

        <!-- Live Positions & Order Book (Right Column) -->
        <div class="col-xl-8 col-lg-7 col-12">
            <!-- Open Positions Section -->
            <div class="card paper-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-light mb-0">💼 Live Open Positions</h5>
                    <span id="positionsCountBadge" class="badge bg-primary rounded-pill px-3 py-2">0 Active</span>
                </div>

                <div class="paper-table-responsive">
                    <table class="table table-dark table-hover align-middle text-nowrap mb-0 paper-table" id="positionsTable">
                        <thead class="table-borderless">
                            <tr>
                                <th>SYMBOL</th>
                                <th>SIDE</th>
                                <th>QTY</th>
                                <th>AVG ENTRY</th>
                                <th>LTP</th>
                                <th>STOP LOSS</th>
                                <th>TRAILING SL</th>
                                <th class="text-success">TARGET</th>
                                <th>UNREALIZED P&L</th>
                                <th class="text-end">ACTION</th>
                            </tr>
                        </thead>
                        <tbody id="positionsTableBody">
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">No open positions. Place an order from the ticket to start paper trading.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Orders & Trade History Tabs -->
            <div class="card paper-card p-4">
                <ul class="nav nav-tabs paper-tabs mb-3" id="paperTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#ordersTabPane" type="button" role="tab">
                            Active / Pending Orders
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#historyTabPane" type="button" role="tab">
                            Execution History
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="paperTabsContent">
                    <!-- Pending Orders Tab -->
                    <div class="tab-pane fade show active" id="ordersTabPane" role="tabpanel">
                        <!-- Orders Filter Toolbar (Manual paper orders only) -->
                        <div class="p-3 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25">
                            <div class="row g-2 align-items-end">
                                <div class="col-xl-3 col-lg-3 col-md-6 col-12">
                                    <label class="paper-label text-light mb-1" for="ordersFilterSymbol">Stock Symbol</label>
                                    <select id="ordersFilterSymbol" class="form-select paper-input form-select-sm">
                                        <option value="">All Symbols</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-3 col-6">
                                    <label class="paper-label text-light mb-1" for="ordersFilterSide">Side</label>
                                    <select id="ordersFilterSide" class="form-select paper-input form-select-sm">
                                        <option value="">All Sides</option>
                                        <option value="BUY">BUY</option>
                                        <option value="SELL">SELL</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-3 col-6">
                                    <label class="paper-label text-light mb-1" for="ordersFilterStatus">Status</label>
                                    <select id="ordersFilterStatus" class="form-select paper-input form-select-sm">
                                        <option value="">All Status</option>
                                        <option value="0">Pending</option>
                                        <option value="4">Open</option>
                                        <option value="1">Filled</option>
                                        <option value="2">Cancelled</option>
                                        <option value="3">Rejected</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                                    <label class="paper-label text-light mb-1" for="ordersFilterFromDate">From Date</label>
                                    <input type="date" id="ordersFilterFromDate" class="form-control paper-input form-control-sm">
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                                    <label class="paper-label text-light mb-1" for="ordersFilterToDate">To Date</label>
                                    <input type="date" id="ordersFilterToDate" class="form-control paper-input form-control-sm">
                                </div>
                                <div class="col-xl-1 col-lg-1 col-md-12 col-12 d-flex gap-2 justify-content-end">
                                    <button type="button" id="btnFilterOrders" class="btn btn-primary btn-sm px-2 fw-bold flex-grow-1" title="Apply selected filters">🔍</button>
                                    <button type="button" id="btnResetOrdersFilter" class="btn btn-outline-secondary btn-sm px-2 fw-bold" title="Reset all filters">↺</button>
                                </div>
                            </div>
                        </div>

                        <div class="paper-table-responsive">
                            <table class="table table-dark table-hover align-middle text-nowrap mb-0 paper-table">
                                <thead>
                                    <tr>
                                        <th>TIME</th>
                                        <th>SYMBOL</th>
                                        <th>SIDE</th>
                                        <th>TYPE</th>
                                        <th>QTY</th>
                                        <th>PRICE</th>
                                        <th>STOP LOSS</th>
                                        <th class="text-success">TARGET</th>
                                        <th>STATUS</th>
                                        <th class="text-end">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody id="ordersTableBody">
                                    <tr>
                                        <td colspan="10" class="text-center text-muted py-3">No active or pending orders.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Orders Pagination Footer -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 bg-dark bg-opacity-75 border-top border-secondary border-opacity-25">
                            <span id="ordersPaginationInfo" class="text-white small fw-medium">Showing 0 of 0 orders</span>
                            <nav aria-label="Manual orders pagination">
                                <ul id="ordersPaginationUl" class="pagination pagination-sm mb-0"></ul>
                            </nav>
                        </div>
                    </div>

                    <!-- History Tab -->
                    <div class="tab-pane fade" id="historyTabPane" role="tabpanel">
                        <!-- History Filter Toolbar -->
                        <div class="p-3 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25">
                            <div class="row g-2 align-items-end">
                                <div class="col-xl-3 col-lg-3 col-md-6 col-12">
                                    <label class="paper-label text-light mb-1" for="historyFilterSymbol" title="Filter history by stock symbol">Stock Symbol ℹ️</label>
                                    <select id="historyFilterSymbol" class="form-select paper-input form-select-sm" title="Select stock symbol">
                                        <option value="">All Symbols</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-12">
                                    <label class="paper-label text-light mb-1" for="historyFilterSide" title="Filter by BUY or SELL side">Trade Side ℹ️</label>
                                    <select id="historyFilterSide" class="form-select paper-input form-select-sm" title="Select order side">
                                        <option value="">All Sides</option>
                                        <option value="BUY">BUY</option>
                                        <option value="SELL">SELL</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                                    <label class="paper-label text-light mb-1" for="historyFilterFromDate" title="Start date filter">From Date ℹ️</label>
                                    <input type="date" id="historyFilterFromDate" class="form-control paper-input form-control-sm" title="From date">
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                                    <label class="paper-label text-light mb-1" for="historyFilterToDate" title="End date filter">To Date ℹ️</label>
                                    <input type="date" id="historyFilterToDate" class="form-control paper-input form-control-sm" title="To date">
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-12 col-12 d-flex gap-2 justify-content-end">
                                    <button type="button" id="btnFilterHistory" class="btn btn-primary btn-sm px-3 fw-bold flex-grow-1" title="Apply selected filters">🔍 Filter</button>
                                    <button type="button" id="btnResetHistoryFilter" class="btn btn-outline-secondary btn-sm px-3 fw-bold" title="Reset all filters">↺ Reset</button>
                                </div>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="paper-table-responsive">
                            <table class="table table-dark table-hover align-middle text-nowrap mb-0 paper-table">
                                <thead>
                                    <tr>
                                        <th>TIME</th>
                                        <th>SYMBOL</th>
                                        <th>SIDE</th>
                                        <th>QTY</th>
                                        <th>ENTRY PRICE</th>
                                        <th>EXECUTED PRICE</th>
                                        <th>REALIZED P&L</th>
                                        <th>REMARKS</th>
                                    </tr>
                                </thead>
                                <tbody id="historyTableBody">
                                    <tr>
                                        <td colspan="8" class="text-center text-white py-3">No execution history logged.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Controls Footer -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 bg-dark bg-opacity-75 border-top border-secondary border-opacity-25">
                            <span id="historyPaginationInfo" class="text-white small fw-medium">Showing 0 of 0 trades</span>
                            <nav aria-label="Trade history pagination">
                                <ul id="historyPaginationUl" class="pagination pagination-sm mb-0">
                                    <!-- Dynamic page links rendered by JS -->
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Glassmorphism Floating Toast Container for Error / Success alerts -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;" id="toastContainer"></div>

<!-- Edit Position Levels Modal (Live Open Positions "Edit") -->
<div class="modal fade" id="editLevelsModal" tabindex="-1" aria-labelledby="editLevelsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content paper-card border border-primary border-opacity-25 text-light shadow-lg" style="background-color: #121824;">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="editLevelsModalLabel">✏️ Edit Position Levels</h5>
                    <small id="editLevelsTitle" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="editLevelsPositionId">
                <div class="d-flex justify-content-between small mb-3">
                    <span class="paper-label mb-0">Current LTP:</span>
                    <strong id="editLevelsLtp" class="text-info">-</strong>
                </div>
                <div class="row g-3">
                    <div class="col-4">
                        <label class="paper-label text-danger" for="editStopLoss">Stop Loss (₹)</label>
                        <input type="number" id="editStopLoss" class="form-control paper-input" min="0.01" step="0.05">
                    </div>
                    <div class="col-4">
                        <label class="paper-label text-warning" for="editTrailingSlPct">Trailing SL (%)</label>
                        <input type="number" id="editTrailingSlPct" class="form-control paper-input" min="0.1" max="50" step="0.1">
                    </div>
                    <div class="col-4">
                        <label class="paper-label text-success" for="editTakeProfit">Target (₹)</label>
                        <input type="number" id="editTakeProfit" class="form-control paper-input" min="0.01" step="0.05">
                    </div>
                </div>
                <div id="editLevelsPreview" class="small text-white mt-3"></div>
                <div id="editLevelsError" class="small text-danger mt-2"></div>
                <p id="editLevelsHint" class="small text-white-50 mt-3 mb-0">
                    Reference levels only - the position is sold only when you click Close.
                </p>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveLevels" class="btn btn-primary rounded-3 px-4 fw-bold shadow">💾 Save Levels</button>
            </div>
        </div>
    </div>
</div>

<!-- Manual Paper Trading Settings Modal (manual_paper_trade_settings) -->
<div class="modal fade" id="manualSettingsModal" tabindex="-1" aria-labelledby="manualSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content paper-card border border-primary border-opacity-25 text-light shadow-lg" style="background-color: #121824;">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold" id="manualSettingsModalLabel">⚙️ Manual Paper Trading Settings</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-white small mb-3">These settings apply to Manual Trading only. Auto Paper Trading keeps its own settings.</p>
                <form id="manualSettingsForm" class="row g-3">
                    <div class="col-12"><span class="paper-label text-info">Order Ticket Defaults</span></div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msStopLossPct">Default Stop Loss (%)</label>
                        <input type="number" id="msStopLossPct" class="form-control paper-input" min="0.1" max="100" step="0.1">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msTrailingSlPct">Default Trailing SL (%)</label>
                        <input type="number" id="msTrailingSlPct" class="form-control paper-input" min="0.1" max="50" step="0.1">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msFixedAmountPerTrade">Default Amount / Trade (₹)</label>
                        <input type="number" id="msFixedAmountPerTrade" class="form-control paper-input" min="100" step="100" title="Pre-fills Quantity as Amount ÷ LTP">
                    </div>

                    <div class="col-12"><span class="paper-label text-info">Limits</span></div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msMaxTradesPerDay">Max Trades Per Day</label>
                        <input type="number" id="msMaxTradesPerDay" class="form-control paper-input" min="1" max="50" step="1">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msAvailableCapital">Capital for Loss Limit (₹)</label>
                        <input type="number" id="msAvailableCapital" class="form-control paper-input" min="100" step="1000" title="Daily loss limit defaults to 10% of this when left blank">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msMaxDailyLossLimit">Daily Max Loss (₹)</label>
                        <input type="number" id="msMaxDailyLossLimit" class="form-control paper-input" min="10" step="100" placeholder="Blank = 10% of capital">
                    </div>

                    <div class="col-12"><span class="paper-label text-info">Trading Window</span></div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msTradingWindowStart">Window Start (HH:mm)</label>
                        <input type="text" id="msTradingWindowStart" class="form-control paper-input" placeholder="09:15">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msTradingWindowEnd">Window End (HH:mm)</label>
                        <input type="text" id="msTradingWindowEnd" class="form-control paper-input" placeholder="15:30">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msEntryDelayMinutes">Entry Delay (min)</label>
                        <input type="number" id="msEntryDelayMinutes" class="form-control paper-input" min="0" max="120" step="1">
                    </div>

                    <div class="col-12"><span class="paper-label text-info">Reference Levels</span> <small class="text-white-50">- used to calculate the Target / Stop Loss shown on a position; positions are never sold automatically</small></div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msExitMode">Exit Mode</label>
                        <select id="msExitMode" class="form-select paper-input">
                            <option value="SWING_CLOSE">SWING_CLOSE (closing basis)</option>
                            <option value="INTRADAY">INTRADAY (tick basis)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msCloseCheckTime">Close Check Time (HH:mm)</label>
                        <input type="text" id="msCloseCheckTime" class="form-control paper-input" placeholder="15:15">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msMaxDurationDays">Max Days Hold</label>
                        <input type="number" id="msMaxDurationDays" class="form-control paper-input" min="1" max="365" step="1">
                    </div>
                    <div class="col-md-3">
                        <label class="paper-label" for="msProfitTargetPct">Profit Target (%)</label>
                        <input type="number" id="msProfitTargetPct" class="form-control paper-input" min="0.1" max="100" step="0.1">
                    </div>
                    <div class="col-md-3">
                        <label class="paper-label" for="msStopLossAtrMult">SL ATR ×</label>
                        <input type="number" id="msStopLossAtrMult" class="form-control paper-input" min="0.5" max="5" step="0.1">
                    </div>
                    <div class="col-md-3">
                        <label class="paper-label" for="msTrailAtrMult">Trail ATR ×</label>
                        <input type="number" id="msTrailAtrMult" class="form-control paper-input" min="0.5" max="10" step="0.1">
                    </div>
                    <div class="col-md-3">
                        <label class="paper-label" for="msTargetAtrMult">Target ATR ×</label>
                        <input type="number" id="msTargetAtrMult" class="form-control paper-input" min="0.5" max="20" step="0.1">
                    </div>

                    <div class="col-12"><span class="paper-label text-info">Short Selling (Intraday Only)</span> <small class="text-white-50">- a short's Target uses Profit Target % below the entry; its Stop Loss is SL % above it</small></div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msShortEntryCutoff">No New Shorts After (HH:mm)</label>
                        <input type="text" id="msShortEntryCutoff" class="form-control paper-input" placeholder="15:00" title="Short sells are rejected at or after this IST time">
                    </div>
                    <div class="col-md-4">
                        <label class="paper-label" for="msShortSquareOffTime">Auto Square-off Time (HH:mm)</label>
                        <input type="text" id="msShortSquareOffTime" class="form-control paper-input" placeholder="15:15" title="Every open short is bought back automatically at this IST time">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveManualSettings" class="btn btn-primary rounded-3 px-4 fw-bold shadow">💾 Save Settings</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.API_BASE_URL = "@ViewBag.ApiBaseUrl";
    </script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/paperTrading.js" asp-append-version="true"></script>
}
