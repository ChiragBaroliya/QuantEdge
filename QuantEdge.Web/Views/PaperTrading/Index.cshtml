@{
    ViewData["Title"] = "Paper Trading Dashboard";
}

<div class="paper-workspace-container">
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-md-center align-items-start flex-column flex-md-row mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-light mb-1 d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-primary bg-opacity-25 text-primary p-2 rounded-3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                </span>
                Paper Trading Workspace
            </h2>
            <p class="paper-subtitle mb-0">Simulate trades with virtual capital (₹1,00,000) using live WebSocket prices and AI signals.</p>
        </div>
        <div class="paper-header-actions d-flex align-items-center gap-2 flex-wrap">
            <div class="paper-switch-box d-flex align-items-center gap-2">
                <input class="form-check-input" type="checkbox" id="autoTradeToggle">
                <label class="form-check-label text-light fw-medium mb-0 small" for="autoTradeToggle" style="cursor:pointer;">
                    ⚡ Auto-Trade AI Signals
                </label>
                <span id="tradingModeBadge" class="badge bg-primary ms-1" style="font-size: 0.75rem;">PAPER</span>
            </div>
            <button id="btnOpenAutoTradeSettings" class="btn btn-outline-primary btn-sm px-3 py-2 rounded-3 d-flex align-items-center gap-1 shadow-sm" title="Configure Auto-Trade Strategy & Risk Rules">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                ⚙️ Settings
            </button>
            <button id="resetAccountBtn" class="btn btn-outline-danger btn-sm px-3 py-2 rounded-3 d-flex align-items-center gap-1 shadow-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6"></path>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                Reset Capital
            </button>
        </div>
    </div>

    <!-- Account Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Overall account portfolio value: Current Cash Balance + Live Unrealized P&L.">
                <span class="stat-card-title">Total Account Equity</span>
                <h4 id="statTotalEquity" class="fw-bold text-light mb-0 mt-1">₹1,00,000.00</h4>
                <div class="progress mt-2" style="height: 4px; background: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Cash balance remaining to place new manual or auto paper orders.">
                <span class="stat-card-title">Available Margin</span>
                <h4 id="statAvailableMargin" class="fw-bold text-info mb-0 mt-1">₹1,00,000.00</h4>
                <small id="statUsedMargin" class="stat-card-subtext text-warning fw-semibold mt-1 d-block" title="Total money committed to active open paper positions.">Used Margin: ₹0.00</small>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Combined live profit or loss across all active open paper positions.">
                <span class="stat-card-title">Unrealized P&L</span>
                <h4 id="statUnrealizedPnl" class="fw-bold text-light mb-0 mt-1">₹0.00</h4>
                <small class="stat-card-subtext">Live Open Positions</small>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-6">
            <div class="card paper-card p-3" title="Net booked profit or loss from all closed trades in history.">
                <span class="stat-card-title">Realized P&L</span>
                <h4 id="statRealizedPnl" class="fw-bold text-light mb-0 mt-1">₹0.00</h4>
                <small class="stat-card-subtext">Closed Trades Ledger</small>
            </div>
        </div>
    </div>

    <!-- Main Content Area: Order Ticket + Positions & Orders -->
    <div class="row g-4">
        <!-- Order Placement Ticket (Left Column) -->
        <div class="col-xl-4 col-lg-5 col-12">
            <div class="card paper-card p-4">
                <h5 class="fw-bold text-light mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 border-bottom border-secondary border-opacity-25 pb-2">
                    <span>🎯 Order Ticket</span>
                    <span id="liveLtpBadge" class="badge bg-secondary bg-opacity-25 text-info font-monospace" title="Current Live Last Traded Price from market feeds">LTP: --</span>
                </h5>

                <form id="paperOrderForm" novalidate>
                    <!-- Symbol Selection -->
                    <div class="mb-3">
                        <label class="paper-label" for="orderSymbol" title="Select the stock or index symbol you want to trade.">Stock / Index Symbol</label>
                        <select id="orderSymbol" class="form-select paper-input" title="Select stock symbol">
                            <option value="" disabled selected>Loading Active Stocks...</option>
                        </select>
                    </div>

                    <!-- Side Tabs (BUY / SELL) -->
                    <div class="btn-group w-100 mb-3" role="group">
                        <input type="radio" class="btn-check" name="orderSide" id="sideBuy" value="BUY" checked>
                        <label class="btn btn-outline-success fw-bold py-2" for="sideBuy" title="BUY (LONG): Take position expecting stock price to go up.">BUY (LONG)</label>

                        <input type="radio" class="btn-check" name="orderSide" id="sideSell" value="SELL">
                        <label class="btn btn-outline-danger fw-bold py-2" for="sideSell" title="SELL (SHORT): Take position expecting stock price to go down.">SELL (SHORT)</label>
                    </div>

                    <!-- Order Type (Market / Limit) -->
                    <div class="mb-3">
                        <label class="paper-label" for="orderType" title="Market fills instantly at live price; Limit triggers only at your target price.">Order Type</label>
                        <select id="orderType" class="form-select paper-input" title="Order execution type">
                            <option value="Market">Market (Instant Fill)</option>
                            <option value="Limit">Limit Order</option>
                        </select>
                    </div>

                    <!-- Limit Price (Hidden by default for Market) -->
                    <div class="mb-3 d-none" id="limitPriceGroup">
                        <label class="paper-label" for="orderLimitPrice" title="Target entry price for Limit order execution.">Limit Price (₹)</label>
                        <input type="number" step="0.05" id="orderLimitPrice" class="form-control paper-input" placeholder="Target entry price" title="Target entry price for Limit order execution.">
                        <div id="limitPriceError" class="invalid-feedback text-danger small mt-1"></div>
                    </div>

                    <!-- Quantity -->
                    <div class="mb-3">
                        <label class="paper-label" for="orderQuantity" title="Number of shares or lot quantity to order.">Quantity (Lots / Shares)</label>
                        <input type="number" id="orderQuantity" class="form-control paper-input" value="25" min="1" title="Number of shares or lot quantity to order.">
                        <div id="quantityError" class="invalid-feedback text-danger small mt-1"></div>
                    </div>

                    <!-- Stop Loss & Take Profit (Optional Brackets) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="paper-label" for="orderStopLoss" title="Optional price level to automatically exit and limit losses.">Stop-Loss (₹)</label>
                            <input type="number" step="0.05" id="orderStopLoss" class="form-control paper-input" placeholder="SL Price" title="Optional price level to automatically exit and limit losses.">
                            <div id="stopLossError" class="invalid-feedback text-danger small mt-1"></div>
                        </div>
                        <div class="col-6">
                            <label class="paper-label" for="orderTakeProfit" title="Optional target price level to automatically exit with profit.">Target TP (₹)</label>
                            <input type="number" step="0.05" id="orderTakeProfit" class="form-control paper-input" placeholder="Target Price" title="Optional target price level to automatically exit with profit.">
                            <div id="takeProfitError" class="invalid-feedback text-danger small mt-1"></div>
                        </div>
                    </div>

                    <!-- Margin Estimate -->
                    <div class="d-flex justify-content-between align-items-center bg-dark bg-opacity-75 p-3 rounded-3 mb-3 border border-secondary border-opacity-25">
                        <span class="paper-label mb-0">Required Margin:</span>
                        <span id="estimatedMargin" class="fw-bold text-light fs-6">₹0.00</span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="placeOrderBtn" class="btn btn-success w-100 fw-bold py-2 rounded-3 shadow">
                        Place Paper Order
                    </button>
                </form>
            </div>
        </div>

        <!-- Live Positions & Order Book (Right Column) -->
        <div class="col-xl-8 col-lg-7 col-12">
            <!-- Open Positions Section -->
            <div class="card paper-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-light mb-0">💼 Live Open Positions</h5>
                    <span id="positionsCountBadge" class="badge bg-primary rounded-pill px-3 py-2">0 Active</span>
                </div>

                <div class="paper-table-responsive">
                    <table class="table table-dark table-hover align-middle text-nowrap mb-0 paper-table" id="positionsTable">
                        <thead class="table-borderless">
                            <tr>
                                <th>SYMBOL</th>
                                <th>SIDE</th>
                                <th>QTY</th>
                                <th>AVG ENTRY</th>
                                <th>LTP</th>
                                <th>SL / TP</th>
                                <th>UNREALIZED P&L</th>
                                <th class="text-end">ACTION</th>
                            </tr>
                        </thead>
                        <tbody id="positionsTableBody">
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No open positions. Place an order from the ticket to start paper trading.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Orders & Trade History Tabs -->
            <div class="card paper-card p-4">
                <ul class="nav nav-tabs paper-tabs mb-3" id="paperTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#ordersTabPane" type="button" role="tab">
                            Active / Pending Orders
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#historyTabPane" type="button" role="tab">
                            Execution History
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="paperTabsContent">
                    <!-- Pending Orders Tab -->
                    <div class="tab-pane fade show active" id="ordersTabPane" role="tabpanel">
                        <div class="paper-table-responsive">
                            <table class="table table-dark table-hover align-middle text-nowrap mb-0 paper-table">
                                <thead>
                                    <tr>
                                        <th>TIME</th>
                                        <th>SYMBOL</th>
                                        <th>TYPE</th>
                                        <th>SIDE</th>
                                        <th>QTY</th>
                                        <th>PRICE</th>
                                        <th>STATUS</th>
                                        <th class="text-end">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody id="ordersTableBody">
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-3">No active or pending orders.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- History Tab -->
                    <div class="tab-pane fade" id="historyTabPane" role="tabpanel">
                        <!-- History Filter Toolbar -->
                        <div class="p-3 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25">
                            <div class="row g-2 align-items-end">
                                <div class="col-xl-3 col-lg-3 col-md-6 col-12">
                                    <label class="paper-label text-light mb-1" for="historyFilterSymbol" title="Filter history by stock symbol">Stock Symbol ℹ️</label>
                                    <select id="historyFilterSymbol" class="form-select paper-input form-select-sm" title="Select stock symbol">
                                        <option value="">All Symbols</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-12">
                                    <label class="paper-label text-light mb-1" for="historyFilterSide" title="Filter by BUY or SELL side">Trade Side ℹ️</label>
                                    <select id="historyFilterSide" class="form-select paper-input form-select-sm" title="Select order side">
                                        <option value="">All Sides</option>
                                        <option value="BUY">BUY</option>
                                        <option value="SELL">SELL</option>
                                    </select>
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                                    <label class="paper-label text-light mb-1" for="historyFilterFromDate" title="Start date filter">From Date ℹ️</label>
                                    <input type="date" id="historyFilterFromDate" class="form-control paper-input form-control-sm" title="From date">
                                </div>
                                <div class="col-xl-2 col-lg-2 col-md-6 col-6">
                                    <label class="paper-label text-light mb-1" for="historyFilterToDate" title="End date filter">To Date ℹ️</label>
                                    <input type="date" id="historyFilterToDate" class="form-control paper-input form-control-sm" title="To date">
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-12 col-12 d-flex gap-2 justify-content-end">
                                    <button type="button" id="btnFilterHistory" class="btn btn-primary btn-sm px-3 fw-bold flex-grow-1" title="Apply selected filters">🔍 Filter</button>
                                    <button type="button" id="btnResetHistoryFilter" class="btn btn-outline-secondary btn-sm px-3 fw-bold" title="Reset all filters">↺ Reset</button>
                                </div>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="paper-table-responsive">
                            <table class="table table-dark table-hover align-middle text-nowrap mb-0 paper-table">
                                <thead>
                                    <tr>
                                        <th>TIME</th>
                                        <th>SYMBOL</th>
                                        <th>SIDE</th>
                                        <th>QTY</th>
                                        <th>ENTRY PRICE</th>
                                        <th>EXECUTED PRICE</th>
                                        <th>REALIZED P&L</th>
                                        <th>REMARKS</th>
                                    </tr>
                                </thead>
                                <tbody id="historyTableBody">
                                    <tr>
                                        <td colspan="8" class="text-center text-white py-3">No execution history logged.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Controls Footer -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 bg-dark bg-opacity-75 border-top border-secondary border-opacity-25">
                            <span id="historyPaginationInfo" class="text-white small fw-medium">Showing 0 of 0 trades</span>
                            <nav aria-label="Trade history pagination">
                                <ul id="historyPaginationUl" class="pagination pagination-sm mb-0">
                                    <!-- Dynamic page links rendered by JS -->
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Glassmorphism Floating Toast Container for Error / Success alerts -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;" id="toastContainer"></div>

<!-- Auto-Trade Configuration Modal -->
<div class="modal fade" id="autoTradeSettingsModal" tabindex="-1" aria-labelledby="autoTradeSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content paper-card border border-primary border-opacity-25 text-light shadow-lg" style="background-color: #121824;">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="autoTradeSettingsModalLabel">
                    <span class="badge bg-primary p-2 rounded-3">⚡</span>
                    Auto-Trade Strategy & Risk Configuration
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="autoTradeSettingsForm">
                    <div class="row g-3">
                        <!-- Trading Execution Mode (Paper vs Live) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-info">🎯 Trading Execution Mode</label>
                            <select id="cfgTradingMode" class="form-select paper-input border-info">
                                <option value="Paper">🧪 Paper Trading (Virtual Capital Sandbox)</option>
                                <option value="Live">🚀 Live Real-Money Trading (Zerodha Kite API)</option>
                            </select>
                            <small class="text-muted d-block mt-1">Paper uses virtual capital. Live routes orders to Zerodha API.</small>
                        </div>

                        <!-- Target TimeFrame -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-light">⏱️ Target TimeFrame</label>
                            <select id="cfgAutoTradeTimeframe" class="form-select paper-input">
                                <option value="1m">1 MIN (Intraday Scalping - Default)</option>
                                <option value="5m">5 MIN (Intraday Momentum)</option>
                                <option value="15m">15 MIN (Intraday Trend)</option>
                                <option value="60m">60 MIN (Hourly Trend)</option>
                                <option value="1d">1 DAY (Daily Swing)</option>
                            </select>
                            <small class="text-muted d-block mt-1">Evaluates signals on closed candles for this timeframe.</small>
                        </div>

                        <!-- Minimum Signal Strength Threshold -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-light">💪 Min Signal Confidence (%)</label>
                            <select id="cfgMinSignalStrength" class="form-select paper-input">
                                <option value="60">60% (Moderate Confidence)</option>
                                <option value="70" selected>70% (Strong Signal - Recommended)</option>
                                <option value="80">80% (Very Strong Signal)</option>
                                <option value="90">90% (Ultra High Probability)</option>
                            </select>
                        </div>

                        <!-- Quantity per Trade -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-light">📦 Trade Lot Size / Quantity</label>
                            <input type="number" id="cfgAutoTradeQuantity" class="form-control paper-input" min="1" max="10000" value="25">
                            <small class="text-muted d-block mt-1">Number of shares/lots per automated order.</small>
                        </div>

                        <!-- Stop Loss % -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-danger">🛡️ Automated Stop-Loss (%)</label>
                            <div class="input-group">
                                <input type="number" id="cfgStopLossPercent" class="form-control paper-input" step="0.1" min="0.1" max="10" value="1.0">
                                <span class="input-group-text bg-secondary bg-opacity-25 text-light border-secondary">%</span>
                            </div>
                        </div>

                        <!-- Take Profit % -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-success">🎯 Automated Take-Profit (%)</label>
                            <div class="input-group">
                                <input type="number" id="cfgTakeProfitPercent" class="form-control paper-input" step="0.1" min="0.1" max="20" value="2.0">
                                <span class="input-group-text bg-secondary bg-opacity-25 text-light border-secondary">%</span>
                            </div>
                        </div>

                        <!-- Max Concurrent Open Positions -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-light">📊 Max Concurrent Open Positions</label>
                            <input type="number" id="cfgMaxOpenPositions" class="form-control paper-input" min="1" max="20" value="5">
                        </div>

                        <!-- Daily Max Loss Emergency Limit -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-warning">⚠️ Daily Max Loss Kill-Limit (₹)</label>
                            <input type="number" id="cfgDailyMaxLossLimit" class="form-control paper-input" step="100" min="500" value="2000">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveAutoTradeSettings" class="btn btn-primary rounded-3 px-4 fw-bold shadow">
                    💾 Save Strategy Settings
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.API_BASE_URL = "@ViewBag.ApiBaseUrl";
    </script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/paperTrading.js" asp-append-version="true"></script>
}
