@model QuantEdge.Infrastructure.DTOs.ChangePasswordDto
@{
    ViewData["Title"] = "Change Password";
    ViewData["PageTitle"] = "Security Settings";
}

<style>
    .change-pwd-wrapper {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 1.5rem 0.5rem;
    }

    /* Ambient Background Glow */
    .change-pwd-wrapper::before {
        content: '';
        position: absolute;
        top: 5%;
        left: 30%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(167, 139, 250, 0.18) 0%, rgba(124, 58, 237, 0) 70%);
        filter: blur(80px);
        z-index: 0;
        pointer-events: none;
    }

    .change-pwd-card {
        background: rgba(18, 24, 38, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(167, 139, 250, 0.25);
        border-radius: 18px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(167, 139, 250, 0.12);
        width: 100%;
        max-width: 520px;
        position: relative;
        z-index: 1;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .change-pwd-header {
        padding: 1.75rem 2rem 1.25rem 2rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.12);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header-icon-box {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(167, 139, 250, 0.2), rgba(124, 58, 237, 0.35));
        border: 1px solid rgba(167, 139, 250, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a78bfa;
        box-shadow: 0 6px 14px rgba(124, 58, 237, 0.2);
    }

    .change-pwd-body {
        padding: 2rem;
    }

    .input-icon-group {
        position: relative;
    }

    .input-icon-left {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        z-index: 5;
        transition: color 0.2s ease;
    }

    .input-custom-field {
        background-color: rgba(30, 41, 59, 0.65) !important;
        border: 1px solid rgba(148, 163, 184, 0.22) !important;
        border-radius: 12px !important;
        color: #ffffff !important;
        padding: 0.75rem 2.8rem 0.75rem 2.75rem !important;
        font-size: 0.95rem;
        transition: all 0.25s ease;
        width: 100%;
    }

    .input-custom-field:focus {
        outline: none !important;
        background-color: rgba(30, 41, 59, 0.95) !important;
        border-color: #a78bfa !important;
        box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.2) !important;
    }

    .input-custom-field:focus + .input-icon-left,
    .input-icon-group:focus-within .input-icon-left {
        color: #a78bfa;
    }

    .pwd-toggle-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px;
        z-index: 5;
        transition: color 0.2s ease;
    }

    .pwd-toggle-btn:hover {
        color: #a78bfa;
    }

    .btn-gradient-primary {
        background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
        border: none;
        color: #ffffff;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.35);
        transition: all 0.25s ease;
    }

    .btn-gradient-primary:hover {
        background: linear-gradient(135deg, #6d28d9 0%, #9061f9 100%);
        box-shadow: 0 6px 20px rgba(124, 58, 237, 0.5);
        transform: translateY(-1px);
        color: #ffffff;
    }

    .btn-outline-cancel {
        border: 1px solid rgba(148, 163, 184, 0.3);
        color: #cbd5e1;
        background: rgba(30, 41, 59, 0.4);
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-outline-cancel:hover {
        background: rgba(51, 65, 85, 0.7);
        color: #ffffff;
        border-color: rgba(148, 163, 184, 0.5);
    }

    /* Strength Meter */
    .strength-meter-bar {
        height: 4px;
        border-radius: 2px;
        background-color: rgba(148, 163, 184, 0.2);
        margin-top: 6px;
        overflow: hidden;
    }

    .strength-meter-fill {
        height: 100%;
        width: 0%;
        transition: width 0.3s ease, background-color 0.3s ease;
    }

    /* Parsley Errors */
    .parsley-errors-list {
        list-style-type: none;
        padding-left: 0;
        margin-top: 0.35rem;
        margin-bottom: 0;
        color: #f87171;
        font-size: 0.8rem;
        font-weight: 500;
    }
    input.parsley-error {
        border-color: #f87171 !important;
        box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.2) !important;
    }
    input.parsley-success {
        border-color: #34d399 !important;
    }

    @@media (max-width: 576px) {
        .change-pwd-card {
            border-radius: 14px;
        }
        .change-pwd-header {
            padding: 1.25rem;
        }
        .change-pwd-body {
            padding: 1.25rem;
        }
        .btn-group-responsive {
            flex-direction: column-reverse;
            width: 100%;
        }
        .btn-group-responsive button,
        .btn-group-responsive a {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="change-pwd-wrapper">
    <div class="change-pwd-card">
        <div class="change-pwd-header">
            <div class="d-flex align-items-center gap-3">
                <div class="header-icon-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <div>
                    <h5 class="mb-0 text-white fw-bold" style="letter-spacing: -0.3px;">Change Password</h5>
                    <p class="text-secondary small mb-0">Update & secure your QuantEdge account credentials</p>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn-close-custom text-secondary" style="text-decoration: none;" title="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </a>
        </div>

        <div class="change-pwd-body">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-4 text-white" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35) !important;" role="alert">
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div class="small d-flex align-items-center gap-2">
                            <span>⚠️</span> @error.ErrorMessage
                        </div>
                    }
                </div>
            }

            <form asp-controller="Account" asp-action="ChangePassword" method="post" id="changePasswordForm" data-parsley-validate>
                @Html.AntiForgeryToken()

                <!-- Current Password -->
                <div class="mb-3.5">
                    <label asp-for="CurrentPassword" class="form-label text-light small fw-semibold mb-1">Current Password</label>
                    <div class="input-icon-group">
                        <span class="input-icon-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <input asp-for="CurrentPassword" 
                               type="password"
                               id="CurrentPasswordInput"
                               class="form-control input-custom-field" 
                               placeholder="Enter your current password" 
                               required 
                               data-parsley-required-message="Please enter your Current Password."
                               autofocus />
                        <button type="button" class="pwd-toggle-btn" onclick="togglePwdVisibility('CurrentPasswordInput', this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <!-- New Password -->
                <div class="mb-3.5 mt-3">
                    <label asp-for="NewPassword" class="form-label text-light small fw-semibold mb-1">New Password</label>
                    <div class="input-icon-group">
                        <span class="input-icon-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                            </svg>
                        </span>
                        <input asp-for="NewPassword" 
                               type="password" 
                               id="NewPasswordInput"
                               class="form-control input-custom-field" 
                               placeholder="Min. 6 characters" 
                               required 
                               data-parsley-required-message="Please enter a New Password."
                               data-parsley-minlength="6"
                               data-parsley-minlength-message="New Password must be at least 6 characters." 
                               oninput="checkPasswordStrength(this.value)" />
                        <button type="button" class="pwd-toggle-btn" onclick="togglePwdVisibility('NewPasswordInput', this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div class="strength-meter-bar">
                        <div class="strength-meter-fill" id="strengthFill"></div>
                    </div>
                    <span id="strengthText" class="small text-muted" style="font-size: 0.75rem;"></span>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <!-- Confirm New Password -->
                <div class="mb-4 mt-3">
                    <label asp-for="ConfirmNewPassword" class="form-label text-light small fw-semibold mb-1">Confirm New Password</label>
                    <div class="input-icon-group">
                        <span class="input-icon-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </span>
                        <input asp-for="ConfirmNewPassword" 
                               type="password" 
                               id="ConfirmNewPasswordInput"
                               class="form-control input-custom-field" 
                               placeholder="Repeat new password" 
                               required 
                               data-parsley-required-message="Please confirm your New Password."
                               data-parsley-equalto="#NewPasswordInput"
                               data-parsley-equalto-message="New Password and Confirm New Password do not match." />
                        <button type="button" class="pwd-toggle-btn" onclick="togglePwdVisibility('ConfirmNewPasswordInput', this)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2 justify-content-end btn-group-responsive pt-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-cancel">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-gradient-primary">
                        Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/parsley.js/2.9.2/parsley.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#changePasswordForm').parsley({
                errorClass: 'parsley-error',
                successClass: 'parsley-success',
                errorsWrapper: '<ul class="parsley-errors-list"></ul>',
                errorTemplate: '<li></li>'
            });
        });

        function togglePwdVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = `
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>`;
            } else {
                input.type = 'password';
                btn.innerHTML = `
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>`;
            }
        }

        function checkPasswordStrength(val) {
            const fill = document.getElementById('strengthFill');
            const text = document.getElementById('strengthText');
            if (!fill || !text) return;

            if (!val || val.length === 0) {
                fill.style.width = '0%';
                text.innerText = '';
                return;
            }

            let score = 0;
            if (val.length >= 6) score += 25;
            if (val.length >= 10) score += 25;
            if (/[A-Z]/.test(val)) score += 25;
            if (/[0-9!@@#$%^&*]/.test(val)) score += 25;

            fill.style.width = score + '%';
            if (score <= 25) {
                fill.style.backgroundColor = '#f87171';
                text.innerText = 'Weak Password';
                text.style.color = '#f87171';
            } else if (score <= 50) {
                fill.style.backgroundColor = '#fbbf24';
                text.innerText = 'Fair Password';
                text.style.color = '#fbbf24';
            } else if (score <= 75) {
                fill.style.backgroundColor = '#60a5fa';
                text.innerText = 'Good Password';
                text.style.color = '#60a5fa';
            } else {
                fill.style.backgroundColor = '#34d399';
                text.innerText = 'Strong Password';
                text.style.color = '#34d399';
            }
        }
    </script>
}
